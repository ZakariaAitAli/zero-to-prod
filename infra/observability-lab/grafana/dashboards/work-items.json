    {
      "type": "timeseries",
      "title": "Error-budget burn rate (1 h)",
      "description": "1 = spending the budget exactly over 28 days. 14.4 for an hour pages; 6 for six hours opens a ticket.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "work_items:availability_bad:ratio_rate1h / 0.005",
          "legendFormat": "availability"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "work_items:latency_bad:ratio_rate1h / 0.01",
          "legendFormat": "latency"
