    {
      "type": "timeseries",
      "title": "Latency (business routes)",
      "description": "Quantiles are estimated from histogram buckets; 0.25 s is a bucket boundary.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(work_items_http_request_duration_seconds_bucket{route!~\"/health|/ready|/version|unmatched\"}[1m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(work_items_http_request_duration_seconds_bucket{route!~\"/health|/ready|/version|unmatched\"}[1m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(work_items_http_request_duration_seconds_bucket{route!~\"/health|/ready|/version|unmatched\"}[1m])))",
          "legendFormat": "p99"
        }
