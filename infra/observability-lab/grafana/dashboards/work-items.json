    },
    {
      "type": "timeseries",
      "title": "5xx ratio by route",
      "description": "503 persistence_unavailable means PostgreSQL could not be used within 3 s.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (route) (rate(work_items_http_requests_total{route!~\"/health|/ready|/version|unmatched\",code=~\"5..\"}[1m])) / sum by (route) (rate(work_items_http_requests_total{route!~\"/health|/ready|/version|unmatched\"}[1m]))",
          "legendFormat": "{{route}}"
        }
      ],
      "options": {
