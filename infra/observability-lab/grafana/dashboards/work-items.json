    {
      "type": "timeseries",
      "title": "Requests by route and status",
      "description": "Business routes only; health, readiness, version and unmatched paths are excluded.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (route, code) (rate(work_items_http_requests_total{route!~\"/health|/ready|/version|unmatched\"}[1m]))",
          "legendFormat": "{{route}} {{code}}"
        }
      ],
      "options": {
