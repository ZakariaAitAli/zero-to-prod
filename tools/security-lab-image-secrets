#!/usr/bin/env python3
"""Scan known lab values in tracked files, image metadata/history, and all layers.

Reads archives as streams without extracting paths or executing image code.
An unsupported compressed layer or failed export is an incomplete audit, never
reported as a clean image. Only counts and image identities are recorded.
"""
import base64
import gzip
import io
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tarfile

ROOT=Path(__file__).resolve().parent.parent
PROJECT=os.environ.get('ZTP_SECURITY_LAB_PROJECT')
if not PROJECT:
    raise SystemExit('error: select the security lab explicitly with ZTP_SECURITY_LAB_PROJECT')
STATE=Path(subprocess.check_output([str(ROOT/'tools/security-lab-local'),'state-dir'],text=True).strip())
if (STATE/'.zero-to-prod-security-lab').read_text().strip()!=f'project={PROJECT}' or STATE.stat().st_uid!=os.getuid():
    raise SystemExit('error: refusing unowned or unmarked state')
NAMES=('postgres-admin-password postgres-migrator-password postgres-app-password postgres-worker-password '
       'rabbitmq-publisher-password rabbitmq-worker-password keycloak-db-password gateway-client-secret '
       'automation-client-secret lab-user-password lab-viewer-password lab-outsider-password '
       'lab-admin-client-secret valkey-password oauth2-proxy-cookie-secret').split()
patterns=set()
for name in NAMES:
    value=(STATE/'secrets'/name).read_bytes().strip()
    if not value:raise SystemExit('error: an expected source secret is empty')
    patterns.update((value,base64.b64encode(value)))
keys=0
for directory in ('pki','ingress-tls','internal-tls','idp-tls','app-tls'):
    for path in (STATE/directory).rglob('*'):
        if path.is_file():
            for key in re.findall(rb'-----BEGIN [A-Z ]*PRIVATE KEY-----.*?-----END [A-Z ]*PRIVATE KEY-----',path.read_bytes(),re.S):
                keys+=1
                patterns.update((key,base64.b64encode(key)))
patterns=sorted(patterns)
keep=max(map(len,patterns))-1

def scan(stream):
    found=set();tail=b''
    while True:
        block=stream.read(1024*1024)
        if not block:break
        data=tail+block
        found.update(i for i,p in enumerate(patterns) if p in data)
        tail=data[-keep:]
    return found

assert len(scan(io.BytesIO(b'\n'.join(patterns))))==len(patterns),'scanner positive control failed'

class Prefix(io.RawIOBase):
    def __init__(self,prefix,stream):self.prefix=prefix;self.stream=stream
    def readable(self):return True
    def readinto(self,target):
        if self.prefix:
            n=min(len(target),len(self.prefix));target[:n]=self.prefix[:n];self.prefix=self.prefix[n:];return n
        return self.stream.readinto(target)

ids=subprocess.check_output(['docker','ps','-aq','--filter',f'label=com.docker.compose.project={PROJECT}'],text=True).split()
if not ids:raise SystemExit('error: no containers for selected project; no image audit performed')
images=set()
for container in ids:
    images.add(subprocess.check_output(['docker','inspect','--format','{{.Image}}',container],text=True).strip())
images.add(subprocess.check_output(['docker','image','inspect','--format','{{.Id}}','zero-to-prod-migrate:v4.20.1'],text=True).strip())
results=[]
for image in sorted(images):
    metadata=subprocess.check_output(['docker','image','inspect',image])
    history=subprocess.check_output(['docker','history','--no-trunc','--format','{{json .}}',image])
    hits=scan(io.BytesIO(metadata+history));entries=0
    process=subprocess.Popen(['docker','image','save',image],stdout=subprocess.PIPE,stderr=subprocess.PIPE)
    try:
        with tarfile.open(fileobj=process.stdout,mode='r|') as archive:
            for member in archive:
                if not member.isfile():continue
                entries+=1
                raw=archive.extractfile(member);prefix=raw.read(4)
                stream=io.BufferedReader(Prefix(prefix,raw))
                if prefix[:2]==b'\x1f\x8b':
                    with gzip.GzipFile(fileobj=stream) as layer:hits.update(scan(layer))
                elif prefix==b'\x28\xb5\x2f\xfd':
                    raise RuntimeError('zstd-compressed layer unsupported; image audit incomplete')
                else:hits.update(scan(stream))
        process.stdout.close();errors=process.stderr.read();rc=process.wait()
        if rc:raise RuntimeError('image export failed; audit incomplete')
    except BaseException:
        process.kill();process.wait();raise
    results.append({'image':image,'archive_files_scanned':entries,'known_value_matches':len(hits)})
    if hits:raise SystemExit('error: known lab value found in image; details withheld')
tracked=subprocess.check_output(['git','-C',str(ROOT),'ls-files','--cached','--others','--exclude-standard','-z']).decode().split('\0')
for name in filter(None,tracked):
    path=ROOT/name
    if path.is_file():
        with path.open('rb') as stream:
            if scan(stream):raise SystemExit('error: known lab value found in tracked file; details withheld')
history_process=subprocess.Popen(['git','-C',str(ROOT),'cat-file','--batch-all-objects','--batch'],stdout=subprocess.PIPE,stderr=subprocess.DEVNULL)
object_hits=scan(history_process.stdout)
history_process.stdout.close()
if history_process.wait():raise SystemExit('error: Git object audit incomplete')
if object_hits:raise SystemExit('error: known lab value found in Git objects; details withheld')
report={'git_objects_audited':True,'project':PROJECT,'scope':'known configured source values and private-key PEM blocks, raw and base64; tracked and nonignored new files, Git objects, complete saved image layers, metadata and history',
        'source_secret_count':len(NAMES),'private_key_blocks_read':keys,'distinct_patterns':len(patterns),'scanner_positive_control':True,'images':results,'passed':True}
output=os.environ.get('ZTP_IMAGE_AUDIT_EVIDENCE')
if output:
    p=Path(output);p.parent.mkdir(parents=True,exist_ok=True);p.write_text(json.dumps(report,indent=2)+'\n')
print(json.dumps(report,indent=2))
