#!/usr/bin/env python3
"""Report vulnerability findings for the digest-pinned third-party images the labs run.

Informational only: it never fails because of findings, so it cannot be mistaken for a
release gate (tools/delivery-image-gate gates the images this project ships). A pinned Trivy
container fetches each image by digest from its registry (linux/amd64; no Docker socket is
mounted into the scanner, no local image store is involved) and the tool writes per-image JSON
plus summary.md / summary.json.

Usage: tools/third-party-image-report OUTPUT_DIR [COMPOSE_FILE ...]
       tools/third-party-image-report --self-test
Exit status: 0 report written; 1 bad usage, no images, or the output directory exists;
2 a pull or scan failed (partial report still written).
"""
import json
import re
import subprocess
import sys
import tempfile
from pathlib import Path

SCANNER = "aquasec/trivy@sha256:2416d1f74045b57274df1a340eee6b510cacd73c66a6ccb8da092b117eb7d222"
CACHE_VOLUME = "zero-to-prod-trivy-cache"
PLATFORM = "linux/amd64"
IMAGE_LINE =re.compile(r"^\s+image:\s+([^\s$]+@sha256:[0-9a-f]{64})\s*$")


def images_from(compose_files):
    found = set()
    for path in compose_files:
        for line in Path(path).read_text().splitlines():
            match = IMAGE_LINE.match(line)
            if match:
                found.add(match.group(1))
    return sorted(found)


def summarize(report):
    """Count HIGH/CRITICAL findings, how many have a fixed version, and the affected packages."""
    counts = {"HIGH": 0, "CRITICAL": 0}
    fixed = 0
    packages = set()
    for result in report.get("Results") or []:
        for vuln in result.get("Vulnerabilities") or []:
            severity = vuln.get("Severity")
            if severity not in counts:
                continue
            counts[severity] += 1
            packages.add(vuln.get("PkgName", "?"))
            if vuln.get("FixedVersion"):
                fixed += 1
    return {"critical": counts["CRITICAL"], "high": counts["HIGH"], "fixed": fixed, "packages": sorted(packages)}


def render_markdown(rows):
    lines = [
        "# Third-party image findings (informational)",
        "",
        "Trivy, HIGH and CRITICAL only; reachability is not analysed. 'Fixable' counts findings that list a fixed version.",
        "",
        "| Image | CRITICAL | HIGH | Fixable | Packages (first 6) |",
        "| --- | ---: | ---: | ---: | --- |",
    ]
    for row in rows:
        s = row["summary"]
        if s is None:
            lines.append(f"| `{row['image']}` | scan failed | | | {row['error']} |")
            continue
        packages = ", ".join(s["packages"][:6]) + (" …" if len(s["packages"]) > 6 else "")
        lines.append(f"| `{row['image']}` | {s['critical']} | {s['high']} | {s['fixed']} | {packages} |")
    return "\n".join(lines) + "\n"


def run(cmd, **kwargs):
    return subprocess.run(cmd, text=True, capture_output=True, **kwargs)


def failure(label, result):
    """Name the failed step and keep the last stderr line, so a failure can be diagnosed from the report."""
    lines = [line.strip() for line in (result.stderr or "").splitlines() if line.strip()]
    detail = re.sub(r"[|\s]+", " ", lines[-1])[:200] if lines else "no error output"
    print("\n".join(lines[-15:]), file=sys.stderr)
    return None, f"{label}: {detail}"


def report_name(image):
    return re.sub(r"[^A-Za-z0-9._-]+", "_", image)


def scanner_command(image, output):
    """Trivy fetches the digest-pinned image from the registry itself (no Docker socket, no local store).

    A `docker save` archive of a multi-platform image was not reliable: on a GitHub-hosted runner it
    referenced the image config blob without containing it and Trivy could not open it."""
    return [
        "docker", "run", "--rm", "--memory", "2g",
        "-v", f"{output}:/output", "-v", f"{CACHE_VOLUME}:/cache",
        SCANNER, "image", "--cache-dir", "/cache", "--image-src", "remote", "--platform", PLATFORM,
        "--scanners", "vuln", "--severity", "HIGH,CRITICAL", "--format", "json",
        "--output", f"/output/{report_name(image)}.json", "--exit-code", "0", image,
    ]


def scan(image, output):
    name = report_name(image)
    scanned = run(scanner_command(image, output))
    report = output / f"{name}.json"
    if scanned.returncode or not report.exists():
        return failure("scan failed", scanned)
    return summarize(json.loads(report.read_text())), ""


def self_test():
    sample = {
        "Results": [
            {"Vulnerabilities": [
                {"Severity": "HIGH", "PkgName": "zlib", "FixedVersion": "1.3.2-r1"},
                {"Severity": "CRITICAL", "PkgName": "musl"},
                {"Severity": "MEDIUM", "PkgName": "ignored", "FixedVersion": "1"},
            ]},
            {"Vulnerabilities": None},
        ]
    }
    assert summarize(sample) == {"critical": 1, "high": 1, "fixed": 1, "packages": ["musl", "zlib"]}
    assert summarize({}) == {"critical": 0, "high": 0, "fixed": 0, "packages": []}
    text = (
        "services:\n  a:\n    image: nginx:1.30.5-alpine@sha256:" + "a" * 64 + "\n"
        "  b:\n    image: zero-to-prod-local:latest\n"
        "  c:\n    image: ${VAR:-x}@sha256:" + "b" * 64 + "\n"
        "  d:\n    image: postgres:18@sha256:" + "c" * 64 + "\n"
    )
    with tempfile.TemporaryDirectory() as tmp:
        path = Path(tmp) / "compose.yaml"
        path.write_text(text)
        assert images_from([path]) == ["nginx:1.30.5-alpine@sha256:" + "a" * 64, "postgres:18@sha256:" + "c" * 64]
    table = render_markdown([
        {"image": "x@sha256:1", "summary": {"critical": 0, "high": 2, "fixed": 1, "packages": list("abcdefgh")}, "error": ""},
        {"image": "y@sha256:2", "summary": None, "error": "pull failed"},
    ])
    assert "| `x@sha256:1` | 0 | 2 | 1 | a, b, c, d, e, f … |" in table and "scan failed" in table
    ref = "quay.io/x/y:v1@sha256:" + "d" * 64
    command = scanner_command(ref, Path("/out"))
    assert command[-1] == ref and "--image-src" in command and command[command.index("--image-src") + 1] == "remote"
    assert "--input" not in command and not any("docker.sock" in part for part in command)
    assert command[command.index("--output") + 1] == "/output/" + report_name(ref) + ".json"
    fake = subprocess.CompletedProcess([], 1, stdout="", stderr="noise\nFATAL a | b\n")
    assert failure("scan failed", fake) == (None, "scan failed: FATAL a b")
    assert failure("scan failed", subprocess.CompletedProcess([], 1, "", ""))[1] == "scan failed: no error output"
    print("self-test passed")


def main(argv):
    if argv == ["--self-test"]:
        self_test()
        return 0
    if not argv:
        print(__doc__, file=sys.stderr)
        return 1
    output = Path(argv[0]).resolve()
    compose = argv[1:] or sorted(str(p) for p in Path("infra").glob("**/compose*.y*ml"))
    images = images_from(compose)
    if not images:
        print("no digest-pinned images found", file=sys.stderr)
        return 1
    if output.exists():
        print(f"output directory already exists: {output}", file=sys.stderr)
        return 1
    output.mkdir(parents=True)
    rows, failed = [], False
    for image in images:
        summary, error = scan(image, output)
        failed = failed or summary is None
        rows.append({"image": image, "summary": summary, "error": error})
        print(f"scanned {image.split('@')[0]}: {summary if summary else error}", file=sys.stderr)
    (output / "summary.json").write_text(json.dumps(rows, indent=2) + "\n")
    markdown = render_markdown(rows)
    (output / "summary.md").write_text(markdown)
    print(markdown)
    return 2 if failed else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
