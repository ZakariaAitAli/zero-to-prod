def check(record, name, condition):
    record["checks"][name] = bool(condition)


def experiment_baseline(record):
    with Load() as load:
        start = time.time()
        time.sleep(150)
        job = load.last_job()
        record["client"] = load.summary(start)
    _, waited = wait_for(lambda: job_state(job) == "succeeded", 30, interval=1)
    trace_id = trace_id_of_job(job)
    time.sleep(8)
    spans = jaeger_trace(trace_id) or []
    logs = loki(f'{{service_name=~"work-items-.*"}} | trace_id="{trace_id}"')
    record["sample"] = {"job_id": job, "trace_id": trace_id, "spans": spans,
                        "logs": [{k: v for k, v in l.items() if k != "error"} for l in logs]}
    record["telemetry"] = snapshot(DASHBOARD_QUERIES)
    by_id = {s["span_id"]: s for s in spans}
    server = next((s for s in spans if s["kind"] == "server"), None)
    producer = next((s for s in spans if s["kind"] == "producer"), None)
    consumer = next((s for s in spans if s["kind"] == "consumer"), None)
    check(record, "no_client_errors", record["client"]["server_errors"] == 0 and record["client"]["connection_failures"] == 0)
    check(record, "trace_has_api_and_worker", {s["service"] for s in spans} == {"work-items-api", "work-items-worker"})
    check(record, "publish_span_child_of_request", bool(server and producer and producer["parent"] == [server["span_id"]]))
    check(record, "process_span_child_of_publish", bool(producer and consumer and consumer["parent"] == [producer["span_id"]]))
    check(record, "db_spans_under_both_services", sum(1 for s in spans if s["name"].endswith("postgresql") and by_id.get((s["parent"] or [""])[0])) >= 4)
    check(record, "logs_from_both_services_share_trace", {l["service"] for l in logs} >= {"work-items-api", "work-items-worker"})
    record["alerts_firing_at_end"] = sorted(firing_alerts())
    check(record, "no_pages_firing", not paging_alerts())


def experiment_slow_lock(record):
    status, item, _ = http("POST", API + "/items", {"title": "lock contention"})
    item_id = item["id"]
    holder = subprocess.Popen(
        ["docker", "exec", container("postgres"), "psql", "-U", "zero_to_prod_admin", "-d", "zero_to_prod",
         "-c", f"BEGIN; {ITEM_LOCK.format(item_id)}; SELECT pg_sleep(8); COMMIT;"],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    time.sleep(1.5)
    status, body, elapsed = http("POST", f"{API}/items/{item_id}/process")
    holder.wait(timeout=30)
    record["request"] = {"item_id": item_id, "status": status, "body": body, "elapsed_s": round(elapsed, 3)}
    time.sleep(8)
    logs = loki(f'{{service_name="work-items-api"}} |= "accept processing job failed" | work_item_id="{item_id}"', minutes=2)
    trace_id, spans = first_exported_trace([l["trace_id"] for l in logs if l["trace_id"]])
    spans = spans or []
    record["investigation"] = {"error_logs": [{k: v for k, v in l.items()} for l in logs[:3]],
                               "trace_id": trace_id, "spans": spans}
    slow_span = next((s for s in spans or [] if s["name"] == "SELECT postgresql" and s["duration_ms"] > 2500), None)
    check(record, "request_failed_with_503_after_timeout", status == 503 and 2.5 < elapsed < 4.5)
    check(record, "error_log_carries_trace_id", trace_id is not None)
    check(record, "trace_shows_lock_wait_span", slow_span is not None)
    check(record, "lock_span_marked_error", bool(slow_span and slow_span["error"]))
    retry_status, _, _ = http("POST", f"{API}/items/{item_id}/process")
    check(record, "retry_after_lock_release_accepted", retry_status == 202)


def experiment_postgres_outage(record):
    with Load() as load:
        time.sleep(60)
        outage = time.time()
        run("docker", "stop", container("postgres"))
        record["fault"] = {"action": "docker stop postgres", "at": now()}
        record["alerts"] = [wait_alert("WorkItemsAvailabilityFastBurn", 300),
                            wait_alert("WorkItemsBacklogUnobservable", 240)]
        record["during_outage"] = snapshot(DASHBOARD_QUERIES)
        errors = loki('{service_name="work-items-api"} | detected_level=~"warn|error"', minutes=5, limit=10)
        trace_id, spans = first_exported_trace([l["trace_id"] for l in errors if l["trace_id"] and "failed" in l["line"]])
        record["investigation"] = {
            "error_logs": [{k: v for k, v in l.items()} for l in errors[:5]],
            "failing_request_trace_id": trace_id,
            "failing_request_trace": spans,
        }
        record["client_during_outage"] = load.summary(outage)
        run("docker", "start", container("postgres"))
        recovered = time.time()
        record["recovery"] = {"postgres_healthy": wait_healthy("postgres"), "at": now()}
        time.sleep(60)
        record["client_after_recovery"] = load.summary(recovered + 10)
    record["after_recovery"] = snapshot(DASHBOARD_QUERIES)
    check(record, "availability_alert_fired", record["alerts"][0]["fired"])
    check(record, "backlog_unobservable_fired", record["alerts"][1]["fired"])
    check(record, "client_saw_503", record["client_during_outage"]["server_errors"] > 0)
    check(record, "error_logs_in_loki_with_trace", bool(record["investigation"]["failing_request_trace"]))
    check(record, "pg_up_zero_during_outage", any(r["value"] == 0 for r in record["during_outage"]["pg_up"]))
    check(record, "recovered_without_errors", record["client_after_recovery"]["server_errors"] == 0)


def experiment_api_failure(record):
    with Load() as load:
        time.sleep(30)
        outage = time.time()
        run("docker", "kill", container("api"))
        record["fault"] = {"action": "docker kill api", "at": now()}
        record["alerts"] = [wait_alert("WorkItemsAPIUnavailable", 240)]
        record["during_outage"] = snapshot({"targets_up": "up", "availability_bad_5m": "work_items:availability_bad:ratio_rate5m"})
        record["client_during_outage"] = load.summary(outage)
        run("docker", "start", container("api"))
        record["recovery"] = {"api_healthy": wait_healthy("api"), "at": now()}
        recovered = time.time()
        time.sleep(45)
        record["client_after_recovery"] = load.summary(recovered + 5)
    check(record, "api_unavailable_alert_fired", record["alerts"][0]["fired"])
    check(record, "client_saw_connection_failures", record["client_during_outage"]["connection_failures"] > 0)
    check(record, "server_side_sli_did_not_see_failures", record["client_during_outage"]["server_errors"] == 0)
    check(record, "recovered", record["client_after_recovery"]["connection_failures"] == 0 and record["client_after_recovery"]["server_errors"] == 0)


def experiment_rabbitmq_outage(record):
    with Load() as load:
        time.sleep(30)
        outage = time.time()
        run("docker", "stop", container("rabbitmq"))
        record["fault"] = {"action": "docker stop rabbitmq", "at": now()}
        record["alerts"] = [wait_alert("WorkItemsAsyncProcessingStalled", 360)]
        record["during_outage"] = snapshot(DASHBOARD_QUERIES)
        record["client_during_outage"] = load.summary(outage)
        record["publisher_logs"] = loki('{service_name="work-items-api"} |= "outbox publisher"', minutes=8)
        accepted_during_outage = load.last_job()
        run("docker", "start", container("rabbitmq"))
        restart = time.time()
        record["recovery"] = {"rabbitmq_healthy": wait_healthy("rabbitmq", 180), "at": now()}
    drained, drain_seconds = wait_for(lambda: prom_value("work_items_processing_jobs_accepted") == 0, 300)
    record["recovery"]["backlog_drained"] = drained is not None
    record["recovery"]["drain_seconds_after_restart"] = round(time.time() - restart, 1) if drained else None
    time.sleep(15)
    trace_id = trace_id_of_job(accepted_during_outage)
    spans = jaeger_trace(trace_id) or []
    record["delayed_job"] = {"job_id": accepted_during_outage, "state": job_state(accepted_during_outage),
                             "trace_id": trace_id, "spans": [s for s in spans if not s["name"].endswith("postgresql")]}
    record["after_recovery"] = snapshot(DASHBOARD_QUERIES)
    record["freshness_alert"] = {"WorkItemsFreshnessFastBurn": "WorkItemsFreshnessFastBurn" in firing_alerts()}
    check(record, "stalled_alert_fired", record["alerts"][0]["fired"])
    check(record, "api_stayed_available", record["client_during_outage"]["server_errors"] == 0)
    check(record, "outbox_backlog_visible", any(r["value"] > 0 for r in record["during_outage"]["outbox_unpublished"]))
    check(record, "publisher_degraded_logged", any("degraded" in l["line"] for l in record["publisher_logs"]))
    check(record, "backlog_drained", record["recovery"]["backlog_drained"])
    check(record, "delayed_job_trace_spans_outage",
          {s["service"] for s in spans} == {"work-items-api", "work-items-worker"})


def experiment_worker_stopped(record):
    with Load() as load:
        time.sleep(20)
        run("docker", "stop", container("worker"))
        record["fault"] = {"action": "docker stop worker", "at": now()}
