#!/usr/bin/env python3
"""Issue #122 observability experiments against tools/observability-lab-local.

Usage: tools/observability-lab-experiments OUTPUT_DIR [EXPERIMENT ...]

Runs each experiment under synthetic load, injects one failure, waits for the
alert designed to detect it, collects what an operator would use to
investigate (Prometheus series, firing alerts, Loki logs, Jaeger traces,
client-side results), restores the lab, and waits for alerts to resolve.
Writes one JSON file per experiment and summary.json to OUTPUT_DIR (which
must not exist). Standard library only; never prints or records secrets.
"""

import concurrent.futures
import json
import os
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request

PROJECT = "zero-to-prod-observability-lab"
API = "http://127.0.0.1:" + os.environ.get("ZTP_OBSERVABILITY_LAB_API_PORT", "18080")
PROMETHEUS = "http://127.0.0.1:" + os.environ.get("ZTP_OBSERVABILITY_LAB_PROMETHEUS_PORT", "19090")
JAEGER = "http://127.0.0.1:" + os.environ.get("ZTP_OBSERVABILITY_LAB_JAEGER_PORT", "16686")
LOAD_RATE = float(os.environ.get("ZTP_OBSERVABILITY_LAB_LOAD_RATE", "4"))
ITEM_LOCK = "SELECT pg_advisory_xact_lock(1464423501, hashint8({}::bigint))"


def container(service):
    return f"{PROJECT}-{service}-1"


def now():
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def run(*args, check=True, timeout=120):
    result = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
    if check and result.returncode != 0:
        raise RuntimeError(f"{args[:3]} failed: {result.stderr.strip()[:300]}")
    return result.stdout.strip()


def psql(sql):
    return run("docker", "exec", container("postgres"), "psql", "-U", "zero_to_prod_admin",
               "-d", "zero_to_prod", "-Atc", sql)


def http(method, url, body=None, timeout=10):
    data = json.dumps(body).encode() if body is not None else None
    request = urllib.request.Request(url, data=data, method=method,
                                     headers={"Content-Type": "application/json"})
    started = time.monotonic()
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            payload = response.read()
            status = response.status
    except urllib.error.HTTPError as error:
        payload, status = error.read(), error.code
    except (urllib.error.URLError, OSError, TimeoutError):
        payload, status = b"", 0
    elapsed = time.monotonic() - started
    try:
        parsed = json.loads(payload) if payload else None
    except ValueError:
        parsed = None
    return status, parsed, elapsed


def prom(query):
    url = PROMETHEUS + "/api/v1/query?" + urllib.parse.urlencode({"query": query})
    with urllib.request.urlopen(url, timeout=10) as response:
        result = json.load(response)["data"]["result"]
    return [{"metric": r["metric"], "value": float(r["value"][1])} for r in result]


def prom_value(query):
    result = prom(query)
    return result[0]["value"] if result else None


def firing_alerts():
    with urllib.request.urlopen(PROMETHEUS + "/api/v1/alerts", timeout=10) as response:
        alerts = json.load(response)["data"]["alerts"]
    return {a["labels"]["alertname"]: a for a in alerts if a["state"] == "firing"}


def loki(query, minutes=10, limit=20):
    end = time.time_ns()
    params = urllib.parse.urlencode({"query": query, "limit": limit,
                                     "start": end - minutes * 60 * 10**9, "end": end})
    output = run("docker", "exec", container("api"), "wget", "-qO-",
                 f"http://loki:3100/loki/api/v1/query_range?{params}")
    lines = []
    for stream in json.loads(output)["data"]["result"]:
        for _, line in stream["values"]:
            lines.append({"service": stream["stream"].get("service_name"),
                          "trace_id": stream["stream"].get("trace_id"),
                          "level": stream["stream"].get("detected_level"),
                          "line": line,
                          # The slog bridge exports error values as exception_*.
                          "error": stream["stream"].get("exception_message")})
    return lines


def jaeger_trace(trace_id):
    try:
        with urllib.request.urlopen(f"{JAEGER}/api/traces/{trace_id}", timeout=10) as response:
            data = json.load(response)["data"]
    except urllib.error.HTTPError:
        return None
    if not data:
        return None
    trace = data[0]
    services = {key: value["serviceName"] for key, value in trace["processes"].items()}
    spans = []
    for span in sorted(trace["spans"], key=lambda s: s["startTime"]):
        tags = {t["key"]: t["value"] for t in span.get("tags", [])}
        spans.append({
            "service": services[span["processID"]],
            "name": span["operationName"],
            "span_id": span["spanID"],
            "parent": [r["spanID"] for r in span.get("references", [])],
            "kind": tags.get("span.kind"),
            "duration_ms": span["duration"] / 1000,
            "error": tags.get("error", False) or tags.get("otel.status_code") == "ERROR",
            "status_description": tags.get("otel.status_description"),
        })
    return spans


def wait_for(predicate, timeout, interval=5):
    deadline = time.monotonic() + timeout
    started = time.monotonic()
    while time.monotonic() < deadline:
        value = predicate()
        if value:
            return value, round(time.monotonic() - started, 1)
        time.sleep(interval)
    return None, round(time.monotonic() - started, 1)


def wait_alert(name, timeout):
    alert, waited = wait_for(lambda: firing_alerts().get(name), timeout)
    return {"alert": name, "fired": alert is not None, "seconds_until_firing": waited,
            "active_at": alert and alert.get("activeAt"),
            "summary": alert and alert["annotations"].get("summary"),
            "description": alert and alert["annotations"].get("description"),
            "runbook": alert and alert["annotations"].get("runbook")}


def paging_alerts():
    return {name: alert for name, alert in firing_alerts().items() if alert["labels"].get("severity") == "page"}


def wait_quiet(timeout=480):
    # Ticket-severity slow burns use 30-minute and 6-hour windows and keep
    # firing long after recovery (run 1); the next experiment waits only for
    # pages to resolve and records the tickets still open.
    _, waited = wait_for(lambda: not paging_alerts(), timeout, interval=10)
    return {"pages_resolved": not paging_alerts(), "seconds_until_no_pages": waited,
            "still_firing": sorted(firing_alerts())}


def first_exported_trace(trace_ids):
    # Spans reach Jaeger after the SDK and collector batch delays (about 7 s);
    # the newest log lines can precede their trace.
    for _ in range(6):
        for trace_id in trace_ids:
            spans = jaeger_trace(trace_id)
            if spans:
                return trace_id, spans
        time.sleep(5)
    return None, None


def wait_healthy(service, timeout=120):
    def healthy():
        state = run("docker", "inspect", "-f", "{{.State.Status}} {{if .State.Health}}{{.State.Health.Status}}{{end}}",
                    container(service), check=False)
        return state in ("running healthy", "running ")
    return wait_for(healthy, timeout, interval=2)[0] is not None


class Load:
    """Create item, request processing, read the job, at a fixed rate."""

    def __init__(self, rate=LOAD_RATE):
        self.rate = rate
        self.results = []
        self.jobs = []
        self.lock = threading.Lock()
        self.stop_event = threading.Event()
        self.pool = concurrent.futures.ThreadPoolExecutor(max_workers=48)
        self.thread = threading.Thread(target=self._run, daemon=True)

    def __enter__(self):
        self.thread.start()
        return self

    def __exit__(self, *_):
        self.stop_event.set()
        self.thread.join()
        self.pool.shutdown(wait=True)

    def _record(self, operation, status, elapsed):
        with self.lock:
            self.results.append((time.time(), operation, status, elapsed))

    def _iteration(self, index):
        status, item, elapsed = http("POST", API + "/items", {"title": f"experiment load {index}"})
        self._record("create", status, elapsed)
        if status != 201:
            return
        status, job, elapsed = http("POST", f"{API}/items/{item['id']}/process")
        self._record("process", status, elapsed)
        if status != 202:
            return
        with self.lock:
            self.jobs.append((time.time(), job["id"]))
        status, _, elapsed = http("GET", f"{API}/processing-jobs/{job['id']}")
        self._record("get_job", status, elapsed)

    def _run(self):
        index = 0
        while not self.stop_event.is_set():
            self.pool.submit(self._iteration, index)
            index += 1
            self.stop_event.wait(1 / self.rate)

    def summary(self, since=0.0, until=None):
        until = until or time.time()
        with self.lock:
            selected = [r for r in self.results if since <= r[0] <= until]
        by_status = {}
        for _, operation, status, _ in selected:
            key = f"{operation}:{status}"
            by_status[key] = by_status.get(key, 0) + 1
        latencies = sorted(r[3] for r in selected if r[2] not in (0,))
        def quantile(q):
            return round(latencies[int(q * (len(latencies) - 1))], 4) if latencies else None
        return {"requests": len(selected), "by_operation_status": dict(sorted(by_status.items())),
                "server_errors": sum(1 for r in selected if r[2] >= 500),
                "connection_failures": sum(1 for r in selected if r[2] == 0),
                "latency_s": {"p50": quantile(0.5), "p95": quantile(0.95), "p99": quantile(0.99)}}

    def last_job(self):
        with self.lock:
            return self.jobs[-1][1] if self.jobs else None


def trace_id_of_job(job_id):
    value = psql(f"SELECT split_part(trace_context, '-', 2) FROM public.outbox_messages WHERE processing_job_id={int(job_id)}")
    return value or None


def job_state(job_id):
    status, job, _ = http("GET", f"{API}/processing-jobs/{job_id}")
    return job["state"] if status == 200 else None


def snapshot(queries):
    return {name: prom(query) for name, query in queries.items()}


