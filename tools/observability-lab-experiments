def experiment_worker_cannot_complete(record):
    psql("REVOKE INSERT ON public.work_item_results FROM zero_to_prod_worker")
    record["fault"] = {"action": "REVOKE INSERT ON work_item_results FROM zero_to_prod_worker", "at": now()}
    try:
        with Load() as load:
            first_job_wait = time.time()
            record["alerts"] = [wait_alert("WorkItemsAsyncProcessingStalled", 360)]
            record["during_fault"] = snapshot(DASHBOARD_QUERIES)
            stuck = load.jobs[0][1] if load.jobs else None
            record["stuck_job"] = {"job_id": stuck,
                                   "attempt_count": psql(f"SELECT attempt_count FROM public.processing_jobs WHERE id={int(stuck)}"),
                                   "state": job_state(stuck)}
            record["worker_logs"] = loki('{service_name="work-items-worker"} | detected_level=~"warn|error"', minutes=6, limit=6)
    finally:
        psql("GRANT INSERT ON public.work_item_results TO zero_to_prod_worker")
        record["restore"] = {"action": "GRANT INSERT ON work_item_results TO zero_to_prod_worker", "at": now()}
    drained, _ = wait_for(lambda: prom_value("work_items_processing_jobs_accepted") == 0, 300)
    record["recovery"] = {"backlog_drained": drained is not None,
                          "stuck_job_state": job_state(stuck),
                          "stuck_job_attempt_count": psql(f"SELECT attempt_count FROM public.processing_jobs WHERE id={int(stuck)}")}
    requeues = sum(r["value"] for r in record["during_fault"]["worker_deliveries_1m"]
                   if r["metric"].get("settlement") == "nack_requeue")
    check(record, "stalled_alert_fired", record["alerts"][0]["fired"])
    check(record, "requeue_loop_visible", requeues > 0)
    check(record, "session_restarts_visible", any(r["value"] > 0 for r in record["during_fault"]["worker_session_exits_1m"]))
    check(record, "error_logs_name_permission_sqlstate",
          any("42501" in f'{l["line"]} {l["error"]}' for l in record["worker_logs"]))
    check(record, "infrastructure_failures_do_not_consume_attempts", record["stuck_job"]["attempt_count"] == "0")
    check(record, "backlog_drained", record["recovery"]["backlog_drained"])


def experiment_cpu_pressure(record):
    # Run 1 used 0.02 CPU at the default rate: the API needed only about
    # 0.013 CPU, so it was never saturated. Demand must exceed the limit.
    limit = os.environ.get("ZTP_OBSERVABILITY_LAB_CPU_LIMIT", "0.01")
    rate = LOAD_RATE * 2
    run("docker", "update", "--cpus", limit, container("api"))
    record["fault"] = {"action": f"docker update --cpus {limit} api", "load_rate": rate, "at": now()}
    try:
        with Load(rate) as load:
            start = time.time()
            record["alerts"] = [wait_alert("WorkItemsLatencyFastBurn", 420)]
            record["during_fault"] = snapshot(DASHBOARD_QUERIES)
            record["client_during_fault"] = load.summary(start)
            slow = loki('{service_name="work-items-api"} | route="/items" | duration_ms > 250', minutes=8, limit=3)
            record["slow_request_logs"] = slow
            _, record["slow_request_trace"] = first_exported_trace([l["trace_id"] for l in slow if l["trace_id"]])
    finally:
        # "docker update --cpus 0" leaves the previous limit in place (run 1);
        # raising the limit to every CPU of the Docker VM removes the constraint.
        cpus = run("docker", "info", "-f", "{{.NCPU}}")
        run("docker", "update", "--cpus", cpus, container("api"))
        record["restore"] = {"action": f"docker update --cpus {cpus} api (all Docker VM CPUs)",
                             "nano_cpus_after": run("docker", "inspect", "-f", "{{.HostConfig.NanoCpus}}", container("api")),
                             "expected_nano_cpus": str(int(cpus) * 10**9),
                             "at": now()}
    check(record, "latency_alert_fired", record["alerts"][0]["fired"])
    check(record, "cpu_saturation_visible", any(r["metric"].get("job") == "work-items-api" and r["value"] >= 0.8 * float(limit)
                                                 for r in record["during_fault"]["cpu_cores_1m"]))
    check(record, "limit_removed", record["restore"]["nano_cpus_after"] == record["restore"]["expected_nano_cpus"])


EXPERIMENTS = {
    "e1-baseline-trace": experiment_baseline,
    "e2-cpu-pressure": experiment_cpu_pressure,
    "e3-slow-lock": experiment_slow_lock,
    "e4-postgres-outage": experiment_postgres_outage,
    "e5-api-failure": experiment_api_failure,
    "e6-rabbitmq-outage": experiment_rabbitmq_outage,
    "e7-worker-stopped": experiment_worker_stopped,
    "e8-worker-cannot-complete": experiment_worker_cannot_complete,
}


def main():
    if len(sys.argv) < 2:
        print(__doc__)
        return 2
    output = sys.argv[1]
    names = sys.argv[2:] or list(EXPERIMENTS)
    os.makedirs(output, exist_ok=False)
    summary = {"started": now(), "load_rate_iterations_per_s": LOAD_RATE, "experiments": {}}
    for name in names:
        print(f"{now()} {name}: start", flush=True)
        record = {"experiment": name, "started": now(), "checks": {}}
        try:
            EXPERIMENTS[name](record)
        except Exception as error:  # record and continue with restoration
            record["exception"] = f"{type(error).__name__}: {error}"
        record["quiet"] = wait_quiet()
        record["finished"] = now()
        record["passed"] = bool(record["checks"]) and all(record["checks"].values()) and "exception" not in record
        with open(os.path.join(output, f"{name}.json"), "w") as handle:
            json.dump(record, handle, indent=2, default=str)
        summary["experiments"][name] = {"passed": record["passed"], "checks": record["checks"],
                                        "exception": record.get("exception")}
        print(f"{now()} {name}: passed={record['passed']} {record['checks']} {record.get('exception', '')}", flush=True)
    summary["finished"] = now()
    with open(os.path.join(output, "summary.json"), "w") as handle:
        json.dump(summary, handle, indent=2)
    return 0 if all(e["passed"] for e in summary["experiments"].values()) else 1


if __name__ == "__main__":
    sys.exit(main())
