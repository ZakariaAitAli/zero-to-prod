#!/usr/bin/env python3
"""Measure local blue/green traffic; retains failures and always stops its lab."""
import json, subprocess, sys, threading, time, urllib.request, urllib.error
from pathlib import Path
root=Path(__file__).resolve().parents[1]
output=Path(sys.argv[1]);output.mkdir(parents=True,exist_ok=False)
helper=str(root/'tools/delivery-lab-local')
rows=[];events=[];stop=threading.Event()
def run(*args,env=None,check=True):
    p=subprocess.run([helper,*args],text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,env=env)
    with (output/'commands.log').open('a') as f:f.write(' '.join(args)+'\n'+p.stdout+'\n')
    if check and p.returncode:raise RuntimeError('command failed: '+' '.join(args))
    return p

def request(path,body=None):
    started=time.monotonic()
    try:
        req=urllib.request.Request('http://127.0.0.1:18084'+path,data=None if body is None else json.dumps(body).encode(),headers={'Content-Type':'application/json'})
        with urllib.request.urlopen(req,timeout=3) as r:code=r.status;data=json.load(r)
    except urllib.error.HTTPError as e:code=e.code;data={}
    except Exception as e:code=0;data={'error':type(e).__name__}
    rows.append({'elapsed':time.monotonic()-epoch,'path':path,'status':code,'seconds':time.monotonic()-started,'data':data})
    return code,data

def traffic():
    while not stop.is_set():
        request('/version');request('/items');stop.wait(.05)

def event(name,fn):
    start=time.monotonic()-epoch;result=fn();events.append({'name':name,'start':start,'end':time.monotonic()-epoch});return result

def business():
    c,item=request('/items',{'title':'delivery compatibility'})
    assert c==201,(c,item)
    c,job=request('/items/'+str(item['id'])+'/process',{})
    assert c==202,(c,job)
    for _ in range(100):
        c,state=request('/processing-jobs/'+str(job['id']))
        if state.get('state')=='succeeded':return
        time.sleep(.1)
    raise AssertionError('job did not finish')

epoch=time.monotonic();t=None
try:
    run('up');epoch=time.monotonic();t=threading.Thread(target=traffic);t.start()
    event('expand schema',lambda:run('compose','exec','-T','postgres','psql','-U','zero_to_prod_admin','-d','zero_to_prod','-v','ON_ERROR_STOP=1','-c','ALTER TABLE work_items ADD COLUMN IF NOT EXISTS delivery_annotation text'))
    event('blue business on expanded schema',business);time.sleep(2)
    event('switch green',lambda:run('switch','green'));time.sleep(2)
    event('green business',business)
    event('rollback blue',lambda:run('switch','api'));time.sleep(2)
    import os
    env=dict(os.environ,DELIVERY_GREEN_PORT='invalid')
    event('bad candidate startup',lambda:run('compose','up','-d','--no-deps','--force-recreate','green',env=env,check=False))
    time.sleep(2)
    refused=event('bad candidate switch refused',lambda:run('switch','green',check=False))
    assert refused.returncode!=0,'unready candidate was admitted'
    event('blue survives failed rollout',business)
    event('restore green',lambda:run('compose','up','-d','--no-deps','--force-recreate','--wait','green'))
    event('switch restored green',lambda:run('switch','green'));time.sleep(2)
    event('restored green business',business)
finally:
    stop.set()
    if t:t.join()
    run('stop',check=False)
    (output/'requests.json').write_text(json.dumps(rows,indent=2)+'\n')
    (output/'events.json').write_text(json.dumps(events,indent=2)+'\n')
    summary={'requests':len(rows),'errors':[r for r in rows if r['status'] not in (200,201,202)],'versions':sorted({r['data'].get('version','') for r in rows if r['path']=='/version'})}
    (output/'summary.json').write_text(json.dumps(summary,indent=2)+'\n')
assert not summary['errors'],summary
print(json.dumps(summary))
