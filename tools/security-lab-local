AUTHORIZATION_BASELINE_COMMIT=0682b5275998d08c88476429ba6558ebf945417f

usage() {
  cat <<EOF_USAGE
Usage:
  ./tools/security-lab-local init
  ./tools/security-lab-local check-secrets
  ./tools/security-lab-local start
  ./tools/security-lab-local verify [--evidence <file>]
  ./tools/security-lab-local verify-failures [--evidence <file>]
  ./tools/security-lab-local verify-authentication [--evidence <file>] [--skip-slow]
  ./tools/security-lab-local verify-log-hygiene [--evidence <file>]
  ./tools/security-lab-local verify-realm [--evidence <file>]
  ./tools/security-lab-local verify-authorization [--evidence <file>] [--skip-slow]
  ZTP_SECURITY_LAB_PROJECT=zero-to-prod-security-lab-probe ./tools/security-lab-local verify-admin-permissions [--evidence <file>]
  ./tools/security-lab-local lab-user
  ./tools/security-lab-local check-machine-permissions < token-response.json
  ./tools/security-lab-local status
  ./tools/security-lab-local logs [service]
  ./tools/security-lab-local issue-certificate
  ./tools/security-lab-local verify-renewal [--evidence <file>]
  ./tools/security-lab-local issue-internal-certificate <postgres|rabbitmq>
  ./tools/security-lab-local verify-internal-tls [--evidence <file>]
  ./tools/security-lab-local issue-keycloak-certificate
  ./tools/security-lab-local check-keycloak-upstream
  ./tools/security-lab-local capture-idp-hop [--evidence <file>]
  ./tools/security-lab-local verify-keycloak-tls [--evidence <file>]
  ./tools/security-lab-local check-serial-streak "<code> <serial>" [required] [attempts] < observations
  ./tools/security-lab-local ca-certificate
  ./tools/security-lab-local stop
  ./tools/security-lab-local destroy
  ./tools/security-lab-local purge-state --yes
  ./tools/security-lab-local state-dir

Opt-in security lab: an HTTPS ingress on host loopback in front of a
containerized Work Items API, worker, PostgreSQL, RabbitMQ, Keycloak,
oauth2-proxy, and Valkey that publish no ports. It is separate from the
development lab and does not use the development credentials. The API
requires an access token (AUTHENTICATION=oidc); browsers sign in through
oauth2-proxy and Keycloak, machine clients use client credentials.

Commands:
  init               Create the lab CA, ingress certificate, internal CA,
                     PostgreSQL and RabbitMQ certificates, identity-provider
                     CA, Keycloak certificate, and runtime secrets outside the
                     repository. Keeps existing CAs and passwords; reissues
                     certificates near expiry.
  check-secrets      Verify the required runtime secret files and certificate.
  start              Check secrets, build images, start the lab, apply
                     identities and migrations, and wait until healthy.
  verify             Check HTTPS access and backend reachability from the
                     host, Windows (through WSL interop), and test containers.
  verify-failures    Check that missing secrets make each service fail.
  verify-authentication
                     Exercise sign-in, sessions, machine clients, token
                     validation, logout, replay, CSRF, and dependency
                     outages. Stops and restarts lab services; without
                     --skip-slow it waits for access-token expiry.
  verify-log-hygiene Drive a sign-in, failed callbacks (reused code,
                     Keycloak down, gateway down), and a session refresh,
                     and search the logs for
                     the codes, state, cookie, tokens, and secrets used.
                     Stops and restarts Keycloak and oauth2-proxy.
  verify-realm       Read the realm's authorization configuration through the
                     admin API and compare it with the expected model.
  verify-authorization
                     Check the permission matrix on both paths, claims and
                     401/403 ordering, logs, role removal, an identity-provider
                     outage, and a control against the pinned
                     pre-authorization API. Stops and restarts services and
                     changes role mappings temporarily.
  verify-admin-permissions
                     In a throwaway *-probe project, find an
                     irreducible role set for the role-management client;
                     removes that project and its state afterwards.
  lab-user           Show the lab users, their permissions, and password paths.
  check-machine-permissions
                     Read a client-credentials token response on standard
                     input and warn about missing work-items-automation
                     permissions (start runs this against the live client).
  status             Show lab containers.
  logs               Show lab logs.
  issue-certificate  Issue a new ingress certificate, reload the ingress, and
                     confirm a new connection receives the new serial.
  verify-renewal     Renew on the running lab and record before/after serials.
  issue-internal-certificate
                     Issue a new PostgreSQL or RabbitMQ server certificate
                     from the internal CA, reload that service, and confirm
                     new connections verify the new serial.
  verify-internal-tls
                     Exercise internal TLS on the data network: plaintext
                     refusal, an untrusted issuer, a hostname mismatch, an
                     expired certificate, and a certificate also naming an
                     excluded subdomain on PostgreSQL and RabbitMQ, with
                     new versus established connections, recovery, and
                     renewal. Restarts the API and worker and installs bad
                     certificates temporarily.
  issue-keycloak-certificate
                     Issue a new Keycloak certificate from the
                     identity-provider CA and wait until Keycloak rereads it
                     (every ${KEYCLOAK_TLS_RELOAD_SECONDS} s) and five consecutive new connections
                     verify the new serial.
  check-keycloak-upstream
                     Fetch issuer discovery from Keycloak through the
                     ingress's diagnostic route and print nginx's TLS verdict.
  capture-idp-hop    Capture the ingress-Keycloak hop passively during a
                     sign-in and token request and count credentials and
                     plaintext HTTP in it (values are never recorded). Works
                     on labs created before ADR 0007.
  verify-keycloak-tls
                     Exercise the ingress-Keycloak TLS hop: baseline, public
                     metadata and redirects, passive capture, untrusted CA,
                     lab CA, wrong name, expired, excluded subdomain,
                     excluded IP address (with an isolated unconstrained-CA
                     control), new versus established connections, session
                     resumption, recovery, and renewal. Installs bad
                     certificates temporarily; takes about 15 minutes.
  check-serial-streak
                     Test hook: apply the renewal confirmation rule (N
                     consecutive equal observations within M attempts) to
                     observations read from standard input.
  ca-certificate     Show the lab CA certificate paths and fingerprint.
  stop               Stop the lab, keeping its volumes.
  destroy            Remove only this lab's containers, networks, and volumes.
  purge-state        Delete this lab's CA, certificates, and secrets; only a
                     directory carrying this lab's marker and only lab entries.
  state-dir          Print the validated, canonical state directory.

Environment overrides:
  ZTP_SECURITY_LAB_PROJECT     project name (must start with zero-to-prod-security-lab)
  ZTP_SECURITY_LAB_STATE_DIR   secrets and PKI directory; must resolve below
                               \${XDG_STATE_HOME:-~/.local/state} or \${TMPDIR:-/tmp},
                               outside the repository and not containing home
  ZTP_SECURITY_LAB_CA_DAYS    lab CA validity in days (default: 90)
  ZTP_SECURITY_LAB_CERT_DAYS   ingress certificate validity in days (default: 14)

State directory: ${STATE_DIR}
EOF_USAGE
}

die() {
  echo "error: $*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

check_configuration() {
  case "$PROJECT" in
    zero-to-prod-security-lab | zero-to-prod-security-lab-*) ;;
    *) die "ZTP_SECURITY_LAB_PROJECT must start with zero-to-prod-security-lab: ${PROJECT}" ;;
  esac

  # The lab CA's common name embeds the project, and X.509 limits a common
  # name to 64 characters.
  if (( ${#PROJECT} > 33 )); then
    die "ZTP_SECURITY_LAB_PROJECT is too long for the lab CA's name (at most 33 characters): ${PROJECT}"
  fi

  check_state_dir

  if [[ -n "${ZTP_SECURITY_LAB_HTTPS_PORT:-}" && "$ZTP_SECURITY_LAB_HTTPS_PORT" != "$HTTPS_PORT" ]]; then
    die "ZTP_SECURITY_LAB_HTTPS_PORT is no longer supported: the issuer URL fixes the port at ${HTTPS_PORT}"
  fi
}

# True when path $1 is $2 or below it.
is_within() {
  [[ "$1" == "$2" || "$1" == "$2"/* ]]
}

# The state directory holds keys and secrets and is deleted by purge-state,
# so validate its canonical location (symlinks resolved), not its spelling.
check_state_dir() {
  case "$STATE_DIR" in
    /*) ;;
    *) die "ZTP_SECURITY_LAB_STATE_DIR must be an absolute path: ${STATE_DIR}" ;;
  esac

  require_command realpath

  local requested="$STATE_DIR" root home state_base temp_base base allowed=false
  STATE_DIR="$(realpath -m -- "$requested")"
  root="$(cd -- "$ROOT_DIR" && pwd -P)"
  home="$(realpath -m -- "$HOME")"
  state_base="$(realpath -m -- "${XDG_STATE_HOME:-${HOME}/.local/state}")"
  temp_base="$(realpath -m -- "${TMPDIR:-/tmp}")"

  if is_within "$STATE_DIR" "$root" || is_within "$root" "$STATE_DIR"; then
    die "the state directory must not overlap the repository: ${requested} -> ${STATE_DIR}"
  fi

  if is_within "$home" "$STATE_DIR"; then
    die "the state directory must not be or contain the home directory: ${requested} -> ${STATE_DIR}"
  fi

  for base in "$state_base" "$temp_base"; do
    # Ignore a base that would itself admit the home directory or the root.
    if [[ "$base" == / ]] || is_within "$home" "$base"; then
      continue
    fi

    if [[ "$STATE_DIR" == "$base"/* ]]; then
      allowed=true
    fi
  done

  if [[ "$allowed" != true ]]; then
    die "the state directory must be below ${state_base} or ${temp_base}: ${requested} -> ${STATE_DIR}"
  fi

  SECRETS_DIR="${STATE_DIR}/secrets"
  PKI_DIR="${STATE_DIR}/pki"
  INGRESS_TLS_DIR="${STATE_DIR}/ingress-tls"
  INGRESS_TLS_FILE="${INGRESS_TLS_DIR}/tls.pem"
  INTERNAL_TLS_DIR="${STATE_DIR}/internal-tls"
  IDP_TLS_DIR="${STATE_DIR}/idp-tls"
  IDP_TLS_FILE="${IDP_TLS_DIR}/tls.pem"
  STATE_MARKER="${STATE_DIR}/.zero-to-prod-security-lab"
}

STATE_ENTRIES=(.zero-to-prod-security-lab pki secrets ingress-tls internal-tls idp-tls)

# Prints entries of the state directory that the lab does not create.
unexpected_state_entries() {
  local entry expected known
  while IFS= read -r entry; do
    known=false
    for expected in "${STATE_ENTRIES[@]}"; do
      if [[ "$entry" == "$expected" ]]; then
        known=true
      fi
    done
    if [[ "$known" != true ]]; then
      echo "$entry"
    fi
  done < <(find "$STATE_DIR" -mindepth 1 -maxdepth 1 -printf '%f\n')
}

# Create the state directory, or adopt an existing one only when it is this
# lab's: marked for this project, or unmarked but holding only lab entries
# (state created before the marker existed).
claim_state_dir() {
  if [[ ! -e "$STATE_DIR" ]]; then
    (umask 077; mkdir -p "$STATE_DIR")
  elif [[ ! -d "$STATE_DIR" ]]; then
    die "the state path exists and is not a directory: ${STATE_DIR}"
  elif [[ -f "$STATE_MARKER" ]]; then
    [[ "$(cat "$STATE_MARKER")" == "project=${PROJECT}" ]] ||
      die "the state directory belongs to another lab: ${STATE_DIR}"
    return 0
  elif [[ -n "$(unexpected_state_entries)" ]]; then
    die "refusing to use a directory that is not security lab state: ${STATE_DIR}"
  fi

  printf 'project=%s\n' "$PROJECT" > "$STATE_MARKER"
  chmod 600 "$STATE_MARKER"
}

# Destructive operations require a directory this lab created and owns.
require_owned_state() {
  [[ -d "$STATE_DIR" ]] || die "state directory missing: ${STATE_DIR}"
  [[ -f "$STATE_MARKER" && "$(cat "$STATE_MARKER")" == "project=${PROJECT}" ]] ||
    die "no security lab marker for ${PROJECT} in ${STATE_DIR}; refusing"
  [[ "$(stat -c '%u' "$STATE_DIR")" == "$(id -u)" ]] ||
    die "the state directory is not owned by the current user: ${STATE_DIR}"

  local unexpected
  unexpected="$(unexpected_state_entries)"
  [[ -z "$unexpected" ]] ||
    die "unexpected entries in ${STATE_DIR}; refusing: $(tr '\n' ' ' <<< "$unexpected")"
}

compose() {
  ZTP_SECURITY_LAB_SECRETS_DIR="$SECRETS_DIR" \
    ZTP_SECURITY_LAB_INGRESS_TLS_DIR="$INGRESS_TLS_DIR" \
    ZTP_SECURITY_LAB_CA_FILE="${PKI_DIR}/ca.crt" \
    ZTP_SECURITY_LAB_INTERNAL_CA_FILE="${PKI_DIR}/internal-ca.crt" \
    ZTP_SECURITY_LAB_INTERNAL_TLS_DIR="$INTERNAL_TLS_DIR" \
    ZTP_SECURITY_LAB_IDP_CA_FILE="${PKI_DIR}/idp-ca.crt" \
    ZTP_SECURITY_LAB_IDP_TLS_DIR="$IDP_TLS_DIR" \
    docker compose \
      --project-name "$PROJECT" \
      -f "$COMPOSE_FILE" \
      "$@"
}

# ---------------------------------------------------------------------------
# PKI and secrets
# ---------------------------------------------------------------------------

write_file() {
  local path="$1"
  local mode="$2"
  local temporary="${path}.tmp.$$"

  cat > "$temporary"
  chmod "$mode" "$temporary"

  # Keep an unchanged file in place: replacing it gives it a new inode, and
  # containers created earlier would keep mounting the old one.
  if [[ -f "$path" ]] && cmp -s "$temporary" "$path"; then
    rm -f "$temporary"
    chmod "$mode" "$path"
    return 0
  fi

  mv -f "$temporary" "$path"
}

init_ca() {
  if [[ -f "${PKI_DIR}/ca.key" ]]; then
    echo "Lab CA exists: ${PKI_DIR}/ca.crt"
    return 0
  fi

  echo "Creating lab CA (${CA_DAYS} days, name-constrained to ${LAB_HOSTNAME})..."

  (
    umask 077
    openssl req -x509 -new \
      -newkey ec -pkeyopt ec_paramgen_curve:P-256 -noenc \
      -keyout "${PKI_DIR}/ca.key" \
      -out "${PKI_DIR}/ca.crt" \
      -days "$CA_DAYS" \
      -subj "/O=Zero-to-Prod security lab/CN=Zero-to-Prod security lab CA (${PROJECT})" \
      -addext "basicConstraints=critical,CA:TRUE,pathlen:0" \
      -addext "keyUsage=critical,keyCertSign,cRLSign" \
      -addext "nameConstraints=critical,permitted;DNS:${LAB_HOSTNAME},excluded;IP:0.0.0.0/0.0.0.0,excluded;IP:::/::" \
      -addext "subjectKeyIdentifier=hash" \
      2>/dev/null
  )

  chmod 600 "${PKI_DIR}/ca.key"
  chmod 644 "${PKI_DIR}/ca.crt"
}

issue_certificate() {
  local csr="${PKI_DIR}/ingress.csr"
  local extensions="${PKI_DIR}/ingress.ext"
  local key="${INGRESS_TLS_DIR}/.tls.key.tmp"
  local certificate="${PKI_DIR}/ingress.crt"
  local bundle="${INGRESS_TLS_DIR}/.tls.pem.tmp"

  [[ -f "${PKI_DIR}/ca.key" ]] || die "lab CA missing; run: $0 init"

  echo "Issuing ingress certificate for ${LAB_HOSTNAME} and ${AUTH_HOSTNAME} (${CERT_DAYS} days)..."

  # The CA's name constraint (DNS:${LAB_HOSTNAME}) also permits its subdomains.
  cat > "$extensions" <<EOF_EXT
basicConstraints=critical,CA:FALSE
keyUsage=critical,digitalSignature
extendedKeyUsage=serverAuth
subjectAltName=DNS:${LAB_HOSTNAME},DNS:${AUTH_HOSTNAME}
subjectKeyIdentifier=hash
authorityKeyIdentifier=keyid
EOF_EXT

  (
    umask 077
    openssl req -new \
      -newkey ec -pkeyopt ec_paramgen_curve:P-256 -noenc \
      -keyout "$key" \
      -out "$csr" \
      -subj "/CN=${LAB_HOSTNAME}" \
      2>/dev/null

    openssl x509 -req \
      -in "$csr" \
      -CA "${PKI_DIR}/ca.crt" \
      -CAkey "${PKI_DIR}/ca.key" \
      -set_serial "0x$(openssl rand -hex 16)" \
      -days "$CERT_DAYS" \
      -extfile "$extensions" \
      -out "${certificate}.tmp" \
      2>/dev/null
  )

  rm -f "$csr" "$extensions"

  # Key and certificate in one file, replaced by a single rename, so nginx
  # can never load a mismatched pair. The unprivileged ingress user must read
  # it; see "Secret file permissions" in the security lab guide.
  cat "$key" "${certificate}.tmp" > "$bundle"
  rm -f "$key"
  chmod 644 "$bundle" "${certificate}.tmp"
  mv -f "$bundle" "$INGRESS_TLS_FILE"
  mv -f "${certificate}.tmp" "$certificate"
}

certificate_serial() {
  openssl x509 -noout -serial -in "$1" | cut -d= -f2
}

# A separate CA for service-to-service TLS (ADR 0006). Browsers and the
# Windows trust store may trust the lab CA; the internal CA is trusted only by
# the internal clients it is mounted into, and may issue only for the exact
# internal service names.
#
# A permitted dNSName constraint "postgres" also permits every subdomain
# ("extra.postgres"; RFC 5280). Excluding ".postgres" removes the subdomains
# and keeps the name itself: OpenSSL (libpq) and Go's crypto/x509 (pgx,
# amqp091-go) both read a leading dot as "proper subdomains only". RFC 5280
# does not define the leading dot for dNSName, so other verifiers may differ.
internal_ca_name_constraints() {
  local service permitted="" excluded=""
  for service in "${INTERNAL_TLS_SERVICES[@]}"; do
    permitted+="permitted;DNS:${service},"
    excluded+="excluded;DNS:.${service},"
  done
  echo "${permitted}${excluded}excluded;IP:0.0.0.0/0.0.0.0,excluded;IP:::/::"
}

# True when the CA certificate $1 permits each name in $2… and excludes its
# subdomains (".<name>").
ca_constraints_ok() {
  local text permitted excluded name
  text="$(openssl x509 -noout -ext nameConstraints -in "$1" 2>/dev/null)" || return 1
  shift
  permitted="$(sed -n '/Permitted:/,/Excluded:/p' <<< "$text" | tr -d ' ')"
  excluded="$(sed -n '/Excluded:/,$p' <<< "$text" | tr -d ' ')"
  for name in "$@"; do
    grep -qx "DNS:${name}" <<< "$permitted" || return 1
    grep -qx "DNS:\.${name}" <<< "$excluded" || return 1
  done
}

# True when the internal CA carries the current constraints: each service
# name permitted and its subdomains excluded.
internal_ca_constraints_ok() {
  ca_constraints_ok "${PKI_DIR}/internal-ca.crt" "${INTERNAL_TLS_SERVICES[@]}"
}

# Create a private CA at prefix $1 (<prefix>.key, mode 600; <prefix>.crt)
# with common name $2 and the nameConstraints value $3. It may not issue
# intermediate CAs.
create_ca() {
  local prefix="$1" common_name="$2" constraints="$3"
  (
    umask 077
    openssl req -x509 -new \
      -newkey ec -pkeyopt ec_paramgen_curve:P-256 -noenc \
      -keyout "${prefix}.key" \
      -out "${prefix}.crt" \
      -days "$CA_DAYS" \
      -subj "/O=Zero-to-Prod security lab/CN=${common_name}" \
      -addext "basicConstraints=critical,CA:TRUE,pathlen:0" \
      -addext "keyUsage=critical,keyCertSign,cRLSign" \
      -addext "nameConstraints=critical,${constraints}" \
      -addext "subjectKeyIdentifier=hash" \
      2>/dev/null
  )

  chmod 600 "${prefix}.key"
  chmod 644 "${prefix}.crt"
}

init_internal_ca() {
  if [[ -f "${PKI_DIR}/internal-ca.key" ]]; then
    if internal_ca_constraints_ok; then
      echo "Internal CA exists: ${PKI_DIR}/internal-ca.crt"
      return 0
    fi
    # An internal CA from before the subdomain exclusion. Only internal
    # clients trust it, and start recreates them, so replace it; the
    # certificates it issued no longer verify and are reissued below.
    echo "Replacing the internal CA: its name constraints permit subdomains of the service names."
    rm -f "${PKI_DIR}/internal-ca.key" "${PKI_DIR}/internal-ca.crt"
  fi

  echo "Creating internal CA (${CA_DAYS} days, name-constrained to exactly ${INTERNAL_TLS_SERVICES[*]})..."
  create_ca "${PKI_DIR}/internal-ca" "Zero-to-Prod internal CA (${PROJECT})" "$(internal_ca_name_constraints)"
}

# A third CA, for the ingress → Keycloak hop only (ADR 0007). Only the ingress
# trusts it, and it may issue only for the exact name keycloak. It is kept
# apart from the internal CA so that neither CA's key can vouch for the other
# hop, and the internal CA's policy (ADR 0006) stays unchanged.
idp_ca_constraints_ok() {
  ca_constraints_ok "${PKI_DIR}/idp-ca.crt" "$IDP_TLS_NAME"
}

init_idp_ca() {
  if [[ -f "${PKI_DIR}/idp-ca.key" ]]; then
    if idp_ca_constraints_ok; then
      echo "Identity-provider CA exists: ${PKI_DIR}/idp-ca.crt"
      return 0
    fi
    echo "Replacing the identity-provider CA: its name constraints are not exactly ${IDP_TLS_NAME}."
    rm -f "${PKI_DIR}/idp-ca.key" "${PKI_DIR}/idp-ca.crt"
  fi

  echo "Creating identity-provider CA (${CA_DAYS} days, name-constrained to exactly ${IDP_TLS_NAME})..."
  create_ca "${PKI_DIR}/idp-ca" "Zero-to-Prod IdP CA (${PROJECT})" \
    "permitted;DNS:${IDP_TLS_NAME},excluded;DNS:.${IDP_TLS_NAME},excluded;IP:0.0.0.0/0.0.0.0,excluded;IP:::/::"
}

# Write a new key and a server certificate for the subjectAltName list $3
# ("DNS:a,DNS:b"), signed by the CA at prefix $2, to the file $1 (key and
# certificate in one file, replaced by a single rename). Remaining arguments
# are openssl validity options (default: -days CERT_DAYS).
write_server_certificate() {
  local file="$1" ca="$2" san="$3" common_name work
  shift 3
  local validity=("$@")
  [[ ${#validity[@]} -gt 0 ]] || validity=(-days "$CERT_DAYS")
  common_name="${san%%,*}"
  common_name="${common_name#DNS:}"

  work="$(mktemp -d "${PKI_DIR}/.issue.XXXXXX")"

  cat > "${work}/ext" <<EOF_EXT
basicConstraints=critical,CA:FALSE
keyUsage=critical,digitalSignature
extendedKeyUsage=serverAuth
subjectAltName=${san}
subjectKeyIdentifier=hash
authorityKeyIdentifier=keyid
EOF_EXT

  (
    umask 077
    openssl req -new \
      -newkey ec -pkeyopt ec_paramgen_curve:P-256 -noenc \
      -keyout "${work}/key" \
      -out "${work}/csr" \
      -subj "/CN=${common_name}" \
      2>/dev/null

    openssl x509 -req \
      -in "${work}/csr" \
      -CA "${ca}.crt" \
      -CAkey "${ca}.key" \
      -set_serial "0x$(openssl rand -hex 16)" \
      "${validity[@]}" \
      -extfile "${work}/ext" \
      -out "${work}/crt" \
      2>/dev/null
  ) || { rm -rf -- "$work"; return 1; }

  # Same layout and permissions as the ingress (see "Secret file
  # permissions" in the guide): one file, replaced by a single rename.
  cat "${work}/key" "${work}/crt" > "$(dirname -- "$file")/.tls.pem.tmp"
  rm -rf -- "$work"
  chmod 644 "$(dirname -- "$file")/.tls.pem.tmp"
  mv -f "$(dirname -- "$file")/.tls.pem.tmp" "$file"
}

# Validity options of a certificate whose validity ended a day ago.
expired_validity() {
  echo "-not_before $(date -u -d '-2 days' +%Y%m%d%H%M%SZ) -not_after $(date -u -d '-1 day' +%Y%m%d%H%M%SZ)"
}

# Issue a server certificate for an internal service and replace its
# tls.pem (key and certificate) by a single rename. Only "valid" is used in
# normal operation; the other kinds exist for verify-internal-tls:
#   valid      internal CA, the service's own name, CERT_DAYS
#   mismatch   internal CA, another internal service's name
#   expired    internal CA, the right name, validity ended a day ago
#   untrusted  the right name, signed by the CA in directory $3 (not the
#              internal CA)
#   subdomain  internal CA, the right name plus "extra.<service>", which the
#              CA's constraints exclude
issue_internal_certificate() {
  local service="$1" kind="${2:-valid}"
  local dir="${INTERNAL_TLS_DIR}/${service}"
  local ca="${PKI_DIR}/internal-ca" san="DNS:${service}" other
  local validity=()

  [[ -f "${ca}.key" ]] || die "internal CA missing; run: $0 init"
  [[ -d "$dir" ]] || die "internal TLS directory missing: ${dir}; run: $0 init"

  case "$kind" in
    valid) ;;
    mismatch)
      for other in "${INTERNAL_TLS_SERVICES[@]}"; do
        [[ "$other" != "$service" ]] && san="DNS:${other}" && break
      done
      ;;
    expired) read -r -a validity <<< "$(expired_validity)" ;;
    untrusted) ca="${3:?untrusted requires a CA directory}/ca" ;;
    subdomain) san+=",DNS:extra.${service}" ;;
    *) die "unknown certificate kind: ${kind}" ;;
  esac

  write_server_certificate "${dir}/tls.pem" "$ca" "$san" "${validity[@]}" ||
    die "issuing the ${kind} certificate for ${service} failed"
}

# Issue Keycloak's certificate (ADR 0007) and replace idp-tls/tls.pem by a
# single rename. Only "valid" is used in normal operation; the other kinds
# exist for verify-keycloak-tls:
#   valid      identity-provider CA, the name keycloak, CERT_DAYS
#   untrusted  the name keycloak, signed by the CA in directory $2
#   lab-ca     the name keycloak, signed by the browser-trusted lab CA
#   mismatch   identity-provider CA, another name (postgres), which the CA's
#              constraints do not permit either
#   expired    identity-provider CA, the name keycloak, ended a day ago
#   subdomain  identity-provider CA, keycloak plus extra.keycloak, which the
#              CA's constraints exclude
#   ip         identity-provider CA, keycloak plus IP:127.0.0.1; the name
#              dialed matches, and the CA's IP exclusion refuses it
issue_keycloak_certificate() {
  local kind="${1:-valid}" ca="${PKI_DIR}/idp-ca" san="DNS:${IDP_TLS_NAME}"
  local validity=()

  [[ -f "${PKI_DIR}/idp-ca.key" ]] || die "identity-provider CA missing; run: $0 init"
  [[ -d "$IDP_TLS_DIR" ]] || die "identity-provider TLS directory missing: ${IDP_TLS_DIR}; run: $0 init"

  case "$kind" in
    valid) ;;
    untrusted) ca="${2:?untrusted requires a CA directory}/ca" ;;
    lab-ca) ca="${PKI_DIR}/ca" ;;
    mismatch) san="DNS:postgres" ;;
    expired) read -r -a validity <<< "$(expired_validity)" ;;
    subdomain) san+=",DNS:extra.${IDP_TLS_NAME}" ;;
    ip) san+=",IP:127.0.0.1" ;;
    *) die "unknown certificate kind: ${kind}" ;;
  esac

  write_server_certificate "$IDP_TLS_FILE" "$ca" "$san" "${validity[@]}" ||
    die "issuing the ${kind} certificate for ${IDP_TLS_NAME} failed"
}

# True when the service's certificate verifies against the internal CA for
# its own name and stays valid for at least $2 seconds.
internal_certificate_ok() {
  local service="$1" seconds="${2:-0}" file="${INTERNAL_TLS_DIR}/${1}/tls.pem"
  [[ -s "$file" ]] &&
    openssl verify -CAfile "${PKI_DIR}/internal-ca.crt" -verify_hostname "$service" \
      -purpose sslserver "$file" >/dev/null 2>&1 &&
    openssl x509 -checkend "$seconds" -noout -in "$file" >/dev/null 2>&1
}

# True when Keycloak's certificate verifies against the identity-provider CA
# for the name keycloak and stays valid for at least $1 seconds.
keycloak_certificate_ok() {
  local seconds="${1:-0}"
  [[ -s "$IDP_TLS_FILE" ]] &&
    openssl verify -CAfile "${PKI_DIR}/idp-ca.crt" -verify_hostname "$IDP_TLS_NAME" \
      -purpose sslserver "$IDP_TLS_FILE" >/dev/null 2>&1 &&
    openssl x509 -checkend "$seconds" -noout -in "$IDP_TLS_FILE" >/dev/null 2>&1
}

# Serial of the certificate the ingress serves on a new, verified connection.
served_serial() {
  openssl s_client \
    -connect "127.0.0.1:${HTTPS_PORT}" \
    -servername "$LAB_HOSTNAME" \
    -verify_hostname "$LAB_HOSTNAME" \
    -CAfile "${PKI_DIR}/ca.crt" \
    -verify_return_error \
    </dev/null 2>/dev/null \
    | openssl x509 -noout -serial 2>/dev/null \
    | cut -d= -f2
}

secret() {
  tr -d '\r\n' < "${SECRETS_DIR}/$1"
}

rabbitmq_password_hash() {
  # rabbit_password_hashing_sha256: base64(salt || sha256(salt || password))
  local password="$1"
  local salt_file
  local digest_file

  salt_file="$(mktemp "${SECRETS_DIR}/.salt.XXXXXX")"
  digest_file="$(mktemp "${SECRETS_DIR}/.digest.XXXXXX")"

  openssl rand 4 > "$salt_file"
  { cat "$salt_file"; printf '%s' "$password"; } \
    | openssl dgst -sha256 -binary > "$digest_file"
  cat "$salt_file" "$digest_file" | openssl base64 -A

  rm -f "$salt_file" "$digest_file"
}

derive_secrets() {
  local migrator app worker publisher rabbitmq_worker

  migrator="$(secret postgres-migrator-password)"
  app="$(secret postgres-app-password)"
  worker="$(secret postgres-worker-password)"
  publisher="$(secret rabbitmq-publisher-password)"
  rabbitmq_worker="$(secret rabbitmq-worker-password)"

  # TLS with server and name verification against the internal CA (ADR
  # 0006). verify-full never falls back to plaintext; the amqps scheme has no
  # plaintext mode, and the drivers take the server name from the host.
  local pg_tls="sslmode=verify-full&sslrootcert=${INTERNAL_CA_MOUNT}"
  local amqp_tls="cacertfile=${INTERNAL_CA_MOUNT}"
  printf 'postgres://zero_to_prod_migrator:%s@postgres:5432/%s?%s\n' "$migrator" "$POSTGRES_DB" "$pg_tls" \
    | write_file "${SECRETS_DIR}/postgres-migrator-url" 644
  printf 'postgres://zero_to_prod_app:%s@postgres:5432/%s?%s\n' "$app" "$POSTGRES_DB" "$pg_tls" \
    | write_file "${SECRETS_DIR}/api-database-url" 644
  printf 'postgres://zero_to_prod_worker:%s@postgres:5432/%s?%s\n' "$worker" "$POSTGRES_DB" "$pg_tls" \
    | write_file "${SECRETS_DIR}/worker-database-url" 644
  printf 'amqps://zero_to_prod_publisher:%s@rabbitmq:5671/%s?%s\n' "$publisher" "$RABBITMQ_VHOST" "$amqp_tls" \
    | write_file "${SECRETS_DIR}/api-rabbitmq-url" 644
  printf 'amqps://zero_to_prod_worker:%s@rabbitmq:5671/%s?%s\n' "$rabbitmq_worker" "$RABBITMQ_VHOST" "$amqp_tls" \
    | write_file "${SECRETS_DIR}/worker-rabbitmq-url" 644

  derive_authentication_configs

  # The password hashes are salted randomly, so regenerate the definitions
  # only when they are missing or a RabbitMQ password was just generated.
  if [[ -s "${SECRETS_DIR}/rabbitmq-definitions" && "${1:-}" != regenerate-rabbitmq ]]; then
    return 0
  fi

  # Same users and permissions as tools/rabbitmq-local; no default or
  # administrative user is defined.
  cat <<EOF_DEFINITIONS | write_file "${SECRETS_DIR}/rabbitmq-definitions" 644
{
  "users": [
    {
      "name": "zero_to_prod_publisher",
      "password_hash": "$(rabbitmq_password_hash "$publisher")",
      "hashing_algorithm": "rabbit_password_hashing_sha256",
      "tags": []
    },
    {
      "name": "zero_to_prod_worker",
      "password_hash": "$(rabbitmq_password_hash "$rabbitmq_worker")",
      "hashing_algorithm": "rabbit_password_hashing_sha256",
      "tags": []
    }
  ],
  "vhosts": [
    { "name": "${RABBITMQ_VHOST}" }
  ],
  "permissions": [
    {
      "user": "zero_to_prod_publisher",
      "vhost": "${RABBITMQ_VHOST}",
      "configure": "^\$",
      "write": "^amq\\\\.default\$",
      "read": "^\$"
    },
    {
      "user": "zero_to_prod_worker",
      "vhost": "${RABBITMQ_VHOST}",
      "configure": "^\$",
      "write": "^\$",
      "read": "^${RABBITMQ_QUEUE}\$"
    }
  ],
  "queues": [
    {
      "name": "${RABBITMQ_QUEUE}",
      "vhost": "${RABBITMQ_VHOST}",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    }
  ]
}
EOF_DEFINITIONS
}

audience_mapper() {
  cat <<EOF_MAPPER
{ "name": "${API_AUDIENCE} audience", "protocol": "openid-connect",
  "protocolMapper": "oidc-audience-mapper",
  "config": { "included.custom.audience": "${API_AUDIENCE}",
              "access.token.claim": "true", "id.token.claim": "false",
              "introspection.token.claim": "true" } }
EOF_MAPPER
}

# Keycloak, oauth2-proxy, and Valkey configuration. Keycloak imports the
# realm only when it does not exist yet, so a changed realm file reaches a
# running lab only after destroy (see the guide).
#
# Keycloak (ADR 0007) serves only HTTPS, from idp-tls/tls.pem, which it
# rereads every KEYCLOAK_TLS_RELOAD_SECONDS. Its management interface (health
# only) stays plain HTTP, bound to the container loopback for the health check.
# Keycloak logs an INFO line per event-loop thread on every reload, changed or
# not (about 20 lines every 35 s, measured); that logger is set to warn.
derive_authentication_configs() {
  cat <<EOF_CONF | write_file "${SECRETS_DIR}/keycloak.conf" 644
db=postgres
db-url-host=keycloak-postgres
db-url-database=keycloak
db-username=keycloak
db-password=$(secret keycloak-db-password)
hostname=https://${AUTH_HOSTNAME}:${HTTPS_PORT}
proxy-headers=xforwarded
http-enabled=false
https-port=${IDP_TLS_PORT}
https-certificate-file=/run/keycloak-tls/tls.pem
https-certificate-key-file=/run/keycloak-tls/tls.pem
https-certificates-reload-period=${KEYCLOAK_TLS_RELOAD_SECONDS}s
https-protocols=TLSv1.3,TLSv1.2
health-enabled=true
http-management-scheme=http
http-management-host=127.0.0.1
log-level=info,io.quarkus.vertx.http.runtime.HttpCertificateUpdateEventListener:warn
EOF_CONF

  # Clients: the gateway (browser), the automation machine client, the
  # work-items-api client that owns the permission roles (no flows), and the
  # lab's role-management client (see LAB_ADMIN_ROLES).
  #
  # Permissions are client roles of work-items-api; the API reads only
  # resource_access["work-items-api"].roles. editor and viewer are composite
  # roles for people. lab-outsider holds permission names only where they
  # must grant nothing (a realm role and a gateway-client role).
  local admin_roles
  admin_roles="$(printf '"%s",' "${LAB_ADMIN_ROLES[@]}")"
  admin_roles="${admin_roles%,}"
  cat <<EOF_REALM | write_file "${SECRETS_DIR}/realm-work-items.json" 644
{
  "realm": "work-items", "enabled": true, "sslRequired": "external",
  "accessTokenLifespan": ${ACCESS_TOKEN_SECONDS},
  "ssoSessionIdleTimeout": 1800, "ssoSessionMaxLifespan": 28800,
  "bruteForceProtected": true, "registrationAllowed": false,
  "roles": {
    "realm": [
      { "name": "items.create", "description": "Misplaced-claim test: a realm role named like a permission; grants nothing" }
    ],
    "client": {
      "work-items-api": [
        { "name": "items.read", "description": "List Work Items and read processing jobs" },
        { "name": "items.create", "description": "Create Work Items" },
        { "name": "items.process", "description": "Request processing of a Work Item" },
        { "name": "editor", "description": "People who create and process Work Items", "composite": true,
          "composites": { "client": { "work-items-api": ["items.read", "items.create", "items.process"] } } },
        { "name": "viewer", "description": "People who only read Work Items", "composite": true,
          "composites": { "client": { "work-items-api": ["items.read"] } } }
      ],
      "work-items-gateway": [
        { "name": "items.create", "description": "Misplaced-claim test: another client's role named like a permission; grants nothing" }
      ]
    }
  },
  "clients": [
    { "clientId": "work-items-api", "enabled": true, "protocol": "openid-connect",
      "publicClient": true, "standardFlowEnabled": false, "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false, "serviceAccountsEnabled": false,
      "description": "Owns the Work Items permission roles; no flows" },
    { "clientId": "work-items-lab-admin", "enabled": true, "protocol": "openid-connect",
      "publicClient": false, "clientAuthenticatorType": "client-secret",
      "secret": "$(secret lab-admin-client-secret)",
      "standardFlowEnabled": false, "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false, "serviceAccountsEnabled": true,
      "description": "Lab role management for verify-realm and verify-authorization; internal network only" },
    { "clientId": "work-items-gateway", "enabled": true, "protocol": "openid-connect",
      "publicClient": false, "clientAuthenticatorType": "client-secret",
      "secret": "$(secret gateway-client-secret)",
      "standardFlowEnabled": true, "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false, "serviceAccountsEnabled": false,
      "redirectUris": ["${APP_URL}/oauth2/callback"], "webOrigins": ["${APP_URL}"],
      "attributes": { "pkce.code.challenge.method": "S256",
                      "post.logout.redirect.uris": "${APP_URL}/*" },
      "protocolMappers": [ $(audience_mapper) ] },
    { "clientId": "work-items-automation", "enabled": true, "protocol": "openid-connect",
      "publicClient": false, "clientAuthenticatorType": "client-secret",
      "secret": "$(secret automation-client-secret)",
      "standardFlowEnabled": false, "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false, "serviceAccountsEnabled": true,
      "protocolMappers": [ $(audience_mapper) ] }
  ],
  "users": [
    { "username": "lab-user", "enabled": true, "email": "lab-user@${LAB_HOSTNAME}",
      "emailVerified": true, "firstName": "Lab", "lastName": "User",
      "credentials": [ { "type": "password", "value": "$(secret lab-user-password)", "temporary": false } ],
      "clientRoles": { "work-items-api": ["editor"] } },
    { "username": "lab-viewer", "enabled": true, "email": "lab-viewer@${LAB_HOSTNAME}",
      "emailVerified": true, "firstName": "Lab", "lastName": "Viewer",
      "credentials": [ { "type": "password", "value": "$(secret lab-viewer-password)", "temporary": false } ],
      "clientRoles": { "work-items-api": ["viewer"] } },
    { "username": "lab-outsider", "enabled": true, "email": "lab-outsider@${LAB_HOSTNAME}",
      "emailVerified": true, "firstName": "Lab", "lastName": "Outsider",
      "credentials": [ { "type": "password", "value": "$(secret lab-outsider-password)", "temporary": false } ],
      "realmRoles": ["items.create"],
      "clientRoles": { "work-items-gateway": ["items.create"] } },
    { "username": "service-account-work-items-automation", "enabled": true,
      "serviceAccountClientId": "work-items-automation",
      "clientRoles": { "work-items-api": ["items.read", "items.process"] } },
    { "username": "service-account-work-items-lab-admin", "enabled": true,
      "serviceAccountClientId": "work-items-lab-admin",
      "clientRoles": { "realm-management": [${admin_roles}] } }
  ]
}
EOF_REALM

  # Sign-out deletes the Valkey session and calls Keycloak's end-session
  # endpoint with the session's ID token (backend_logout_url), so ending the
  # gateway session also ends the identity-provider session.
  cat <<EOF_OAUTH2 | write_file "${SECRETS_DIR}/oauth2-proxy.cfg" 644
provider = "keycloak-oidc"
oidc_issuer_url = "${ISSUER}"
client_id = "work-items-gateway"
client_secret = "$(secret gateway-client-secret)"
redirect_url = "${APP_URL}/oauth2/callback"
code_challenge_method = "S256"
email_domains = ["*"]
provider_ca_files = ["/lab-ca/ca.crt"]
http_address = "0.0.0.0:4180"
reverse_proxy = true
upstreams = ["static://202"]
set_xauthrequest = true
pass_access_token = true
skip_provider_button = true
cookie_name = "__Host-wi-session"
cookie_secret = "$(secret oauth2-proxy-cookie-secret)"
cookie_secure = true
cookie_httponly = true
cookie_samesite = "lax"
cookie_expire = "8h"
cookie_refresh = "${SESSION_REFRESH}"
session_store_type = "redis"
redis_connection_url = "redis://valkey:6379"
redis_password = "$(secret valkey-password)"
backend_logout_url = "${ISSUER}/protocol/openid-connect/logout?id_token_hint={id_token}"
# The default request log includes the request URI, so a callback logs its
# authorization code and state. Log everything else; the request ID (set by
# the ingress) matches each line to the ingress's path-only access log.
request_id_header = "X-Request-Id"
request_logging_format = "{{.Client}} - {{.RequestID}} - {{.Username}} [{{.Timestamp}}] {{.Host}} {{.RequestMethod}} {{.Upstream}} {{.Protocol}} {{.UserAgent}} {{.StatusCode}} {{.ResponseSize}} {{.RequestDuration}}"
EOF_OAUTH2

  cat <<EOF_VALKEY | write_file "${SECRETS_DIR}/valkey.conf" 644
bind 0.0.0.0
port 6379
protected-mode yes
requirepass $(secret valkey-password)
save ""
appendonly no
EOF_VALKEY
}

init_state() {
  require_command openssl

  claim_state_dir
  (umask 077; mkdir -p "$SECRETS_DIR" "$PKI_DIR" "$INGRESS_TLS_DIR")
  chmod 700 "$STATE_DIR" "$SECRETS_DIR" "$PKI_DIR"
  # Mounted as the container's directory, where the unprivileged nginx user
  # must traverse it; on the host the mode-700 state directory protects it.
  chmod 711 "$INGRESS_TLS_DIR"

  init_ca
  init_internal_ca
  init_idp_ca

  # Mounted into PostgreSQL and RabbitMQ as their TLS directories; mode 711
  # like ingress-tls. Reissue when missing, within two days of expiry, or
  # when the file does not verify for the service's name against the internal
  # CA (for example after an interrupted verify-internal-tls).
  local service
  for service in "${INTERNAL_TLS_SERVICES[@]}"; do
    (umask 077; mkdir -p "${INTERNAL_TLS_DIR}/${service}")
    chmod 711 "$INTERNAL_TLS_DIR" "${INTERNAL_TLS_DIR}/${service}"
    if ! internal_certificate_ok "$service" 172800; then
      echo "Issuing internal certificate for ${service} (${CERT_DAYS} days)..."
      issue_internal_certificate "$service" valid
    fi
  done

  # Mounted into Keycloak; same layout, modes, and reissue rule.
  (umask 077; mkdir -p "$IDP_TLS_DIR")
  chmod 711 "$IDP_TLS_DIR"
  if ! keycloak_certificate_ok 172800; then
    echo "Issuing Keycloak certificate for ${IDP_TLS_NAME} (${CERT_DAYS} days)..."
    issue_keycloak_certificate valid
  fi

  # Earlier versions mounted the ingress key and certificate as single files.
  rm -f "${SECRETS_DIR}/ingress-tls-key" "${SECRETS_DIR}/ingress-tls-chain"

  # Reissue near expiry, and when an earlier certificate lacks the identity
  # provider's name.
  if [[ ! -f "$INGRESS_TLS_FILE" ]] ||
     ! openssl x509 -checkend 172800 -noout -in "$INGRESS_TLS_FILE" >/dev/null 2>&1 ||
     ! openssl x509 -noout -checkhost "$AUTH_HOSTNAME" -in "$INGRESS_TLS_FILE" 2>/dev/null | grep -q ' does match '; then
    issue_certificate
  fi

  local name rabbitmq_changed=""
  for name in "${SOURCE_SECRETS[@]}"; do
    if [[ ! -s "${SECRETS_DIR}/${name}" ]]; then
      if [[ "$name" == oauth2-proxy-cookie-secret ]]; then
        # oauth2-proxy requires a 16, 24, or 32 byte secret: 32 hex characters.
        openssl rand -hex 16 | write_file "${SECRETS_DIR}/${name}" 600
      else
        openssl rand -hex 24 | write_file "${SECRETS_DIR}/${name}" 600
      fi
      echo "Generated ${name}"
      if [[ "$name" == rabbitmq-* ]]; then
        rabbitmq_changed=regenerate-rabbitmq
      fi
    fi
  done

  # PostgreSQL reads these as its own unprivileged user.
  chmod 644 \
    "${SECRETS_DIR}/postgres-admin-password" \
    "${SECRETS_DIR}/postgres-migrator-password" \
    "${SECRETS_DIR}/postgres-app-password" \
    "${SECRETS_DIR}/postgres-worker-password" \
    "${SECRETS_DIR}/keycloak-db-password"

  derive_secrets "$rabbitmq_changed"

  echo "Security lab state ready: ${STATE_DIR}"
}

check_secrets() {
  local failures=0
  local name path mode

  require_command openssl

  [[ -d "$SECRETS_DIR" ]] || die "secrets directory missing: ${SECRETS_DIR} (run: $0 init)"

  mode="$(stat -c '%a' "$SECRETS_DIR")"
  if [[ "$mode" != "700" ]]; then
    echo "error: ${SECRETS_DIR} must have mode 700 (found ${mode})" >&2
    failures=$((failures + 1))
  fi

  for name in "${MOUNTED_SECRETS[@]}"; do
    path="${SECRETS_DIR}/${name}"

    if [[ -d "$path" ]]; then
      # Docker creates a directory when a bind-mounted secret file is missing.
      echo "error: ${path} is a directory, not a secret file; remove it and run: $0 init" >&2
      failures=$((failures + 1))
    elif [[ ! -f "$path" ]]; then
      echo "error: required secret file missing: ${path}" >&2
      failures=$((failures + 1))
    elif [[ ! -s "$path" ]]; then
      echo "error: required secret file empty: ${path}" >&2
      failures=$((failures + 1))
    fi
  done

  if [[ ! -d "$INGRESS_TLS_DIR" ]]; then
    echo "error: ingress TLS directory missing: ${INGRESS_TLS_DIR} (run: $0 init)" >&2
    failures=$((failures + 1))
  elif [[ "$(stat -c '%a' "$INGRESS_TLS_DIR")" != "711" ]]; then
    echo "error: ${INGRESS_TLS_DIR} must have mode 711 (run: $0 init)" >&2
    failures=$((failures + 1))
  elif [[ ! -f "$INGRESS_TLS_FILE" || ! -s "$INGRESS_TLS_FILE" ]]; then
    echo "error: required ingress TLS file missing or empty: ${INGRESS_TLS_FILE}" >&2
    failures=$((failures + 1))
  fi

  if [[ "$failures" -eq 0 ]]; then
    if ! openssl verify -CAfile "${PKI_DIR}/ca.crt" "$INGRESS_TLS_FILE" >/dev/null 2>&1; then
      echo "error: the ingress certificate does not verify against the lab CA" >&2
      failures=$((failures + 1))
    fi

    if ! openssl x509 -checkend 0 -noout -in "$INGRESS_TLS_FILE" >/dev/null; then
      echo "error: the ingress certificate has expired; run: $0 issue-certificate" >&2
      failures=$((failures + 1))
    fi

    if [[ "$(openssl x509 -noout -pubkey -in "$INGRESS_TLS_FILE" | openssl sha256)" != \
          "$(openssl pkey -pubout -in "$INGRESS_TLS_FILE" | openssl sha256)" ]]; then
      echo "error: the ingress key does not match its certificate" >&2
      failures=$((failures + 1))
    fi
  fi

  # Internal TLS (ADR 0006): each server certificate verifies for its own
  # name against the internal CA, is unexpired, and matches its key.
  local service file
  if [[ ! -f "${PKI_DIR}/internal-ca.crt" ]]; then
    echo "error: internal CA certificate missing: ${PKI_DIR}/internal-ca.crt (run: $0 init)" >&2
    failures=$((failures + 1))
  elif ! internal_ca_constraints_ok; then
    echo "error: the internal CA's name constraints do not limit it to exactly ${INTERNAL_TLS_SERVICES[*]} (subdomains permitted); run: $0 init" >&2
    failures=$((failures + 1))
  else
    for service in "${INTERNAL_TLS_SERVICES[@]}"; do
      file="${INTERNAL_TLS_DIR}/${service}/tls.pem"
      if [[ "$(stat -c '%a' "${INTERNAL_TLS_DIR}/${service}" 2>/dev/null)" != "711" ]]; then
        echo "error: ${INTERNAL_TLS_DIR}/${service} missing or not mode 711 (run: $0 init)" >&2
        failures=$((failures + 1))
      elif [[ ! -s "$file" ]]; then
        echo "error: required internal TLS file missing or empty: ${file} (run: $0 init)" >&2
        failures=$((failures + 1))
      elif ! internal_certificate_ok "$service" 0; then
        echo "error: the ${service} certificate does not verify for the name ${service} against the internal CA, or has expired; run: $0 issue-internal-certificate ${service}" >&2
        failures=$((failures + 1))
      elif [[ "$(openssl x509 -noout -pubkey -in "$file" | openssl sha256)" != \
              "$(openssl pkey -pubout -in "$file" | openssl sha256)" ]]; then
        echo "error: the ${service} key does not match its certificate" >&2
        failures=$((failures + 1))
      fi
    done
  fi

  # Identity-provider hop (ADR 0007): Keycloak's certificate verifies for the
  # name keycloak against its own CA, is unexpired, and matches its key; the
  # CA permits exactly that name.
  if [[ ! -f "${PKI_DIR}/idp-ca.crt" ]]; then
    echo "error: identity-provider CA certificate missing: ${PKI_DIR}/idp-ca.crt (run: $0 init)" >&2
    failures=$((failures + 1))
  elif ! idp_ca_constraints_ok; then
    echo "error: the identity-provider CA's name constraints do not limit it to exactly ${IDP_TLS_NAME}; run: $0 init" >&2
    failures=$((failures + 1))
  elif [[ "$(stat -c '%a' "$IDP_TLS_DIR" 2>/dev/null)" != "711" ]]; then
    echo "error: ${IDP_TLS_DIR} missing or not mode 711 (run: $0 init)" >&2
    failures=$((failures + 1))
  elif [[ ! -s "$IDP_TLS_FILE" ]]; then
    echo "error: required identity-provider TLS file missing or empty: ${IDP_TLS_FILE} (run: $0 init)" >&2
    failures=$((failures + 1))
  elif ! keycloak_certificate_ok 0; then
    echo "error: the Keycloak certificate does not verify for the name ${IDP_TLS_NAME} against the identity-provider CA, or has expired; run: $0 issue-keycloak-certificate" >&2
    failures=$((failures + 1))
  elif [[ "$(openssl x509 -noout -pubkey -in "$IDP_TLS_FILE" | openssl sha256)" != \
          "$(openssl pkey -pubout -in "$IDP_TLS_FILE" | openssl sha256)" ]]; then
    echo "error: the Keycloak key does not match its certificate" >&2
    failures=$((failures + 1))
  fi

  # Keycloak must serve only HTTPS from that file; a configuration from an
  # older init (http-enabled=true) is refused rather than started.
  if [[ -s "${SECRETS_DIR}/keycloak.conf" ]] &&
     ! { grep -qx 'http-enabled=false' "${SECRETS_DIR}/keycloak.conf" &&
         grep -qx 'https-certificate-file=/run/keycloak-tls/tls.pem' "${SECRETS_DIR}/keycloak.conf" &&
         grep -qx 'http-management-host=127.0.0.1' "${SECRETS_DIR}/keycloak.conf" &&
         ! grep -q '^http-enabled=true' "${SECRETS_DIR}/keycloak.conf"; }; then
    echo "error: keycloak.conf does not restrict Keycloak to HTTPS (ADR 0007); run: $0 init" >&2
    failures=$((failures + 1))
  fi

  # Every internal connection URL requests verified TLS; a plaintext or
  # unverified URL (for example from an older init) is refused here rather
  # than discovered at runtime.
  local url_file
  for url_file in postgres-migrator-url api-database-url worker-database-url; do
    if [[ -s "${SECRETS_DIR}/${url_file}" ]] &&
       ! grep -qE '^postgres://[^?]*@postgres:5432/[^?]+\?sslmode=verify-full&sslrootcert=/internal-ca/ca\.crt$' "${SECRETS_DIR}/${url_file}"; then
      echo "error: ${url_file} does not require verified TLS (sslmode=verify-full with the internal CA); run: $0 init" >&2
      failures=$((failures + 1))
    fi
  done
  for url_file in api-rabbitmq-url worker-rabbitmq-url; do
    if [[ -s "${SECRETS_DIR}/${url_file}" ]] &&
       ! grep -qE '^amqps://[^?]*@rabbitmq:5671/[^?]+\?cacertfile=/internal-ca/ca\.crt$' "${SECRETS_DIR}/${url_file}"; then
      echo "error: ${url_file} does not require verified TLS (amqps with the internal CA); run: $0 init" >&2
      failures=$((failures + 1))
    fi
  done

  if [[ "$failures" -ne 0 ]]; then
    echo "Security lab secret check failed (${failures} problem(s))." >&2
    return 1
  fi

  echo "Security lab secrets present; ingress certificate valid until $(
    openssl x509 -noout -enddate -in "$INGRESS_TLS_FILE" | cut -d= -f2
  )."
  for service in "${INTERNAL_TLS_SERVICES[@]}"; do
    echo "Internal ${service} certificate valid until $(
      openssl x509 -noout -enddate -in "${INTERNAL_TLS_DIR}/${service}/tls.pem" | cut -d= -f2
    )."
  done
  echo "Keycloak certificate valid until $(openssl x509 -noout -enddate -in "$IDP_TLS_FILE" | cut -d= -f2)."
}

show_ca_certificate() {
  [[ -f "${PKI_DIR}/ca.crt" ]] || die "lab CA missing; run: $0 init"

  echo "Lab CA certificate (public; safe to copy):"
  echo "  WSL path:     ${PKI_DIR}/ca.crt"
  if command -v wslpath >/dev/null 2>&1; then
    echo "  Windows path: $(wslpath -w "${PKI_DIR}/ca.crt")"
  fi
  echo "  Subject:      $(openssl x509 -noout -subject -in "${PKI_DIR}/ca.crt" | cut -d= -f2-)"
  echo "  SHA-256:      $(openssl x509 -noout -fingerprint -sha256 -in "${PKI_DIR}/ca.crt" | cut -d= -f2)"
  echo "  SHA-1:        $(openssl x509 -noout -fingerprint -sha1 -in "${PKI_DIR}/ca.crt" | cut -d= -f2)"
  echo "  Valid until:  $(openssl x509 -noout -enddate -in "${PKI_DIR}/ca.crt" | cut -d= -f2)"
  echo "The CA private key never leaves ${PKI_DIR}."
  echo "The internal CA (${PKI_DIR}/internal-ca.crt) and the identity-provider CA"
  echo "(${PKI_DIR}/idp-ca.crt) are for service-to-service TLS inside the lab only;"
  echo "browsers and Windows do not need them."
}

# ---------------------------------------------------------------------------
# Lifecycle
# ---------------------------------------------------------------------------

start_lab() {
  check_secrets

  compose --profile tools build

  # Recreate containers so every file mount refers to the current secret
  # files; a container created before a file was replaced would keep the old
  # inode or fail to start. Volumes are kept.
  compose up -d --wait --force-recreate postgres rabbitmq keycloak-postgres keycloak valkey

  # The init script runs only on an empty volume; re-apply identities so the
  # secret files remain authoritative.
  compose exec -T postgres /docker-entrypoint-initdb.d/001-security-lab-roles.sh
  compose run --rm migrate

  # oauth2-proxy discovers the issuer through the ingress, so it starts last.
  compose up -d --wait --force-recreate api worker ingress
  compose up -d --wait --force-recreate oauth2-proxy

  # Read-only check of the machine client's permissions; describes only what
  # it observes and points to verify-realm for the realm itself.
  client_credentials_response | check_machine_permissions

  echo
  echo "Security lab running: ${APP_URL}/"
  echo "Sign in as lab-user; show the password path with: $0 lab-user"
}

show_lab_user() {
  [[ -s "${SECRETS_DIR}/lab-user-password" ]] || die "lab user password missing; run: $0 init"
  local user role
  for user in lab-user lab-viewer lab-outsider; do
    case "$user" in
      lab-user) role="editor: read, create, process" ;;
      lab-viewer) role="viewer: read" ;;
      lab-outsider) role="no Work Items permission" ;;
    esac
    printf '%-13s %-32s password file: %s\n' "$user" "($role)" "${SECRETS_DIR}/${user}-password"
  done
  echo "Passwords are not printed; read the file when signing in."
}

issue_certificate_command() {
  require_owned_state
  [[ -d "$INGRESS_TLS_DIR" ]] || die "ingress TLS directory missing; run: $0 init"

  issue_certificate

  local expected served=""
  expected="$(certificate_serial "$INGRESS_TLS_FILE")"

  if [[ -z "$(compose ps -q --status running ingress 2>/dev/null)" ]]; then
    echo "Issued serial ${expected}; the ingress is not running."
    return 0
  fi

  compose exec -T ingress nginx -s reload

  # Reload is asynchronous: nginx starts the new worker before the old one
  # stops accepting, so for about a second new connections can still receive
  # the old certificate. Require consecutive new connections with the new
  # serial rather than the first match.
  local _ consecutive=0
  for _ in $(seq 1 60); do
    served="$(served_serial)"
    if [[ "$served" == "$expected" ]]; then
      consecutive=$((consecutive + 1))
      [[ "$consecutive" -ge 5 ]] && break
    else
      consecutive=0
    fi
    sleep 0.25
  done

  if [[ "$consecutive" -lt 5 ]]; then
    die "the ingress still serves serial ${served:-unknown}, expected ${expected}"
  fi

  echo "Ingress reloaded; ${consecutive} consecutive new connections were served serial ${served}."
}

# Renew the ingress certificate on a running lab and confirm that the
# container sees the new file and new connections receive the new serial.
verify_renewal() {
  local evidence_file=""

  if [[ "${1:-}" == "--evidence" ]]; then
    evidence_file="${2:?--evidence requires a file}"
  fi

  [[ -n "$(compose ps -q --status running ingress 2>/dev/null)" ]] ||
    die "the ingress is not running; run: $0 start"

  local before_served before_file after_served after_file host_digest container_digest

  before_served="$(served_serial)"
  before_file="$(certificate_serial "$INGRESS_TLS_FILE")"

  issue_certificate_command >/dev/null

  after_served="$(served_serial)"
  after_file="$(certificate_serial "$INGRESS_TLS_FILE")"
  host_digest="$(sha256sum "$INGRESS_TLS_FILE" | cut -d' ' -f1)"
  container_digest="$(compose exec -T ingress sha256sum /run/ingress-tls/tls.pem | cut -d' ' -f1)"

  # Control: reproduce the failure this mount layout avoids. A single-file
  # bind mount keeps the original inode after the host file is replaced.
  local control_dir control_view single_file_mount
  control_dir="$(mktemp -d)"
  printf 'original\n' > "${control_dir}/file"
  docker run -d --rm --name "${PROJECT}-mount-control" --network none \
    -v "${control_dir}/file:/control/file:ro" "$PROBE_IMAGE" sleep 30 >/dev/null
  printf 'replacement\n' > "${control_dir}/file.new"
  mv -f "${control_dir}/file.new" "${control_dir}/file"
  control_view="$(docker exec "${PROJECT}-mount-control" cat /control/file)"
  docker rm -fv "${PROJECT}-mount-control" >/dev/null 2>&1 || true
  rm -rf -- "$control_dir"
  if [[ "$control_view" == original ]]; then
    single_file_mount=stale
  else
    single_file_mount=updated
  fi

  local result=fail
  if [[ -n "$before_served" && "$before_served" == "$before_file" &&
        "$after_file" != "$before_file" && "$after_served" == "$after_file" &&
        "$container_digest" == "$host_digest" && "$single_file_mount" == stale ]]; then
    result=pass
  fi

  printf '%s certificate renewal: served %s -> %s; file %s -> %s; container file %s host file; single-file mount control: %s\n' \
    "$(tr '[:lower:]' '[:upper:]' <<< "$result")" \
    "$before_served" "$after_served" "$before_file" "$after_file" \
    "$([[ "$container_digest" == "$host_digest" ]] && echo matches || echo differs from)" \
    "$single_file_mount"

  if [[ -n "$evidence_file" ]]; then
    cat > "$evidence_file" <<EOF_EVIDENCE
{
  "project": "${PROJECT}",
  "recorded_at": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "mount": "directory bind mount <state>/ingress-tls -> /run/ingress-tls (read-only)",
  "before": { "served_serial": "${before_served}", "file_serial": "${before_file}" },
  "after": { "served_serial": "${after_served}", "file_serial": "${after_file}" },
  "container_file_matches_host_file": $([[ "$container_digest" == "$host_digest" ]] && echo true || echo false),
  "control_single_file_bind_mount_after_replacement": "${single_file_mount}",
  "result": "${result}"
}
EOF_EVIDENCE
    echo "Evidence written: ${evidence_file}"
  fi

  [[ "$result" == pass ]]
}

# ---------------------------------------------------------------------------
# Internal TLS (ADR 0006)
# ---------------------------------------------------------------------------

INTERNAL_PROBE="${PROJECT}-tls-probe"

is_internal_tls_service() {
  local service
  for service in "${INTERNAL_TLS_SERVICES[@]}"; do
    [[ "$1" == "$service" ]] && return 0
  done
  return 1
}

# Make a running service use its current tls.pem for new connections.
# Established connections keep the session they negotiated.
reload_internal_tls() {
  case "$1" in
    postgres)
      compose exec -T -u root postgres /opt/zero-to-prod/tls.sh
      compose exec -T -u postgres postgres pg_ctl reload >/dev/null
      ;;
    rabbitmq)
      # The Erlang TLS stack caches PEM files; clearing the cache makes the
      # next handshake read the replaced file.
      compose exec -T rabbitmq rabbitmqctl -q eval 'ssl:clear_pem_cache().' >/dev/null
      ;;
  esac
}

# A TLS client on the data network for observing new connections. It holds
# no secret: only the internal CA certificate is mounted.
start_internal_probe() {
  docker rm -fv "$INTERNAL_PROBE" >/dev/null 2>&1 || true
  docker run -d --rm --name "$INTERNAL_PROBE" --network "${PROJECT}_data" \
    --cap-drop ALL --security-opt no-new-privileges:true --read-only --user 999:999 \
    -v "${PKI_DIR}/internal-ca.crt:/internal-ca/ca.crt:ro" \
    --entrypoint sleep "$RABBITMQ_IMAGE" infinity >/dev/null
}

stop_internal_probe() {
  docker rm -fv "$INTERNAL_PROBE" >/dev/null 2>&1 || true
}

# "<verify code> <served serial>" for one new TLS connection from the probe
# container $1 to $2:$3, verifying the name $2 against the CA file $4 (a path
# in the probe); $5: extra s_client options. OpenSSL completes the handshake
# despite a verification failure, so the served certificate's serial is
# known either way.
tls_probe() {
  docker exec "$1" sh -c '
    out="$(/opt/openssl/bin/openssl s_client -connect "$1:$2" -servername "$1" -verify_hostname "$1" \
      -CAfile "$3" $4 </dev/null 2>&1)"
    code="$(printf "%s\n" "$out" | sed -n "s/^ *Verify return code: \([0-9]*\).*/\1/p" | tail -n 1)"
    serial="$(printf "%s\n" "$out" | /opt/openssl/bin/openssl x509 -noout -serial 2>/dev/null | cut -d= -f2)"
    echo "${code:-none} ${serial:-none}"' probe "$2" "$3" "$4" "${5:-}"
}

# The same for an internal service, verified against the internal CA.
internal_tls_probe() {
  local service="$1" port starttls=""
  case "$service" in
    postgres) port=5432; starttls="-starttls postgres" ;;
    rabbitmq) port=5671 ;;
  esac
  tls_probe "$INTERNAL_PROBE" "$service" "$port" /internal-ca/ca.crt "$starttls"
}

# Run "$@" up to $3 times, $4 seconds apart, until $2 consecutive outputs
# equal $1. On success print the matching output. Otherwise fail and print
# "timeout: …" with the streak at the end and the last output, which can
# never equal $1, so a caller comparing outputs cannot mistake a timeout for
# success. One match at the end, or matches interrupted by other outputs,
# are not enough.
await_observation_streak() {
  local expected="$1" required="$2" attempts="$3" delay="$4" observed="" consecutive=0 attempt
  shift 4
  for (( attempt = 1; attempt <= attempts; attempt++ )); do
    observed="$("$@")" || observed="error"
    if [[ "$observed" == "$expected" ]]; then
      consecutive=$((consecutive + 1))
      if (( consecutive >= required )); then
        echo "$observed"
        return 0
      fi
    else
      consecutive=0
    fi
    if (( attempt < attempts )); then sleep "$delay"; fi
  done
  echo "timeout: ${consecutive} of ${required} consecutive '${expected}' after ${attempts} attempts; last '${observed:-none}'"
  return 1
}

# Wait until five consecutive new connections to the service show the
# expected observation, "<verify code> <serial>" (reloads are asynchronous,
# as for the ingress). The code is part of the match: renewal needs five
# verified (0) connections with the new serial; a failure case needs five
# with its own nonzero code and the bad serial. Prints the matching
# observation, or fails with a "timeout: …" line.
wait_for_internal_serial() {
  await_observation_streak "$2" 5 60 0.25 internal_tls_probe "$1"
}

# Reads one observation per line from standard input; "none none" at its end.
read_observation() {
  local line
  IFS= read -r line || line="none none"
  echo "$line"
}

issue_internal_certificate_command() {
  local service="${1:-}" expected observed
  is_internal_tls_service "$service" ||
    die "usage: $0 issue-internal-certificate <$(IFS='|'; echo "${INTERNAL_TLS_SERVICES[*]}")>"
  require_owned_state

  issue_internal_certificate "$service" valid
  expected="$(certificate_serial "${INTERNAL_TLS_DIR}/${service}/tls.pem")"

  if [[ -z "$(compose ps -q --status running "$service" 2>/dev/null)" ]]; then
    echo "Issued ${service} serial ${expected}; ${service} is not running."
    return 0
  fi

  reload_internal_tls "$service"
  start_internal_probe
  if ! observed="$(wait_for_internal_serial "$service" "0 ${expected}")"; then
    stop_internal_probe
    die "renewal of ${service} not confirmed: ${observed} (verify code, serial)"
  fi
  stop_internal_probe
  echo "${service} reloaded; five consecutive new connections verified serial ${expected}."
}

# libpq's verdict on one new connection to PostgreSQL as a role that does
# not exist, without a password: "fe_sendauth: no password supplied" means
# TLS and the server's identity were accepted and authentication began.
# $1: sslmode; $2: CA file to trust (default: the internal CA).
libpq_probe() {
  local sslmode="$1" ca="${2:-${PKI_DIR}/internal-ca.crt}" out
  out="$(docker run --rm --network "${PROJECT}_data" --cap-drop ALL \
    --security-opt no-new-privileges:true --user 70:70 -e HOME=/tmp \
    -v "${ca}:/probe-ca/ca.crt:ro" --entrypoint psql "$POSTGRES_IMAGE" -X -w \
    "host=postgres port=5432 dbname=${POSTGRES_DB} user=tls_probe sslmode=${sslmode} sslrootcert=/probe-ca/ca.crt connect_timeout=5" \
    -c 'SELECT 1' 2>&1 || true)"
  printf '%s\n' "$out" | tail -n 1 \
    | sed -E 's/.* failed: //; s/[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/<address>/g; s/[[:space:]]+/ /g; s/ $//'
}

pg_admin_query() {
  compose exec -T postgres psql -X -q -t -A -U zero_to_prod_admin -d "$POSTGRES_DB" -c "$1" 2>/dev/null
}

# Network client connections of each side, one per line: PostgreSQL backends
# as "<pid>:<user>:<ssl>:<version>", RabbitMQ connections as
# "<user>:<peer port>:<ssl>:<protocol>".
internal_connections() {
  case "$1" in
    postgres)
      pg_admin_query "SELECT a.pid || ':' || a.usename || ':' || s.ssl || ':' || coalesce(s.version, '-')
                      FROM pg_stat_activity a JOIN pg_stat_ssl s USING (pid)
                      WHERE a.backend_type = 'client backend' AND a.client_addr IS NOT NULL
                      ORDER BY a.pid"
      ;;
    rabbitmq)
      compose exec -T rabbitmq rabbitmqctl -q list_connections --no-table-headers \
        user peer_port ssl ssl_protocol 2>/dev/null | tr '\t' ':' | sort
      ;;
  esac
}

# Connection identities only (PostgreSQL pid, RabbitMQ user and peer port).
connection_ids() {
  case "$1" in
    postgres) cut -d: -f1,2 ;;
    rabbitmq) cut -d: -f1,2 ;;
  esac
}

# "kept" when every connection in $1 is still in $2; otherwise what was lost.
connections_kept() {
  local before="$1" after="$2" lost
  [[ -n "$before" ]] || { echo "none-before"; return 0; }
  lost="$(comm -23 <(sort <<< "$before") <(sort <<< "$after") | tr '\n' ' ')"
  if [[ -z "$lost" ]]; then echo kept; else echo "lost: ${lost% }"; fi
}

# Count of lines in $2 that are not in $1.
new_connection_count() {
  comm -13 <(sort <<< "$1") <(sort <<< "$2") | grep -c . || true
}

# Create a Work Item as the editor and process it. Prints the job's final
# state, or the step that failed.
tls_flow() {
  local jar="$1" label="$2" out item job
  out="$(api_call session "$jar" POST /items "{\"title\":\"${label}\"}")"
  [[ "${out%% *}" == 201 ]] || { echo "create:${out%% *}"; return 0; }
  item="$(json_field id <<< "${out#* }")"
  job="$(start_processing session "$jar" POST "/items/${item}/process" || true)"
  [[ -n "$job" ]] || { echo "process:not-accepted"; return 0; }
  wait_job_state session "$jar" "$job"
}

# The Go TLS verification error in a service's log since $2.
go_tls_reason() {
  { compose logs --no-log-prefix --since "$2" "$1" 2>/dev/null \
      | grep -oE 'x509: (certificate (signed by unknown authority|is valid for [a-z0-9.-]+, not [a-z0-9.-]+|has expired or is not yet valid)|a root or intermediate certificate is not authorized to sign for this name: DNS name "[a-z0-9.-]+" is excluded by constraint "[a-z0-9.-]+")' \
      || true; } | sort -u | paste -sd ';' -
}

# The server's own record of rejected handshakes since $2 (empty when the
# client sent no alert the server logged).
server_tls_log() {
  case "$1" in
    postgres)
      { compose logs --no-log-prefix --since "$2" postgres 2>/dev/null \
          | grep -oE 'could not accept SSL connection: .*' || true; } \
        | sed 's/[[:space:]]*$//' | sort -u | paste -sd ';' -
      ;;
    rabbitmq)
      { compose logs --no-log-prefix --since "$2" rabbitmq 2>/dev/null \
          | grep -oE 'received CLIENT ALERT: [A-Za-z -]+' || true; } \
        | sed 's/[[:space:]]*$//' | sort -u | paste -sd ';' -
      ;;
  esac
}

wait_for_worker_connection() {
  local _
  for _ in $(seq 1 60); do
    internal_connections rabbitmq | grep -q '^zero_to_prod_worker:' && { echo present; return 0; }
    sleep 1
  done
  echo absent
}

# Expected client-side outcomes per certificate kind.
expected_openssl_code() {
  case "$1" in
    untrusted) echo 21 ;;  # unable to verify the first certificate
    mismatch) echo 62 ;;   # hostname mismatch
    expired) echo 10 ;;    # certificate has expired
    subdomain) echo 48 ;;  # excluded subtree violation
  esac
}

expected_go_reason() {
  case "$1" in
    untrusted) echo "x509: certificate signed by unknown authority" ;;
    mismatch) echo "x509: certificate is valid for ${3}, not ${2}" ;;
    expired) echo "x509: certificate has expired or is not yet valid" ;;
    # Go 1.27's wording (the API and worker images build with it).
    subdomain) echo "x509: a root or intermediate certificate is not authorized to sign for this name: DNS name \"extra.${2}\" is excluded by constraint \".${2}\"" ;;
  esac
}

expected_libpq_error() {
  case "$1" in
    mismatch) echo "server certificate for \"rabbitmq\" does not match host name \"postgres\"" ;;
    *) echo "SSL error: certificate verify failed" ;;
  esac
}

# One failure case: install a bad certificate on one service, observe new
# and established connections, then renew with a valid certificate and
# observe recovery without restarting the clients again.
internal_tls_failure_case() {
  local target="$1" kind="$2" jar="$3" rogue="$4"
  local area="${target}: ${kind}" before after bad_serial good_serial observed since other
  other="$( [[ "$target" == postgres ]] && echo rabbitmq || echo postgres )"

  before="$(internal_connections "$target" | connection_ids "$target")"
  issue_internal_certificate "$target" "$kind" "$rogue"
  bad_serial="$(certificate_serial "${INTERNAL_TLS_DIR}/${target}/tls.pem")"
  reload_internal_tls "$target"

  expect "$area" "new connection: openssl verify code, served serial" \
    "$(expected_openssl_code "$kind") ${bad_serial}" \
    "$(wait_for_internal_serial "$target" "$(expected_openssl_code "$kind") ${bad_serial}")"

  if [[ "$target" == postgres ]]; then
    since="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    expect "$area" "new connection: libpq sslmode=verify-full" "$(expected_libpq_error "$kind")" \
      "$(libpq_probe verify-full)"
    sleep 1
    observed="$(server_tls_log postgres "$since")"
    record "$area" "server log: libpq handshake" "observe" "${observed:-none}" info
  fi

  # Established connections: negotiated before the change, unaffected by it.
  # A request that succeeds now cannot have used a new connection to the
  # target, because every new connection fails.
  after="$(internal_connections "$target" | connection_ids "$target")"
  expect "$area" "established connections after the change" "kept" "$(connections_kept "$before" "$after")"
  local flow_before flow_after
  flow_before="$(internal_connections "$target" | connection_ids "$target")"
  expect "$area" "established: create and process" "succeeded" "$(tls_flow "$jar" "tls ${target} ${kind} established")"
  flow_after="$(internal_connections "$target" | connection_ids "$target")"
  record "$area" "established: new ${target} connections during the flow" "observe" \
    "$(new_connection_count "$flow_before" "$flow_after")" info

  # New connections from the workload itself.
  local pending_job="" out
  since="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  if [[ "$target" == postgres ]]; then
    compose restart api >/dev/null 2>&1
    compose up -d --wait --no-recreate api >/dev/null 2>&1 || die "the API did not become healthy after restart"
    observed="$(call_summary session "$jar" GET /items)"
    expect "$area" "restarted API: GET /api/items" "503" "${observed%% *}"
    sleep 1
    expect "$area" "restarted API: Go TLS error" "$(expected_go_reason "$kind" postgres "$other")" \
      "$(go_tls_reason api "$since")"
  else
    compose restart worker >/dev/null 2>&1
    sleep 5
    expect "$area" "restarted worker: Go TLS error" "$(expected_go_reason "$kind" rabbitmq "$other")" \
      "$(go_tls_reason worker "$since")"
    expect "$area" "restarted worker: broker connection" "absent" \
      "$(internal_connections rabbitmq | grep -q '^zero_to_prod_worker:' && echo present || echo absent)"
    # Published through the API's established connection, but nobody can
    # consume it.
    out="$(api_call session "$jar" POST /items "{\"title\":\"tls rabbitmq ${kind} pending\"}")"
    pending_job="$(start_processing session "$jar" POST "/items/$(json_field id <<< "${out#* }")/process" || true)"
    sleep 5
    expect "$area" "job while no worker can connect" "accepted" \
      "$(json_field state <<< "$(api_call session "$jar" GET "/processing-jobs/${pending_job}" | cut -d' ' -f2-)")"
  fi
  observed="$(server_tls_log "$target" "$since")"
  record "$area" "server log: workload handshakes" "observe" "${observed:-none}" info

  # Recovery: renew with a valid certificate; clients are not restarted.
  issue_internal_certificate "$target" valid
  good_serial="$(certificate_serial "${INTERNAL_TLS_DIR}/${target}/tls.pem")"
  reload_internal_tls "$target"
  expect "$area" "renewed: openssl verify code, served serial" "0 ${good_serial}" \
    "$(wait_for_internal_serial "$target" "0 ${good_serial}")"
  if [[ "$target" == postgres ]]; then
    expect "$area" "renewed: same API process, GET /api/items" "200" "$(call_summary session "$jar" GET /items)"
  else
    expect "$area" "renewed: worker reconnects by itself" "present" "$(wait_for_worker_connection)"
    expect "$area" "renewed: pending job completes" "succeeded" "$(wait_job_state session "$jar" "$pending_job")"
  fi
  expect "$area" "renewed: create and process" "succeeded" "$(tls_flow "$jar" "tls ${target} ${kind} recovered")"
}

# Renewal with a valid certificate: new connections get the new serial,
# established ones continue.
internal_tls_renewal_case() {
  local target="$1" jar="$2" area="${1}: renewal" before after old_serial new_serial
  before="$(internal_connections "$target" | connection_ids "$target")"
  old_serial="$(internal_tls_probe "$target")"
  issue_internal_certificate "$target" valid
  new_serial="$(certificate_serial "${INTERNAL_TLS_DIR}/${target}/tls.pem")"
  reload_internal_tls "$target"
  record "$area" "before: openssl verify code, served serial" "observe" "$old_serial" info
  expect "$area" "after: openssl verify code, served serial" "0 ${new_serial}" \
    "$(wait_for_internal_serial "$target" "0 ${new_serial}")"
  expect "$area" "served serial changed" "changed" \
    "$([[ "${old_serial#* }" != "$new_serial" ]] && echo changed || echo unchanged)"
  after="$(internal_connections "$target" | connection_ids "$target")"
  expect "$area" "established connections after renewal" "kept" "$(connections_kept "$before" "$after")"
  expect "$area" "create and process" "succeeded" "$(tls_flow "$jar" "tls ${target} renewal")"
}

# Containers of this project, their networks, and whether their first
# process could capture or forge traffic (CAP_NET_RAW) now or after gaining
# root (bounding set).
internal_network_inventory() {
  local area="network inventory" service id status networks uid eff bnd nnp
  for service in "${LAB_SERVICES[@]}"; do
    id="$(compose ps -q "$service")"
    [[ -n "$id" ]] || continue
    networks="$(docker inspect --format '{{range $name, $_ := .NetworkSettings.Networks}}{{$name}} {{end}}' "$id" \
      | tr ' ' '\n' | sed "s/^${PROJECT}_//" | grep . | sort | paste -sd, -)"
    nnp="$(docker inspect --format '{{range .HostConfig.SecurityOpt}}{{.}} {{end}}' "$id" | grep -q 'no-new-privileges' && echo yes || echo no)"
    status="$(docker exec "$id" cat /proc/1/status 2>/dev/null || true)"
    if grep -q '^CapEff:' <<< "$status"; then
      uid="$(awk '/^Uid:/ {print $2}' <<< "$status")"
      eff="$(awk '/^CapEff:/ {print $2}' <<< "$status")"
      bnd="$(awk '/^CapBnd:/ {print $2}' <<< "$status")"
      record "$area" "$service" "observe" \
        "networks=${networks} pid1_uid=${uid} net_raw_effective=$(( (16#${eff} >> 13) & 1 )) net_raw_bounding=$(( (16#${bnd} >> 13) & 1 )) no_new_privileges=${nnp}" info
    else
      # No cat in the image (distroless): report the configuration instead.
      record "$area" "$service" "observe" \
        "networks=${networks} user=$(docker inspect --format '{{.Config.User}}' "$id") cap_drop=$(docker inspect --format '{{range .HostConfig.CapDrop}}{{.}} {{end}}' "$id" | xargs | tr ' ' ,) no_new_privileges=${nnp} (no /proc reader in the image)" info
    fi
  done
  record "$area" "migrate (on demand)" "observe" \
    "$(compose --profile tools config --format json 2>/dev/null | python3 -I -c '
import json, sys
s = json.load(sys.stdin)["services"]["migrate"]
print("networks=" + ",".join(sorted(s.get("networks", {}))) + " user=" + (s.get("user") or "image-default") +
      " cap_drop=" + (",".join(s.get("cap_drop", [])) or "none") +
      " no_new_privileges=" + ("yes" if any("no-new-privileges" in o for o in s.get("security_opt", [])) else "no"))
')" info
}

verify_internal_tls() {
  local evidence_file="" started service
  [[ "${1:-}" == "--evidence" ]] && evidence_file="${2:?--evidence requires a file}"
  require_command python3
  require_owned_state
  for service in postgres rabbitmq api worker oauth2-proxy; do
    [[ -n "$(compose ps -q --status running "$service" 2>/dev/null)" ]] || die "${service} is not running; run: $0 start"
  done
  openssl x509 -help 2>&1 | grep -q -- '-not_after' ||
    die "openssl $(openssl version | cut -d' ' -f2) cannot issue the expired test certificate (-not_after needs 3.4 or later)"

  RESULTS=(); FAILED=0
  AUTH_WORK="$(mktemp -d)"
  TLS_ROGUE_DIR="$(mktemp -d)"
  local rogue="$TLS_ROGUE_DIR"
  # Always leave valid certificates, the probe removed, and the untrusted
  # CA's key deleted, also after a failure.
  trap '
    stop_internal_probe
    for tls_service in "${INTERNAL_TLS_SERVICES[@]}"; do
      if ! internal_certificate_ok "$tls_service" 0; then
        issue_internal_certificate "$tls_service" valid
      fi
      reload_internal_tls "$tls_service" >/dev/null 2>&1 || true
    done
    compose up -d --no-recreate api worker >/dev/null 2>&1 || true
    rm -rf -- "$AUTH_WORK" "$TLS_ROGUE_DIR"
  ' EXIT
  set_ui_headers
  started="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  wait_for_issuer || die "the issuer is not reachable: ${ISSUER}"

  # A CA the clients do not trust, for the untrusted-issuer cases; its key
  # exists only in a temporary directory for the duration of the run.
  (
    umask 077
    openssl req -x509 -new -newkey ec -pkeyopt ec_paramgen_curve:P-256 -noenc \
      -keyout "${rogue}/ca.key" -out "${rogue}/ca.crt" -days 1 \
      -subj "/CN=Untrusted test CA (verify-internal-tls)" \
      -addext "basicConstraints=critical,CA:TRUE,pathlen:0" \
      -addext "keyUsage=critical,keyCertSign" 2>/dev/null
  )

  local editor="${AUTH_WORK}/editor"
  browser_login "$editor" lab-user >/dev/null

  internal_network_inventory
  start_internal_probe

  # --- Baseline -------------------------------------------------------------
  local area="baseline" plaintext
  for service in "${INTERNAL_TLS_SERVICES[@]}"; do
    expect "$area" "${service}: openssl verify code, served serial" \
      "0 $(certificate_serial "${INTERNAL_TLS_DIR}/${service}/tls.pem")" \
      "$(wait_for_internal_serial "$service" "0 $(certificate_serial "${INTERNAL_TLS_DIR}/${service}/tls.pem")")"
  done
  expect "$area" "postgres: libpq verify-full, internal CA (TLS accepted; authentication begins)" \
    "fe_sendauth: no password supplied" "$(libpq_probe verify-full)"
  expect "$area" "postgres: libpq verify-full, lab CA instead of internal CA" \
    "SSL error: certificate verify failed" "$(libpq_probe verify-full "${PKI_DIR}/ca.crt")"
  expect "$area" "postgres: libpq sslmode=disable (plaintext)" \
    'FATAL: pg_hba.conf rejects connection for host "<address>", user "tls_probe", database "zero_to_prod", no encryption' \
    "$(libpq_probe disable)"
  expect "$area" "rabbitmq: plaintext AMQP port 5672" "refused connects=0 exit=7" \
    "$(probe_tcp_detail "${PROJECT}_data" "rabbitmq:5672")"
  expect "$area" "create and process" "succeeded" "$(tls_flow "$editor" "tls baseline")"
  for service in "${INTERNAL_TLS_SERVICES[@]}"; do
    record "$area" "${service}: client connections" "observe" \
      "$(internal_connections "$service" | cut -d: -f2- | sort | uniq -c | sed 's/^ *//' | paste -sd ';' -)" info
  done
  plaintext="$(internal_connections postgres | grep -vc ':true:' || true)"
  expect "$area" "postgres: network client backends without TLS" "0" "$plaintext"
  plaintext="$(internal_connections rabbitmq | grep -vc ':true:' || true)"
  expect "$area" "rabbitmq: connections without TLS" "0" "$plaintext"

  # --- Failure cases and recovery ------------------------------------------
  local kind
  for service in "${INTERNAL_TLS_SERVICES[@]}"; do
    # subdomain: the certificate names the right server, so only the CA's
    # exclusion of "extra.<service>" can make the clients refuse it.
    for kind in untrusted mismatch expired subdomain; do
      internal_tls_failure_case "$service" "$kind" "$editor" "$rogue"
    done
  done

  # --- Renewal --------------------------------------------------------------
  for service in "${INTERNAL_TLS_SERVICES[@]}"; do
    internal_tls_renewal_case "$service" "$editor"
  done

  area="final state"
  expect "$area" "check-secrets" "pass" "$(check_secrets >/dev/null 2>&1 && echo pass || echo fail)"

  # Nothing recorded may contain a secret value.
  local name joined
  joined="$(printf '%s\n' "${RESULTS[@]}")"
  for name in "${SOURCE_SECRETS[@]}"; do
    if grep -qFf <(secret "$name") <<< "$joined"; then
      die "a recorded result contains the value of ${name}; no evidence written"
    fi
  done
  record "$area" "secret values in recorded results" "observe" "none (${#SOURCE_SECRETS[@]} secrets searched)" info

  [[ -n "$evidence_file" ]] && write_auth_evidence "$evidence_file" "$started" \
    "verify-internal-tls: internal CA and TLS on the data network; baseline, plaintext refusal, untrusted issuer, hostname mismatch, expired certificate, and a certificate also naming an excluded subdomain on PostgreSQL and RabbitMQ with new versus established connections and recovery by renewal; renewal; network inventory. Scripted clients only."
  finish_checks "Internal TLS verification"
}

# ---------------------------------------------------------------------------
# Identity-provider hop: ingress → Keycloak over TLS (ADR 0007)
# ---------------------------------------------------------------------------

IDP_PROBE="${PROJECT}-idp-probe"
NGINX_CONTROL="${PROJECT}-nginx-control"
DISCOVERY_PATH=/realms/work-items/.well-known/openid-configuration
INGRESS_IMAGE=zero-to-prod-security-lab-ingress:local

# A TLS client on the idp network. It holds no secret: only the three CA
# certificates (public) are mounted, to show which of them verifies Keycloak.
# Probes are removed with -v: the RabbitMQ image declares a volume, and
# removing a --rm container explicitly leaves its anonymous volume otherwise.
start_idp_probe() {
  docker rm -fv "$IDP_PROBE" >/dev/null 2>&1 || true
  docker run -d --rm --name "$IDP_PROBE" --network "${PROJECT}_idp" \
    --cap-drop ALL --security-opt no-new-privileges:true --read-only --tmpfs /tmp --user 999:999 \
    -v "${PKI_DIR}/idp-ca.crt:/probe-ca/idp-ca.crt:ro" \
    -v "${PKI_DIR}/ca.crt:/probe-ca/lab-ca.crt:ro" \
    -v "${PKI_DIR}/internal-ca.crt:/probe-ca/internal-ca.crt:ro" \
    --entrypoint sleep "$RABBITMQ_IMAGE" infinity >/dev/null
}

stop_idp_probe() {
  docker rm -fv "$IDP_PROBE" >/dev/null 2>&1 || true
}

# "<verify code> <served serial>" for one new connection to Keycloak,
# verified for the name keycloak against the CA $1: idp (default), lab, or
# internal.
idp_tls_probe() {
  tls_probe "$IDP_PROBE" "$IDP_TLS_NAME" "$IDP_TLS_PORT" "/probe-ca/${1:-idp}-ca.crt"
}

idp_served_serial() {
  local observed
  observed="$(idp_tls_probe)"
  echo "${observed#* }"
}

# Keycloak rereads its certificate file every KEYCLOAK_TLS_RELOAD_SECONDS, so
# a replaced file is served from the next reload on. Wait until five
# consecutive new connections show the expected observation ($1) of the
# function $2: "<code> <serial>" (idp_tls_probe) or "<serial>"
# (idp_served_serial). Prints it, or fails with a "timeout: …" line.
wait_for_keycloak() {
  await_observation_streak "$1" 5 $(( KEYCLOAK_TLS_RELOAD_SECONDS * 2 + 30 )) 1 "$2"
}

issue_keycloak_certificate_command() {
  require_owned_state
  local expected observed

  issue_keycloak_certificate valid
  expected="$(certificate_serial "$IDP_TLS_FILE")"

  if [[ -z "$(compose ps -q --status running keycloak 2>/dev/null)" ]]; then
    echo "Issued Keycloak serial ${expected}; Keycloak is not running."
    return 0
  fi

  echo "Waiting for Keycloak to reread its certificate (every ${KEYCLOAK_TLS_RELOAD_SECONDS} s)..."
  start_idp_probe
  if ! observed="$(wait_for_keycloak "0 ${expected}" idp_tls_probe)"; then
    stop_idp_probe
    die "renewal of keycloak not confirmed: ${observed} (verify code, serial)"
  fi
  stop_idp_probe
  echo "Keycloak reloaded; five consecutive new connections verified serial ${expected}."
}

# Status of one request through the ingress's diagnostic route, which fetches
# issuer discovery from Keycloak with the production TLS settings.
keycloak_upstream_check() {
  { compose exec -T ingress wget -q -S -O /dev/null "http://127.0.0.1:8082/keycloak-upstream" 2>&1 || true; } \
    | grep -oE 'HTTP/1\.[01] [0-9]{3}' | tail -n 1 | cut -d' ' -f2
}

# nginx's upstream TLS verdicts in the log read on standard input.
nginx_upstream_tls_reason() {
  { grep -oE 'upstream SSL certificate (verify error: \([0-9]+:[^)]*\)|does not match "[^"]*")' || true; } \
    | sort -u | paste -sd ';' -
}

ingress_tls_reason_since() {
  compose logs --no-log-prefix --since "$1" ingress 2>/dev/null | nginx_upstream_tls_reason
}

# The ingress's upstream TLS error lines since $1, addresses replaced.
ingress_tls_lines_since() {
  { compose logs --no-log-prefix --since "$1" ingress 2>/dev/null | grep -F 'upstream SSL certificate' || true; } \
    | sed -E 's/^[0-9/]+ [0-9:]+ //; s/[0-9]+#[0-9]+: \*[0-9]+ /<worker> /; s/[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/<address>/g'
}

check_keycloak_upstream() {
  local since status
  since="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  status="$(keycloak_upstream_check)"
  sleep 1
  echo "Diagnostic request to Keycloak through the ingress: HTTP ${status:-none}"
  if [[ "$status" == 200 ]]; then
    echo "Keycloak's certificate verified for the name ${IDP_TLS_NAME}."
  else
    echo "Reason in the ingress log: $(ingress_tls_reason_since "$since")"
    echo "An empty reason means the failure was not a certificate verdict; see: $0 logs ingress"
  fi
  [[ "$status" == 200 ]]
}

# Status and error code of issuer discovery through the ingress.
discovery_summary() {
  local out error
  out="$(http_status_body "$@" "${ISSUER}/.well-known/openid-configuration")"
  error="$(json_field error <<< "${out#* }")"
  echo "${out%% *}${error:+ ${error}}"
}

# Issuer discovery as the public sees it: a digest of the canonical document,
# the issuer, and whether every endpoint lies below the issuer URL.
discovery_fingerprint() {
  http_status_body "$@" "${ISSUER}/.well-known/openid-configuration" | cut -d' ' -f2- | python3 -I -c '
import hashlib, json, sys
issuer = sys.argv[1]
try:
    d = json.loads(sys.stdin.read())
except Exception:
    print("unreadable"); sys.exit(0)
canonical = json.dumps(d, sort_keys=True, separators=(",", ":")).encode()
keys = ["authorization_endpoint", "token_endpoint", "userinfo_endpoint", "jwks_uri",
        "end_session_endpoint", "introspection_endpoint", "revocation_endpoint"]
under = "yes" if all(str(d.get(k, "")).startswith(issuer + "/") for k in keys) else "no"
digest = hashlib.sha256(canonical).hexdigest()[:16]
print("sha256=" + digest + " issuer=" + str(d.get("issuer")) + " endpoints_below_issuer=" + under)
' "$ISSUER"
}

# Status of a client-credentials token request through the ingress.
token_request_status() {
  curl_config user "work-items-automation:$(secret automation-client-secret)" \
    | http_status -K - -d grant_type=client_credentials "${ISSUER}/protocol/openid-connect/token"
}

# Status at the end of a new browser sign-in (200: Keycloak's login form).
new_sign_in_status() {
  http_status -L -c "$1" -b "$1" "${APP_URL}/oauth2/start?rd=%2F"
}

container_started_at() {
  docker inspect --format '{{.State.StartedAt}}' "$(compose ps -q "$1")" 2>/dev/null
}

# ESTABLISHED TCP connections in the container $1 to remote port $2.
established_to_port() {
  docker exec "$1" cat /proc/net/tcp /proc/net/tcp6 2>/dev/null \
    | awk -v port=":$(printf '%04X' "$2")" '$3 ~ port"$" && $4 == "01" {n++} END {print n + 0}'
}

# Keycloak's listening TCP sockets ("<address>:<port>", sorted).
keycloak_listeners() {
  compose exec -T keycloak cat /proc/net/tcp /proc/net/tcp6 2>/dev/null | python3 -I -c '
import ipaddress, sys
out = set()
for line in sys.stdin:
    f = line.split()
    if len(f) < 4 or f[3] != "0A" or ":" not in f[1]:
        continue
    addr, port = f[1].split(":")
    raw = bytes.fromhex(addr)
    # /proc prints each 32-bit word in host (little-endian) order.
    raw = b"".join(raw[i:i + 4][::-1] for i in range(0, len(raw), 4))
    ip = ipaddress.ip_address(raw)
    if ip.version == 6 and ip.ipv4_mapped:
        ip = ip.ipv4_mapped
    out.add(f"{ip}:{int(port, 16)}")
print(",".join(sorted(out, key=lambda s: (int(s.rsplit(":", 1)[1]), s))))
'
}

DISCOVERY_REQUEST="GET ${DISCOVERY_PATH} HTTP/1.1\r\nHost: ${AUTH_HOSTNAME}:${HTTPS_PORT}\r\n\r\n"

# An established connection: one TLS connection from the probe to Keycloak,
# opened now, with a first keep-alive request; later requests reuse it.
open_established_connection() {
  # Each background process leads its own session; a previous connection's
  # sessions are ended by their recorded IDs.
  docker exec "$IDP_PROBE" sh -c '
    if [ -f /tmp/est.pids ]; then
      for pid in $(cat /tmp/est.pids); do kill -- "-$pid" 2>/dev/null || true; done
    fi
    rm -f /tmp/est.in /tmp/est.out /tmp/est.pids
    mkfifo /tmp/est.in
    setsid sh -c "sleep 3600 > /tmp/est.in" </dev/null >/dev/null 2>&1 &
    echo "$!" >> /tmp/est.pids
    setsid /opt/openssl/bin/openssl s_client -connect keycloak:8443 -servername keycloak \
      -verify_hostname keycloak -CAfile /probe-ca/idp-ca.crt -ign_eof \
      < /tmp/est.in > /tmp/est.out 2>&1 &
    echo "$!" >> /tmp/est.pids
    sleep 2
    printf "$1" > /tmp/est.in
    sleep 1' probe "$DISCOVERY_REQUEST"
}

# Sends one more request on the established connection. Prints the last
# response status, the responses and handshakes seen on it, and the verify
# code of its only handshake.
established_request() {
  docker exec "$IDP_PROBE" sh -c '
    printf "$1" > /tmp/est.in
    sleep 1
    # s_client prints the session-ticket dump without a final newline, so a
    # status line need not start a line.
    status="$(grep -aoE "HTTP/1\.1 [0-9]{3}" /tmp/est.out | tail -n 1 | cut -d" " -f2)"
    echo "${status:-none} responses=$(grep -aoE "HTTP/1\.1 [0-9]{3}" /tmp/est.out | wc -l) handshakes=$(grep -c "^CONNECTED(" /tmp/est.out) verify=$(sed -n "s/^ *Verify return code: \([0-9]*\).*/\1/p" /tmp/est.out | paste -sd, -)"' \
    probe "$DISCOVERY_REQUEST"
}

# Saves the TLS session of a new, verified connection (-sess_out). The
# request is written a second after the connection starts: written at once,
# it got no response in this setup.
save_idp_session() {
  docker exec "$IDP_PROBE" sh -c '
    rm -f /tmp/idp.sess
    (sleep 1; printf "GET $2 HTTP/1.0\r\nHost: $3\r\n\r\n"; sleep 1) | /opt/openssl/bin/openssl s_client \
      -connect keycloak:8443 -servername keycloak -verify_hostname keycloak -CAfile /probe-ca/idp-ca.crt \
      -sess_out /tmp/idp.sess -ign_eof >/dev/null 2>&1
    [ -s /tmp/idp.sess ] && echo saved || echo none' probe x "$DISCOVERY_PATH" "${AUTH_HOSTNAME}:${HTTPS_PORT}"
}

# Offers the saved session on a new connection. Prints "<New|Reused>
# verify=<code> status=<HTTP status>": a resumed session is not re-verified,
# because no certificate is sent.
resume_idp_session() {
  docker exec "$IDP_PROBE" sh -c '
    out="$( (sleep 1; printf "GET $2 HTTP/1.0\r\nHost: $3\r\n\r\n"; sleep 1) | /opt/openssl/bin/openssl s_client \
      -connect keycloak:8443 -servername keycloak -verify_hostname keycloak -CAfile /probe-ca/idp-ca.crt \
      -sess_in /tmp/idp.sess -ign_eof 2>&1)"
    kind="$(printf "%s\n" "$out" | sed -n "s/^\(New\|Reused\), .*/\1/p" | head -n 1)"
    code="$(printf "%s\n" "$out" | sed -n "s/^ *Verify return code: \([0-9]*\).*/\1/p" | tail -n 1)"
    status="$(printf "%s\n" "$out" | grep -aoE "HTTP/1\.[01] [0-9]{3}" | tail -n 1 | cut -d" " -f2)"
    echo "${kind:-none} verify=${code:-none} status=${status:-none}"' probe x "$DISCOVERY_PATH" "${AUTH_HOSTNAME}:${HTTPS_PORT}"
}

# A second nginx on the idp network, from the ingress image, used only by
# verify-keycloak-tls to compare the production upstream directives with
# variants: session reuse on, a kept-alive upstream connection, another
# dialed name, and verification off (the negative control). It has the
# identity-provider CA and no secret; it is reachable only from inside itself.
start_nginx_control() {
  local conf="${AUTH_WORK}/nginx-control.conf"
  cat > "$conf" <<EOF_NGINX
worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr error;
events { worker_connections 64; }
http {
    access_log off;
    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    resolver 127.0.0.11 valid=10s ipv6=off;

    upstream keycloak_keepalive {
        server keycloak:${IDP_TLS_PORT};
        keepalive 2;
        keepalive_timeout 600s;
    }

    server {
        listen 127.0.0.1:8080;
        proxy_set_header Host ${AUTH_HOSTNAME}:${HTTPS_PORT};
        proxy_ssl_trusted_certificate /run/idp-ca/ca.crt;
        proxy_ssl_protocols TLSv1.2 TLSv1.3;
        proxy_ssl_server_name on;
        proxy_connect_timeout 2s;
        set \$discovery https://keycloak:${IDP_TLS_PORT}${DISCOVERY_PATH};

        location = /healthz { return 200; }

        # The production directives, unchanged.
        location = /production {
            include /etc/nginx/keycloak-upstream.conf;
            proxy_pass \$discovery;
        }
        location = /reuse-on {
            proxy_ssl_verify on;
            proxy_ssl_name keycloak;
            proxy_ssl_session_reuse on;
            proxy_pass \$discovery;
        }
        location = /keepalive {
            proxy_ssl_verify on;
            proxy_ssl_name keycloak;
            proxy_ssl_session_reuse on;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host ${AUTH_HOSTNAME}:${HTTPS_PORT};
            proxy_pass https://keycloak_keepalive${DISCOVERY_PATH};
        }
        location = /other-name {
            proxy_ssl_verify on;
            proxy_ssl_name postgres;
            proxy_ssl_session_reuse off;
            proxy_pass \$discovery;
        }
        location = /verify-off {
            proxy_ssl_verify off;
            proxy_pass \$discovery;
        }
    }
}
EOF_NGINX
  chmod 644 "$conf"
  docker rm -fv "$NGINX_CONTROL" >/dev/null 2>&1 || true
  docker run -d --name "$NGINX_CONTROL" --network "${PROJECT}_idp" \
    --read-only --tmpfs /tmp --tmpfs /var/cache/nginx --cap-drop ALL \
    --security-opt no-new-privileges:true --user 101:101 \
    -v "${conf}:/etc/nginx/nginx.conf:ro" -v "${PKI_DIR}/idp-ca.crt:/run/idp-ca/ca.crt:ro" \
    "$INGRESS_IMAGE" >/dev/null
  local _
  for _ in $(seq 1 20); do
    [[ "$(control_status healthz)" == 200 ]] && return 0
    sleep 0.5
  done
  die "the nginx control did not start: $(docker logs "$NGINX_CONTROL" 2>&1 | tail -n 3)"
}

stop_nginx_control() {
  docker rm -fv "$NGINX_CONTROL" >/dev/null 2>&1 || true
}

control_status() {
  { docker exec "$NGINX_CONTROL" wget -q -S -O /dev/null "http://127.0.0.1:8080/$1" 2>&1 || true; } \
    | grep -oE 'HTTP/1\.[01] [0-9]{3}' | tail -n 1 | cut -d' ' -f2
}

control_tls_reason_since() {
  docker logs --since "$1" "$NGINX_CONTROL" 2>&1 | nginx_upstream_tls_reason
}

# Byte strings counted in a capture: "<kind>\t<value>" lines in $2, searched
# in the binary file $1. Prints "<kind>=<occurrences>" for each kind, sorted.
count_in_capture() {
  python3 -I - "$1" "$2" <<'PY'
import sys
data = open(sys.argv[1], "rb").read()
counts = {}
for line in open(sys.argv[2], encoding="utf-8"):
    kind, _, value = line.rstrip("\n").partition("\t")
    if value:
        counts[kind] = counts.get(kind, 0) + data.count(value.encode())
print(" ".join(f"{k}={counts[k]}" for k in sorted(counts)))
PY
}

# Passive capture of the ingress ↔ Keycloak hop, as a network member with raw
# sockets could do it (threat T1): a container joins Keycloak's network
# namespace with CAP_NET_RAW, reads every frame for a fixed time, and keeps
# the TCP payloads between the ingress's and Keycloak's idp addresses. During
# the capture a sign-in (password and authorization code), the code
# redemption by oauth2-proxy (gateway client secret), and a client-credentials
# request (automation client secret) cross the hop. The capture stays in a
# temporary file and is deleted; only counts are recorded, never values.
# $1: observe (record only) or encrypted (expect no plaintext).
CAPTURE_SCRIPT='
use strict; use warnings; use Socket qw(inet_aton);
my ($x, $y, $secs) = @ARGV;
my ($ia, $ib) = (inet_aton($x), inet_aton($y));
socket(my $s, 17, 3, 0x0300) or die "socket: $!\n";
binmode STDOUT; $| = 1;
print STDERR "ready\n";
my $end = time + $secs;
my $rin = ""; vec($rin, fileno($s), 1) = 1;
while (time < $end) {
  my $rout = $rin;
  next unless select($rout, undef, undef, 0.5) > 0;
  my $buf = "";
  defined(recv($s, $buf, 65535, 0)) or next;
  next unless length($buf) > 34 && substr($buf, 12, 2) eq "\x08\x00" && ord(substr($buf, 23, 1)) == 6;
  my ($src, $dst) = (substr($buf, 26, 4), substr($buf, 30, 4));
  next unless ($src eq $ia && $dst eq $ib) || ($src eq $ib && $dst eq $ia);
  my $end_ip = 14 + unpack("n", substr($buf, 16, 2));
  my $tcp = 14 + (ord(substr($buf, 14, 1)) & 15) * 4;
  my $data = $tcp + (ord(substr($buf, $tcp + 12, 1)) >> 4) * 4;
  print substr($buf, $data, $end_ip - $data) if $end_ip > $data;
}
'

capture_idp_hop() {
  local mode="$1" area="passive capture of the ingress-Keycloak hop"
  local ingress_ip keycloak_ip keycloak_id capture="${AUTH_WORK}/idp-hop.capture" values="${AUTH_WORK}/capture-values"
  local pid _ jar="${AUTH_WORK}/capture" callback code result token response
  ingress_ip="$(container_ip ingress idp)"
  keycloak_ip="$(container_ip keycloak idp)"
  keycloak_id="$(compose ps -q keycloak)"
  : > "$values"

  (umask 077; : > "$capture"; : > "${capture}.err")
  docker run --rm --network "container:${keycloak_id}" --cap-drop ALL --cap-add NET_RAW \
    --security-opt no-new-privileges:true --read-only --user 0:0 --entrypoint perl "$RABBITMQ_IMAGE" \
    -e "$CAPTURE_SCRIPT" "$ingress_ip" "$keycloak_ip" 20 > "$capture" 2> "${capture}.err" &
  pid=$!
  for _ in $(seq 1 50); do
    grep -q ready "${capture}.err" && break
    sleep 0.2
  done
  record "$area" "capture started (raw socket in Keycloak's network namespace)" "observe" \
    "$(grep -q ready "${capture}.err" && echo yes || echo "no: $(head -c 200 "${capture}.err")")" info

  callback="$(authorize_until_callback "$jar")"
  code="$(query_param "$callback" code)"
  result="$(curl_config url "$callback" | status_and_request_id -K - -c "$jar" -b "$jar")"
  response="$(client_credentials_response)"
  token="$(json_field access_token <<< "$response")"
  wait "$pid" || true

  add_value "$values" password "$(secret lab-user-password)"
  add_value "$values" authorization-code "$code"
  add_value "$values" client-secret "$(secret gateway-client-secret)"
  add_value "$values" client-secret "$(secret automation-client-secret)"
  add_value "$values" client-secret-basic "$(printf 'work-items-gateway:%s' "$(secret gateway-client-secret)" | base64 -w0)"
  add_value "$values" client-secret-basic "$(printf 'work-items-automation:%s' "$(secret automation-client-secret)" | base64 -w0)"
  add_value "$values" access-token "$token"
  printf 'http-message\tHTTP/1.\ntls-server-name\t%s\n' "$IDP_TLS_NAME" >> "$values"

  local bytes counts credentials
  bytes="$(stat -c '%s' "$capture")"
  counts="$(count_in_capture "$capture" "$values")"
  credentials="$(tr ' ' '\n' <<< "$counts" | grep -vE '^(http-message|tls-server-name)=' \
    | awk -F= '{n += $2} END {print n + 0}')"
  rm -f -- "$capture" "${capture}.err"

  record "$area" "flows during the capture: sign-in callback, client credentials" "observe" \
    "callback=${result%% *} code=$([[ -n "$code" ]] && echo obtained || echo missing) token=$([[ -n "$token" ]] && echo issued || echo missing)" info
  record "$area" "payload bytes captured on the hop" "observe" "$bytes" info
  record "$area" "occurrences per kind (credentials, plaintext HTTP, TLS server name)" "observe" "$counts" info

  if [[ "$mode" == encrypted ]]; then
    expect "$area" "credential occurrences in the captured payload" "0" "$credentials"
    expect "$area" "plaintext HTTP messages in the captured payload" "0" \
      "$(tr ' ' '\n' <<< "$counts" | sed -n 's/^http-message=//p')"
    # Positive control: the capture saw the hop (the TLS ClientHello names
    # the server in clear text).
    expect "$area" "positive control: TLS server name seen in the capture" "yes" \
      "$([[ "$(tr ' ' '\n' <<< "$counts" | sed -n 's/^tls-server-name=//p')" -gt 0 ]] && echo yes || echo no)"
  fi
}

# Read-only use of the capture on any running lab, including one created
# before ADR 0007 (it needs no identity-provider CA).
capture_idp_hop_command() {
  local evidence_file="" started
  [[ "${1:-}" == "--evidence" ]] && evidence_file="${2:?--evidence requires a file}"
  require_command python3
  for service in keycloak ingress oauth2-proxy; do
    [[ -n "$(compose ps -q --status running "$service" 2>/dev/null)" ]] || die "${service} is not running; run: $0 start"
  done
  RESULTS=(); FAILED=0
  AUTH_WORK="$(mktemp -d)"
  trap 'rm -rf -- "$AUTH_WORK"' EXIT
  started="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  wait_for_issuer || die "the issuer is not reachable: ${ISSUER}"
  record "metadata" "issuer discovery through the ingress" "observe" "$(discovery_fingerprint)" info
  record "metadata" "keycloak: listening sockets" "observe" "$(keycloak_listeners)" info
  record "metadata" "ingress upstream for the identity provider (access log)" "observe" \
    "$(compose logs --no-log-prefix --since "$started" ingress 2>/dev/null | grep -F "host=${AUTH_HOSTNAME} " \
       | grep -oE 'uaddr=[^ ]*' | sed -E 's/uaddr=[0-9.]+:/port=/' | sort | uniq -c | sed 's/^ *//' | paste -sd ';' -)" info
  capture_idp_hop observe
  [[ -n "$evidence_file" ]] && write_auth_evidence "$evidence_file" "$started" \
    "capture-idp-hop: passive capture of the ingress-Keycloak hop from Keycloak's network namespace during a sign-in, code redemption, and client-credentials request; counts only, no values recorded."
  finish_checks "Identity-provider hop capture"
}

# Expected client-side verdicts per Keycloak certificate kind: OpenSSL's
# verify code (s_client keeps the last error) and nginx's log text.
expected_idp_code() {
  case "$1" in
    untrusted | lab-ca) echo 21 ;;  # unable to verify the first certificate
    mismatch) echo 47 ;;            # permitted subtree violation (after the hostname check)
    expired) echo 10 ;;             # certificate has expired
    subdomain | ip) echo 48 ;;      # excluded subtree violation
  esac
}

expected_nginx_reason() {
  case "$1" in
    untrusted | lab-ca) echo "upstream SSL certificate verify error: (21:unable to verify the first certificate)" ;;
    mismatch) echo "upstream SSL certificate verify error: (47:permitted subtree violation)" ;;
    expired) echo "upstream SSL certificate verify error: (10:certificate has expired)" ;;
    subdomain | ip) echo "upstream SSL certificate verify error: (48:excluded subtree violation)" ;;
  esac
}

# Ingress access-log lines for the identity-provider host since $1, as
# "<count> <status> upstream=<status> port=<upstream port>".
ingress_idp_access_since() {
  { compose logs --no-log-prefix --since "$1" ingress 2>/dev/null | grep -F "host=${AUTH_HOSTNAME} " || true; } \
    | sed -nE 's/.*" ([0-9]{3}) [0-9]+ host=[^ ]+ upstream=([^ ]+) uaddr=([^ ]+) .*/\1 upstream=\2 port=\3/p' \
    | sed -E 's/port=[^ ]*:([0-9]+)$/port=\1/' | sort | uniq -c | sed 's/^ *//' | paste -sd ';' -
}

# One failure case: install a bad certificate, wait until Keycloak serves it
# to new connections, observe the ingress (public route, diagnostics, logs),
# connections negotiated before the change, the control variants, and
# recovery by renewal without restarting anything.
keycloak_tls_failure_case() {
  local kind="$1" rogue="$2" values="$3" area="keycloak: ${1}" bad good since observed machine_before

  open_established_connection
  save_idp_session >/dev/null
  control_status keepalive >/dev/null
  machine_before="$(client_credentials access_token)"
  add_value "$values" machine-access-token "$machine_before"

  issue_keycloak_certificate "$kind" "$rogue"
  bad="$(certificate_serial "$IDP_TLS_FILE")"
  expect "$area" "new connection: served serial after Keycloak rereads the file" "$bad" \
    "$(wait_for_keycloak "$bad" idp_served_serial)"
  expect "$area" "new connection: openssl verify code (identity-provider CA, name keycloak)" \
    "$(expected_idp_code "$kind")" "$(idp_tls_probe | cut -d' ' -f1)"

  # The public route, as browsers and clients use it.
  since="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  expect "$area" "ingress: issuer discovery" "503 identity_provider_unavailable" "$(discovery_summary)"
  expect "$area" "ingress: client-credentials token request (secret sent)" "503" "$(token_request_status)"
  expect "$area" "ingress: new browser sign-in" "503" "$(new_sign_in_status "${AUTH_WORK}/new-${kind}")"
  sleep 1
  expect "$area" "ingress: public-route upstream TLS reason lines (suppressed below crit)" "" \
    "$(ingress_tls_reason_since "$since")"
  observed="$(ingress_idp_access_since "$since")"
  expect "$area" "ingress access log: identity-provider requests" "yes" \
    "$([[ -n "$observed" ]] && ! grep -qvE '^[0-9]+ 503 upstream=502 port=8443$' <<< "$(tr ';' '\n' <<< "$observed")" && echo yes || echo no)"
  record "$area" "ingress access log: identity-provider requests (count status upstream port)" "observe" "$observed" info

  # The diagnostic route logs the reason.
  since="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  expect "$area" "diagnostic route: status" "502" "$(keycloak_upstream_check)"
  sleep 1
  expect "$area" "diagnostic route: TLS reason in the ingress log" "$(expected_nginx_reason "$kind")" \
    "$(ingress_tls_reason_since "$since")"
  record "$area" "diagnostic route: logged line (addresses redacted)" "observe" \
    "$(ingress_tls_lines_since "$since" | head -n 1)" info

  # What was negotiated or issued before the change.
  expect "$area" "established TLS connection opened before the change: next request" \
    "200 responses=2 handshakes=1 verify=0" "$(established_request)"
  record "$area" "TLS session saved before the change, offered on a new connection" "observe" \
    "$(resume_idp_session)" info
  expect "$area" "machine token issued before the change, at the API (local validation)" "200" \
    "$(bearer_status "$machine_before" "${APP_URL}/api/items")"
  expect "$area" "ingress: established connections to Keycloak:8443" "0" \
    "$(established_to_port "$(compose ps -q ingress)" "$IDP_TLS_PORT")"

  # Control variants on the same certificate.
  since="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  expect "$area" "control nginx: production directives" "502" "$(control_status production)"
  record "$area" "control nginx: session reuse on (variable upstream)" "observe" "$(control_status reuse-on)" info
  record "$area" "control nginx: keep-alive upstream connection opened before the change" "observe" \
    "$(control_status keepalive)" info
  expect "$area" "control nginx: verification off (negative control)" "200" "$(control_status verify-off)"
  sleep 1
  record "$area" "control nginx: TLS reasons logged" "observe" "$(control_tls_reason_since "$since")" info

  # Recovery: a valid certificate, picked up by Keycloak's reload; nothing
  # is restarted.
  issue_keycloak_certificate valid
  good="$(certificate_serial "$IDP_TLS_FILE")"
  expect "$area" "renewed: openssl verify code, served serial" "0 ${good}" \
    "$(wait_for_keycloak "0 ${good}" idp_tls_probe)"
  expect "$area" "renewed: issuer discovery" "200" "$(discovery_summary)"
  expect "$area" "renewed: client-credentials token request" "200" "$(token_request_status)"
  local jar="${AUTH_WORK}/recovered-${kind}"
  browser_login "$jar" lab-user >/dev/null
  expect "$area" "renewed: sign-in, then GET /api/items with the session" "200" "$(session_status "$jar" "${APP_URL}/api/items")"
  add_value "$values" session-cookie "$(session_cookie "$jar")"
  expect "$area" "renewed: diagnostic route" "200" "$(keycloak_upstream_check)"
}

# Isolated positive control for the IP exclusion. It shows that the mixed
# certificate (keycloak plus IP:127.0.0.1) is refused because of the
# identity-provider CA's constraints, not because of its names or format: the
# same verifier, nginx from the ingress image with the production
# keycloak-upstream.conf, dialing the name keycloak, accepts an equivalent
# certificate from a CA without name constraints. Only the trust anchor
# mounted at /run/idp-ca/ca.crt differs.
#
# Everything runs on its own internal network with a stand-in TLS server
# under the alias keycloak. The lab's containers, networks, Keycloak
# certificate, and the ingress's trust anchor are not touched; the control CA
# and its key exist only in the run's temporary directory.
IPCONTROL_NETWORK="${PROJECT}-ipcontrol"
IPCONTROL_SERVER="${PROJECT}-ipcontrol-server"
IPCONTROL_CLIENT="${PROJECT}-ipcontrol-client"

stop_ipcontrol() {
  docker rm -fv "$IPCONTROL_CLIENT" "$IPCONTROL_SERVER" >/dev/null 2>&1 || true
  docker network rm "$IPCONTROL_NETWORK" >/dev/null 2>&1 || true
}

# Serve the key-and-certificate file $1 on keycloak:8443 in the control network.
start_ipcontrol_server() {
  local dir="${AUTH_WORK}/ipcontrol"
  cat > "${dir}/server.conf" <<'EOF_NGINX'
worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr error;
events { worker_connections 16; }
http {
    access_log off;
    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    server {
        listen 8443 ssl;
        ssl_certificate /tls/tls.pem;
        ssl_certificate_key /tls/tls.pem;
        location / { return 200 "control\n"; }
    }
}
EOF_NGINX
  chmod 644 "${dir}/server.conf" "$1"
  docker rm -fv "$IPCONTROL_SERVER" >/dev/null 2>&1 || true
  docker run -d --name "$IPCONTROL_SERVER" --network "$IPCONTROL_NETWORK" --network-alias "$IDP_TLS_NAME" \
    --read-only --tmpfs /tmp --tmpfs /var/cache/nginx --cap-drop ALL \
    --security-opt no-new-privileges:true --user 101:101 \
    -v "${dir}/server.conf:/etc/nginx/nginx.conf:ro" -v "$1:/tls/tls.pem:ro" \
    "$INGRESS_IMAGE" >/dev/null
}

# The verifier: nginx from the ingress image, trusting the CA certificate $1,
# proxying to https://keycloak:8443 with the image's keycloak-upstream.conf.
start_ipcontrol_client() {
  local dir="${AUTH_WORK}/ipcontrol" _
  cat > "${dir}/client.conf" <<'EOF_NGINX'
worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr error;
events { worker_connections 16; }
http {
    access_log off;
    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    resolver 127.0.0.11 valid=10s ipv6=off;
    server {
        listen 127.0.0.1:8080;
        location = /healthz { return 200; }
        location = /check {
            set $keycloak https://keycloak:8443;
            include /etc/nginx/keycloak-upstream.conf;
            proxy_connect_timeout 2s;
            proxy_pass $keycloak/;
        }
    }
}
EOF_NGINX
  chmod 644 "${dir}/client.conf" "$1"
  docker rm -fv "$IPCONTROL_CLIENT" >/dev/null 2>&1 || true
  docker run -d --name "$IPCONTROL_CLIENT" --network "$IPCONTROL_NETWORK" \
    --read-only --tmpfs /tmp --tmpfs /var/cache/nginx --cap-drop ALL \
    --security-opt no-new-privileges:true --user 101:101 \
    -v "${dir}/client.conf:/etc/nginx/nginx.conf:ro" -v "$1:/run/idp-ca/ca.crt:ro" \
    "$INGRESS_IMAGE" >/dev/null
  for _ in $(seq 1 20); do
    [[ "$(ipcontrol_status healthz)" == 200 ]] && return 0
    sleep 0.5
  done
  die "the IP-exclusion control client did not start: $(docker logs "$IPCONTROL_CLIENT" 2>&1 | tail -n 3)"
}

ipcontrol_status() {
  { docker exec "$IPCONTROL_CLIENT" wget -q -S -O /dev/null "http://127.0.0.1:8080/$1" 2>&1 || true; } \
    | grep -oE 'HTTP/1\.[01] [0-9]{3}' | tail -n 1 | cut -d' ' -f2
}

# One isolated observation: server certificate $1, client trust anchor $2.
# Prints "<status> reason=<nginx's upstream TLS verdict or none>".
ipcontrol_observe() {
  local since status reason
  start_ipcontrol_server "$1"
  start_ipcontrol_client "$2"
  since="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  status="$(ipcontrol_status check)"
  sleep 1
  reason="$(docker logs --since "$since" "$IPCONTROL_CLIENT" 2>&1 | nginx_upstream_tls_reason)"
  echo "${status:-none} reason=${reason:-none}"
}

keycloak_ip_constraint_control() {
  local area="keycloak: ip (isolated control)" dir="${AUTH_WORK}/ipcontrol" open="${AUTH_WORK}/ipcontrol/open-ca"
  local mixed="DNS:${IDP_TLS_NAME},IP:127.0.0.1"
  mkdir -p "${dir}/valid" "${dir}/constrained" "${dir}/open"
  chmod 755 "$dir" "${dir}/valid" "${dir}/constrained" "${dir}/open"

  # A control CA without name constraints, same key type and basic
  # constraints as the identity-provider CA.
  (
    umask 077
    openssl req -x509 -new -newkey ec -pkeyopt ec_paramgen_curve:P-256 -noenc \
      -keyout "${open}.key" -out "${open}.crt" -days 1 \
      -subj "/CN=Unconstrained control CA (verify-keycloak-tls)" \
      -addext "basicConstraints=critical,CA:TRUE,pathlen:0" \
      -addext "keyUsage=critical,keyCertSign,cRLSign" \
      -addext "subjectKeyIdentifier=hash" 2>/dev/null
  )
  write_server_certificate "${dir}/valid/tls.pem" "${PKI_DIR}/idp-ca" "DNS:${IDP_TLS_NAME}"
  write_server_certificate "${dir}/constrained/tls.pem" "${PKI_DIR}/idp-ca" "$mixed"
  write_server_certificate "${dir}/open/tls.pem" "$open" "$mixed"
  record "$area" "subject alternative names of both mixed certificates" "observe" \
    "constrained: $(openssl x509 -noout -ext subjectAltName -in "${dir}/constrained/tls.pem" | tail -n 1 | tr -d ' ');open: $(openssl x509 -noout -ext subjectAltName -in "${dir}/open/tls.pem" | tail -n 1 | tr -d ' ')" info

  local anchor_before
  anchor_before="$(compose exec -T ingress sha256sum /run/idp-ca/ca.crt 2>/dev/null | cut -d' ' -f1)"
  stop_ipcontrol
  docker network create --internal "$IPCONTROL_NETWORK" >/dev/null
  expect "$area" "valid keycloak certificate, identity-provider CA trusted (setup works)" "200 reason=none" \
    "$(ipcontrol_observe "${dir}/valid/tls.pem" "${PKI_DIR}/idp-ca.crt")"
  expect "$area" "keycloak plus IP:127.0.0.1 from the identity-provider CA, identity-provider CA trusted" \
    "502 reason=upstream SSL certificate verify error: (48:excluded subtree violation)" \
    "$(ipcontrol_observe "${dir}/constrained/tls.pem" "${PKI_DIR}/idp-ca.crt")"
  expect "$area" "positive control: keycloak plus IP:127.0.0.1 from an unconstrained CA, that CA trusted" "200 reason=none" \
    "$(ipcontrol_observe "${dir}/open/tls.pem" "${open}.crt")"
  stop_ipcontrol

  # The ingress's trust anchor is the identity-provider CA before and after.
  expect "$area" "ingress trust anchor is the identity-provider CA before the control" \
    "$(sha256sum "${PKI_DIR}/idp-ca.crt" | cut -d' ' -f1)" "$anchor_before"
  expect "$area" "ingress trust anchor unchanged by the control" "$anchor_before" \
    "$(compose exec -T ingress sha256sum /run/idp-ca/ca.crt 2>/dev/null | cut -d' ' -f1)"
  rm -f -- "${open}.key"
}

# Renewal with a valid certificate: new connections get the new serial;
# connections and sessions from before are observed.
keycloak_tls_renewal_case() {
  local values="$1" area="keycloak: renewal" before new_serial jar="${AUTH_WORK}/renewal"
  open_established_connection
  save_idp_session >/dev/null
  before="$(idp_tls_probe)"
  issue_keycloak_certificate valid
  new_serial="$(certificate_serial "$IDP_TLS_FILE")"
  record "$area" "before: openssl verify code, served serial" "observe" "$before" info
  expect "$area" "after: openssl verify code, served serial" "0 ${new_serial}" \
    "$(wait_for_keycloak "0 ${new_serial}" idp_tls_probe)"
  expect "$area" "served serial changed" "changed" \
    "$([[ "${before#* }" != "$new_serial" ]] && echo changed || echo unchanged)"
  expect "$area" "established TLS connection opened before renewal: next request" \
    "200 responses=2 handshakes=1 verify=0" "$(established_request)"
  record "$area" "TLS session saved before renewal, offered on a new connection" "observe" "$(resume_idp_session)" info
  expect "$area" "issuer discovery" "200" "$(discovery_summary)"
  browser_login "$jar" lab-user >/dev/null
  add_value "$values" session-cookie "$(session_cookie "$jar")"
  expect "$area" "sign-in, then create and process" "succeeded" "$(tls_flow "$jar" "keycloak tls renewal")"
}

verify_keycloak_tls() {
  local evidence_file="" started service
  [[ "${1:-}" == "--evidence" ]] && evidence_file="${2:?--evidence requires a file}"
  require_command python3
  require_owned_state
  for service in keycloak ingress api worker oauth2-proxy; do
    [[ -n "$(compose ps -q --status running "$service" 2>/dev/null)" ]] || die "${service} is not running; run: $0 start"
  done
  openssl x509 -help 2>&1 | grep -q -- '-not_after' ||
    die "openssl $(openssl version | cut -d' ' -f2) cannot issue the expired test certificate (-not_after needs 3.4 or later)"

  RESULTS=(); FAILED=0
  AUTH_WORK="$(mktemp -d)"
  TLS_ROGUE_DIR="$(mktemp -d)"
  local rogue="$TLS_ROGUE_DIR"
  # Always leave a valid certificate, the probe and control removed, and the
  # untrusted CA's key deleted, also after a failure. Keycloak serves a
  # reissued certificate from its next reload.
  trap '
    stop_idp_probe
    stop_nginx_control
    stop_ipcontrol
    if ! keycloak_certificate_ok 0; then
      issue_keycloak_certificate valid
      echo "A valid Keycloak certificate was reissued; Keycloak serves it within ${KEYCLOAK_TLS_RELOAD_SECONDS} s." >&2
    fi
    rm -rf -- "$AUTH_WORK" "$TLS_ROGUE_DIR"
  ' EXIT
  set_ui_headers
  started="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  wait_for_issuer || die "the issuer is not reachable: ${ISSUER}"

  (
    umask 077
    openssl req -x509 -new -newkey ec -pkeyopt ec_paramgen_curve:P-256 -noenc \
      -keyout "${rogue}/ca.key" -out "${rogue}/ca.crt" -days 1 \
      -subj "/CN=Untrusted test CA (verify-keycloak-tls)" \
      -addext "basicConstraints=critical,CA:TRUE,pathlen:0" \
      -addext "keyUsage=critical,keyCertSign" 2>/dev/null
  )

  # Values searched in the logs at the end; never printed or recorded.
  local values="${AUTH_WORK}/log-values" name
  : > "$values"
  for name in gateway-client-secret automation-client-secret lab-user-password lab-admin-client-secret \
              oauth2-proxy-cookie-secret valkey-password keycloak-db-password; do
    add_value "$values" secret "$(secret "$name")"
  done

  local keycloak_started ingress_started
  keycloak_started="$(container_started_at keycloak)"
  ingress_started="$(container_started_at ingress)"
  start_idp_probe
  start_nginx_control

  # --- Baseline -------------------------------------------------------------
  local area="baseline" serial observed jar callback location login_action code
  serial="$(certificate_serial "$IDP_TLS_FILE")"
  expect "$area" "keycloak: openssl verify code, served serial (identity-provider CA)" "0 ${serial}" \
    "$(wait_for_keycloak "0 ${serial}" idp_tls_probe)"
  expect "$area" "keycloak: verify code with the lab CA instead" "21" "$(idp_tls_probe lab | cut -d' ' -f1)"
  expect "$area" "keycloak: verify code with the internal CA instead" "21" "$(idp_tls_probe internal | cut -d' ' -f1)"
  expect "$area" "keycloak:8080 (plaintext HTTP) from the idp network" "refused connects=0 exit=7" \
    "$(probe_tcp_detail "${PROJECT}_idp" "keycloak:8080")"
  expect "$area" "keycloak:9000 (management) from the idp network" "refused connects=0 exit=7" \
    "$(probe_tcp_detail "${PROJECT}_idp" "keycloak:9000")"
  record "$area" "plaintext HTTP request to the TLS port 8443 (curl exit)" "observe" \
    "$(docker run --rm --network "${PROJECT}_idp" --entrypoint curl "$PROBE_IMAGE" -sS -o /dev/null \
        --max-time 5 -w '%{http_code}' "http://keycloak:8443${DISCOVERY_PATH}" 2>/dev/null; echo " exit=$?")" info
  observed="$(keycloak_listeners)"
  record "$area" "keycloak: listening sockets" "observe" "$observed" info
  expect "$area" "keycloak: management interface on loopback only" "yes" \
    "$(tr ',' '\n' <<< "$observed" | grep ':9000$' | grep -qvx '127.0.0.1:9000' && echo no || echo yes)"
  expect "$area" "keycloak: no listener on 8080" "yes" "$(grep -qE '(^|,)[^,]*:8080(,|$)' <<< "$observed" && echo no || echo yes)"
  # Keycloak's embedded cache cluster (JGroups) listens on the idp network
  # too; it is outside this hop's decision and only observed here.
  record "$area" "keycloak:7800 (cluster transport): issuer of the certificate it serves" "observe" \
    "$(docker exec "$IDP_PROBE" sh -c '/opt/openssl/bin/openssl s_client -connect keycloak:7800 </dev/null 2>/dev/null |
        /opt/openssl/bin/openssl x509 -noout -issuer 2>/dev/null || echo "no certificate"')" info
  record "$area" "keycloak:57800 (cluster failure detection) from the idp network" "observe" \
    "$(probe_tcp_detail "${PROJECT}_idp" "keycloak:57800")" info

  # Public names, metadata, and redirects are unchanged by the internal TLS.
  expect "$area" "issuer discovery through the ingress" "200" "$(discovery_summary)"
  observed="$(discovery_fingerprint)"
  record "$area" "issuer discovery fingerprint" "observe" "$observed" info
  expect "$area" "discovery: issuer and endpoints" "issuer=${ISSUER} endpoints_below_issuer=yes" "${observed#* }"
  expect "$area" "discovery with spoofed X-Forwarded-*/Forwarded headers: same document" "${observed%% *}" \
    "$(discovery_fingerprint -H 'X-Forwarded-Host: attacker.example' -H 'X-Forwarded-Proto: http' \
        -H 'X-Forwarded-Port: 80' -H 'Forwarded: host=attacker.example;proto=http' | cut -d' ' -f1)"
  expect "$area" "diagnostic route" "200" "$(keycloak_upstream_check)"

  jar="${AUTH_WORK}/baseline"
  location="$(authorization_request "$jar")"
  expect "$area" "gateway redirects the browser to the public authorization endpoint" "yes" \
    "$([[ "$location" == "${ISSUER}/protocol/openid-connect/auth?"* ]] && echo yes || echo no)"
  login_action="$(curl_config url "$location" | lab_curl -K - -c "$jar" -b "$jar" 2>/dev/null \
    | grep -o 'id="kc-form-login"[^>]*action="[^"]*"' | sed 's/.*action="//; s/"$//; s/&amp;/\&/g' || true)"
  expect "$area" "login form posts to the public login-actions URL" "yes" \
    "$([[ "$login_action" == "${ISSUER}/login-actions/authenticate?"* ]] && echo yes || echo no)"
  jar="${AUTH_WORK}/baseline-signin"
  callback="$(authorize_until_callback "$jar")"
  code="$(query_param "$callback" code)"
  add_value "$values" code "$code"
  add_value "$values" state "$(query_param "$callback" state)"
  expect "$area" "Keycloak redirects back to the gateway callback" "yes" \
    "$([[ "$callback" == "${APP_URL}/oauth2/callback?"* && -n "$code" ]] && echo yes || echo no)"
  expect "$area" "callback (code redeemed by oauth2-proxy through the ingress)" "302" \
    "$(curl_config url "$callback" | status_and_request_id -K - -c "$jar" -b "$jar" | cut -d' ' -f1)"
  expect "$area" "session: GET /api/items" "200" "$(session_status "$jar" "${APP_URL}/api/items")"
  add_value "$values" session-cookie "$(session_cookie "$jar")"
  observed="$(session_access_token "$jar")"
  add_value "$values" session-access-token "$observed"
  expect "$area" "session access token issuer" "iss=${ISSUER}" "$(token_claims iss <<< "$observed")"
  expect "$area" "session: create and process" "succeeded" "$(tls_flow "$jar" "keycloak tls baseline")"

  local machine
  machine="$(client_credentials access_token)"
  add_value "$values" machine-access-token "$machine"
  expect "$area" "machine token issuer" "iss=${ISSUER}" "$(token_claims iss <<< "$machine")"
  expect "$area" "machine token: GET /api/items" "200" "$(bearer_status "$machine" "${APP_URL}/api/items")"

  # Sign-out ends the Keycloak session through the ingress (backend logout).
  local status
  status="$(lab_curl -o /dev/null -D - -b "$jar" -c "$jar" -X POST -H "Origin: ${APP_URL}" \
    -H "Sec-Fetch-Site: same-origin" -H "Sec-Fetch-Mode: cors" -H "X-Requested-With: work-items-web" \
    "${APP_URL}/oauth2/sign_out" 2>/dev/null | tr -d '\r' | awk 'NR==1{print $2}')"
  expect "$area" "sign-out" "302" "$status"
  expect "$area" "after sign-out: Keycloak session ended (login form)" "login-form" "$(idp_session_state "$jar")"

  sleep 1
  observed="$(ingress_idp_access_since "$started")"
  record "$area" "ingress access log: identity-provider requests (count status upstream port)" "observe" "$observed" info
  expect "$area" "ingress access log: every Keycloak upstream on port 8443" "yes" \
    "$(tr ';' '\n' <<< "$observed" | awk '$3 ~ /^upstream=[0-9]/' | grep -q . &&
       ! tr ';' '\n' <<< "$observed" | awk '$3 ~ /^upstream=[0-9]/' | grep -qv 'port=8443$' && echo yes || echo no)"
  expect "$area" "ingress: established connections to Keycloak:8443 after the requests" "0" \
    "$(established_to_port "$(compose ps -q ingress)" "$IDP_TLS_PORT")"

  # Control variants with the valid certificate.
  local since
  since="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  expect "$area" "control nginx: production directives" "200" "$(control_status production)"
  expect "$area" "control nginx: session reuse on" "200" "$(control_status reuse-on)"
  expect "$area" "control nginx: keep-alive upstream" "200" "$(control_status keepalive)"
  expect "$area" "control nginx: verification off" "200" "$(control_status verify-off)"
  expect "$area" "control nginx: dialed name postgres (hostname check)" "502" "$(control_status other-name)"
  sleep 1
  expect "$area" "control nginx: hostname-check reason" 'upstream SSL certificate does not match "postgres"' \
    "$(control_tls_reason_since "$since")"
  record "$area" "control nginx: keep-alive connections held to Keycloak:8443" "observe" \
    "$(established_to_port "$NGINX_CONTROL" "$IDP_TLS_PORT")" info

  expect "$area" "TLS session saved from a new verified connection" "saved" "$(save_idp_session)"
  record "$area" "saved TLS session offered on a new connection (no change)" "observe" "$(resume_idp_session)" info
  # Control for the failure cases: Keycloak rereads its certificate every
  # KEYCLOAK_TLS_RELOAD_SECONDS even when the file is unchanged. Whether a
  # saved session survives such a reload decides whether a refused session
  # later is caused by the certificate change or by any reload.
  local digest
  digest="$(sha256sum "$IDP_TLS_FILE" | cut -d' ' -f1)"
  sleep $(( KEYCLOAK_TLS_RELOAD_SECONDS * 2 + 5 ))
  expect "$area" "certificate file unchanged across two reload periods" "unchanged" \
    "$([[ "$(sha256sum "$IDP_TLS_FILE" | cut -d' ' -f1)" == "$digest" ]] && echo unchanged || echo changed)"
  record "$area" "saved TLS session offered after two unchanged reload periods (control)" "observe" \
    "$(resume_idp_session)" info

  capture_idp_hop encrypted

  # --- Failure cases and recovery ------------------------------------------
  local kind
  for kind in untrusted lab-ca mismatch expired subdomain ip; do
    keycloak_tls_failure_case "$kind" "$rogue" "$values"
  done
  keycloak_ip_constraint_control

  # --- Renewal --------------------------------------------------------------
  keycloak_tls_renewal_case "$values"

  # --- Final state ------------------------------------------------------------
  area="final state"
  expect "$area" "keycloak container not restarted" "$keycloak_started" "$(container_started_at keycloak)"
  expect "$area" "ingress container not restarted" "$ingress_started" "$(container_started_at ingress)"
  expect "$area" "check-secrets" "pass" "$(check_secrets >/dev/null 2>&1 && echo pass || echo fail)"

  # Logs written during the run (including every failure case) must not
  # contain the credentials and tokens it used.
  local log counts value_count
  stop_idp_probe
  docker logs "$NGINX_CONTROL" > "${AUTH_WORK}/nginx-control.log" 2>&1 || true
  stop_nginx_control
  sleep 1
  value_count="$(awk -F'\t' '$2 != ""' "$values" | wc -l)"
  for service in ingress oauth2-proxy keycloak api; do
    compose logs --no-color --since "$started" "$service" > "${AUTH_WORK}/${service}.log" 2>&1 || true
  done
  for log in ingress oauth2-proxy nginx-control keycloak api; do
    counts="$(count_values "${AUTH_WORK}/${log}.log" "$values")"
    case "$log" in
      ingress | oauth2-proxy | nginx-control)
        expect "logs" "${log}: occurrences of the ${value_count} searched strings" "0" "${counts%% *}" ;;
      *)
        record "logs" "${log}: occurrences of the ${value_count} searched strings" "observe" "${counts%% *}" info ;;
    esac
    record "logs" "${log}: kinds found" "observe" "$(kinds_found "${AUTH_WORK}/${log}.log" "$values")" info
  done
  awk -F'\t' '$2 != "" {print "request: \"POST /token?client_secret=" $2 " HTTP/1.1\""}' "$values" > "${AUTH_WORK}/synthetic.log"
  counts="$(count_values "${AUTH_WORK}/synthetic.log" "$values")"
  expect "positive control" "scanner finds each searched string in a synthetic log" "$value_count" "${counts#* }"
  expect "positive control" "ingress log holds this run's diagnostic TLS reasons" "yes" \
    "$(grep -q 'upstream SSL certificate verify error' "${AUTH_WORK}/ingress.log" && echo yes || echo no)"

  # Nothing recorded may contain a secret value.
  local joined
  joined="$(printf '%s\n' "${RESULTS[@]}")"
  for name in "${SOURCE_SECRETS[@]}"; do
    if grep -qFf <(secret "$name") <<< "$joined"; then
      die "a recorded result contains the value of ${name}; no evidence written"
    fi
  done
  record "$area" "secret values in recorded results" "observe" "none (${#SOURCE_SECRETS[@]} secrets searched)" info

  [[ -n "$evidence_file" ]] && write_auth_evidence "$evidence_file" "$started" \
    "verify-keycloak-tls: ingress to Keycloak over TLS with the identity-provider CA. Baseline (listeners, plaintext refusal, CA separation, public metadata and redirects, sign-in, machine token, sign-out), passive capture of the hop, control nginx variants (session reuse, keep-alive, another dialed name, verification off), failure cases (untrusted CA, lab CA, name outside the CA's constraints, expired, excluded subdomain, excluded IP address) with new versus established connections, saved-session resumption, and recovery by renewal without restarts; an isolated control in which the same nginx verifier accepts the keycloak-plus-IP certificate from an unconstrained CA; renewal; log search. Scripted clients only."
  finish_checks "Keycloak TLS verification"
}

destroy_lab() {
  compose --profile tools down -v --remove-orphans
  docker network rm "$PROBE_NETWORK" >/dev/null 2>&1 || true
}

purge_state() {
  [[ "${1:-}" == "--yes" ]] || die "purge-state deletes the lab CA and secrets; rerun with --yes"
  [[ -e "$STATE_DIR" ]] || { echo "Nothing to purge: ${STATE_DIR}"; return 0; }

  require_owned_state

  rm -rf --one-file-system -- "$STATE_DIR"
  echo "Deleted ${STATE_DIR}."
  echo "If you trusted the lab CA in Windows or a browser, remove it there as well (see the guide)."
}

# ---------------------------------------------------------------------------
# Verification
# ---------------------------------------------------------------------------

RESULTS=()
FAILED=0

json_string() {
  local value="${1//\\/\\\\}"
  printf '"%s"' "${value//\"/\\\"}"
}

record() {
  local vantage="$1" check="$2" expected="$3" observed="$4" result="$5"

  printf '%-4s %-22s %-48s expected=%s observed=%s\n' \
    "$(tr '[:lower:]' '[:upper:]' <<< "$result")" "$vantage" "$check" "$expected" "$observed"

  RESULTS+=("{\"vantage\":$(json_string "$vantage"),\"check\":$(json_string "$check"),\"expected\":$(json_string "$expected"),\"observed\":$(json_string "$observed"),\"result\":\"${result}\"}")

  if [[ "$result" == fail ]]; then
    FAILED=$((FAILED + 1))
  fi
}

expect() {
  local vantage="$1" check="$2" expected="$3" observed="$4"

  if [[ "$observed" == "$expected" ]]; then
    record "$vantage" "$check" "$expected" "$observed" pass
  else
    record "$vantage" "$check" "$expected" "$observed" fail
  fi
}

# Passes only when curl established no TCP connection and failed with a
# connection-level error; records the outcome, connection count, and exit code.
expect_unreachable() {
  local vantage="$1" check="$2" observed="$3"

  case "$observed" in
    "refused connects=0 "* | "timeout connects=0 "* | "unresolved connects=0 "*)
      record "$vantage" "$check" "no-connection" "$observed" pass
      ;;
    *)
      record "$vantage" "$check" "no-connection" "$observed" fail
      ;;
  esac
}

# Classify a TCP-level outcome from curl's count of established connections
# and its exit code. The count decides: exit 28 alone also occurs when the
# connection succeeded and only the application response timed out.
classify_connection() {
  local rc="$1" connects="${2:-}"

  if [[ "$connects" =~ ^[1-9][0-9]*$ ]]; then
    echo connected
    return 0
  fi

  case "$rc" in
    6) echo unresolved ;;
    7) echo refused ;;
    28) echo timeout ;;
    # Anything else is not evidence of an unreachable service.
    *) echo "unclassified-exit-${rc}" ;;
  esac
}

# Prints "<outcome> connects=<n> exit=<code>".
probe_tcp_detail() {
  local network="$1" target="$2" rc=0 connects

  connects="$(docker run --rm --network "$network" --entrypoint curl "$PROBE_IMAGE" \
    -s -o /dev/null --connect-timeout 3 --max-time 5 -w '%{num_connects}' \
    "http://${target}/" 2>/dev/null)" || rc=$?

  echo "$(classify_connection "$rc" "$connects") connects=${connects:-none} exit=${rc}"
}

# TCP reachability with curl from a container on the given network.
probe_tcp() {
  local detail
  detail="$(probe_tcp_detail "$@")"
  echo "${detail%% *}"
}

# Name resolution from a container on the given network. Unknown names are
# forwarded to the host resolver, which can take longer than a TCP timeout.
probe_dns() {
  local network="$1" name="$2" rc=0

  # Port 9 is a placeholder: only resolution matters (curl exit 6).
  docker run --rm --network "$network" --entrypoint curl "$PROBE_IMAGE" \
    -s -o /dev/null --connect-timeout 10 --max-time 12 "http://${name}:9/" \
    >/dev/null 2>&1 || rc=$?

  if [[ "$rc" -eq 6 ]]; then
    echo unresolved
  else
    echo resolved
  fi
}

probe_tcp_host_detail() {
  local target="$1" rc=0 connects

  connects="$(curl -s -o /dev/null --connect-timeout 3 --max-time 5 -w '%{num_connects}' \
    "http://${target}/" 2>/dev/null)" || rc=$?

  echo "$(classify_connection "$rc" "$connects") connects=${connects:-none} exit=${rc}"
}

probe_tcp_host() {
  local detail
  detail="$(probe_tcp_host_detail "$@")"
  echo "${detail%% *}"
}

# Start a TCP listener that completes the handshake but never responds, on
# the given host address. Prints "<pid> <port>".
start_silent_host_listener() {
  local address="$1" port_file pid port=""

  port_file="$(mktemp)"
  python3 -I -c '
import socket, sys, time
s = socket.socket()
s.bind((sys.argv[1], 0))
s.listen(4)
print(s.getsockname()[1], flush=True)
time.sleep(60)
' "$address" > "$port_file" 2>/dev/null &
  pid=$!

  local _
  for _ in $(seq 1 50); do
    port="$(cat "$port_file")"
    [[ -n "$port" ]] && break
    sleep 0.1
  done
  rm -f "$port_file"

  echo "$pid $port"
}

# Regression controls for the reachability classifier: a reachable server
# that delays its response must count as connected, and a closed port as
# refused. Without them, a timeout after a successful connection could be
# reported as isolation.
verify_probe_controls() {
  local listener="${PROJECT}-silent-listener" listener_ip

  docker run -d --rm --name "$listener" --network "$PROBE_NETWORK" \
    --entrypoint sh "$PROBE_IMAGE" \
    -c 'while :; do sleep 60 | nc -l -p 8080 >/dev/null 2>&1; done' >/dev/null
  listener_ip="$(docker inspect --format \
    "{{(index .NetworkSettings.Networks \"${PROBE_NETWORK}\").IPAddress}}" "$listener")"
  sleep 1

  local detail
  detail="$(probe_tcp_detail "$PROBE_NETWORK" "${listener_ip}:8080")"
  expect "probe control" "container: listener that never responds" "connected connects=1 exit=28" "$detail"
  detail="$(probe_tcp_detail "$PROBE_NETWORK" "${listener_ip}:8081")"
  expect "probe control" "container: closed port" "refused connects=0 exit=7" "$detail"

  docker rm -fv "$listener" >/dev/null 2>&1 || true

  if ! command -v python3 >/dev/null 2>&1; then
    record "probe control" "host: listener that never responds" "run" "python3 unavailable" skip
    return 0
  fi

  local pid port
  read -r pid port < <(start_silent_host_listener 127.0.0.1)
  detail="$(probe_tcp_host_detail "127.0.0.1:${port}")"
  expect "probe control" "wsl: listener that never responds" "connected connects=1 exit=28" "$detail"
  kill "$pid" 2>/dev/null || true
  wait "$pid" 2>/dev/null || true
}

container_ip() {
  local service="$1" network="$2" id

  id="$(compose ps -q "$service")"
  docker inspect \
    --format "{{with index .NetworkSettings.Networks \"${PROJECT}_${network}\"}}{{.IPAddress}}{{end}}" \
    "$id"
}

https_status() {
  # Prints "<http_code> <ssl_verify_result>" or "error:<curl exit>".
  local rc=0 output

  output="$(curl -sS -o /dev/null --max-time 10 \
    -w '%{http_code} %{ssl_verify_result}' "$@" 2>/dev/null)" || rc=$?

  if [[ "$rc" -ne 0 ]]; then
    echo "error:${rc}"
  else
    echo "$output"
  fi
}

verify_lab() {
  local evidence_file=""
  local base="https://${LAB_HOSTNAME}:${HTTPS_PORT}"
  local ca="${PKI_DIR}/ca.crt"

  if [[ "${1:-}" == "--evidence" ]]; then
    evidence_file="${2:?--evidence requires a file}"
  fi

  require_command curl
  [[ -f "$ca" ]] || die "lab CA missing; run: $0 init"

  local service health
  for service in "${LAB_SERVICES[@]}"; do
    health="$(docker inspect --format '{{.State.Status}}{{with .State.Health}}/{{.Status}}{{end}}' \
      "$(compose ps -q "$service")" 2>/dev/null || echo missing)"
    case "$service" in
      # Neither image ships a health-check tool.
      worker | oauth2-proxy) expect "docker" "${service} state" "running" "$health" ;;
      *) expect "docker" "${service} state" "running/healthy" "$health" ;;
    esac
  done

  local published
  published="$(
    for service in "${LAB_SERVICES[@]}"; do
      docker inspect --format \
        '{{range $port, $bindings := .NetworkSettings.Ports}}{{range $bindings}}{{$port}}->{{.HostIp}}:{{.HostPort}};{{end}}{{end}}' \
        "$(compose ps -q "$service")" | sed "s/^/${service}=/"
    done | grep -v '=$' | tr -d '\n'
  )"
  expect "docker" "published ports" "ingress=8443/tcp->127.0.0.1:${HTTPS_PORT};" "$published"

  # --- WSL host -------------------------------------------------------------
  expect "wsl" "HTTPS UI with lab CA" "200 0" "$(https_status --cacert "$ca" "${base}/")"
  expect "wsl" "HTTPS API without credentials" "401 0" "$(https_status --cacert "$ca" "${base}/api/items")"
  expect "wsl" "HTTPS issuer discovery with lab CA" "200 0" \
    "$(https_status --cacert "$ca" "${ISSUER}/.well-known/openid-configuration")"
  expect "wsl" "Keycloak admin console not routed" "404 0" \
    "$(https_status --cacert "$ca" "https://${AUTH_HOSTNAME}:${HTTPS_PORT}/admin/")"
  expect "wsl" "Keycloak master realm not routed" "404 0" \
    "$(https_status --cacert "$ca" "https://${AUTH_HOSTNAME}:${HTTPS_PORT}/realms/master/")"
  expect "wsl" "gateway auth endpoint not routed" "404 0" "$(https_status --cacert "$ca" "${base}/oauth2/auth")"
  expect "wsl" "HTTPS without lab CA (control)" "error:60" "$(https_status "${base}/")"
  expect "wsl" "TLS for unconfigured name" "error:35" \
    "$(https_status --cacert "$ca" --connect-to "other.localhost:${HTTPS_PORT}:127.0.0.1:${HTTPS_PORT}" "https://other.localhost:${HTTPS_PORT}/")"
  expect "wsl" "API health not routed" "404 0" "$(https_status --cacert "$ca" "${base}/api/health")"
  expect "wsl" "API version not routed" "404 0" "$(https_status --cacert "$ca" "${base}/api/version")"

  local port
  for port in 8080 5432 55432 5671 5672 15672; do
    expect "wsl" "127.0.0.1:${port}" "refused connects=0 exit=7" "$(probe_tcp_host_detail "127.0.0.1:${port}")"
  done

  local wsl_address
  wsl_address="$(ip -4 -o addr show eth0 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1)"
  if [[ -n "$wsl_address" ]]; then
    expect_unreachable "wsl" "WSL eth0 ${wsl_address}:${HTTPS_PORT}" "$(probe_tcp_host_detail "${wsl_address}:${HTTPS_PORT}")"
  fi

  local api_ip postgres_ip rabbitmq_ip ingress_edge_ip keycloak_ip keycloak_postgres_ip valkey_ip oauth2_proxy_ip
  api_ip="$(container_ip api app)"
  postgres_ip="$(container_ip postgres data)"
  rabbitmq_ip="$(container_ip rabbitmq data)"
  ingress_edge_ip="$(container_ip ingress edge)"
  keycloak_ip="$(container_ip keycloak idp)"
  keycloak_postgres_ip="$(container_ip keycloak-postgres idp-data)"
  valkey_ip="$(container_ip valkey session)"
  oauth2_proxy_ip="$(container_ip oauth2-proxy app)"

  expect_unreachable "wsl" "api container IP :8080" "$(probe_tcp_host_detail "${api_ip}:8080")"
  expect_unreachable "wsl" "postgres container IP :5432" "$(probe_tcp_host_detail "${postgres_ip}:5432")"
  expect_unreachable "wsl" "rabbitmq container IP :5671" "$(probe_tcp_host_detail "${rabbitmq_ip}:5671")"

  # --- Windows host through WSL interop ------------------------------------
  local curl_exe=""
  curl_exe="$(command -v curl.exe 2>/dev/null || true)"
  if [[ -z "$curl_exe" && -x /mnt/c/Windows/System32/curl.exe ]]; then
    curl_exe=/mnt/c/Windows/System32/curl.exe
  fi

  if [[ -n "$curl_exe" ]] && command -v wslpath >/dev/null 2>&1; then
    local windows_ca rc output
    windows_ca="$(wslpath -w "$ca")"

    windows_https() {
      local rc=0 output
      output="$("$curl_exe" -sS -o NUL --max-time 10 -w '%{http_code}' "$@" 2>/dev/null)" || rc=$?
      if [[ "$rc" -ne 0 ]]; then echo "error:${rc}"; else echo "$output"; fi
    }

    windows_tcp_detail() {
      local rc=0 connects
      connects="$("$curl_exe" -s -o NUL --connect-timeout 3 --max-time 5 -w '%{num_connects}' \
        "http://$1/" 2>/dev/null | tr -d '\r')" || rc=$?
      echo "$(classify_connection "$rc" "$connects") connects=${connects:-none} exit=${rc}"
    }

    windows_tcp() {
      local detail
      detail="$(windows_tcp_detail "$1")"
      echo "${detail%% *}"
    }

    # Classifier control from Windows: a WSL listener that accepts but never
    # responds, reachable from Windows through the WSL NAT address.
    if [[ -n "$wsl_address" ]] && command -v python3 >/dev/null 2>&1; then
      local listener_pid listener_port
      read -r listener_pid listener_port < <(start_silent_host_listener "$wsl_address")
      expect "probe control" "windows: listener that never responds" "connected connects=1 exit=28" \
        "$(windows_tcp_detail "${wsl_address}:${listener_port}")"
      kill "$listener_pid" 2>/dev/null || true
      wait "$listener_pid" 2>/dev/null || true
    fi

    # Schannel cannot check revocation for a private CA without a CRL; only
    # revocation checking is relaxed, chain and name verification are not.
    expect "windows-curl" "HTTPS UI with lab CA" "200" \
      "$(windows_https --cacert "$windows_ca" --ssl-revoke-best-effort "${base}/")"
    expect "windows-curl" "HTTPS API without credentials" "401" \
      "$(windows_https --cacert "$windows_ca" --ssl-revoke-best-effort "${base}/api/items")"
    # The negative control is only meaningful while Windows does not trust
    # the lab CA itself, for example after the manual browser check.
    local thumbprint windows_trust
    thumbprint="$(openssl x509 -noout -fingerprint -sha1 -in "$ca" | cut -d= -f2 | tr -d ':')"
    windows_trust="$(
      powershell.exe -NoProfile -Command \
        "@(Get-ChildItem Cert:\\CurrentUser\\Root, Cert:\\LocalMachine\\Root | Where-Object Thumbprint -eq '${thumbprint}').Count" \
        2>/dev/null | tr -d '\r\n'
    )"

    if [[ "$windows_trust" == 0 ]]; then
      record "windows" "lab CA in Windows trust stores" "observe" "not trusted" info
      expect "windows-curl" "HTTPS without lab CA (control)" "error:60" \
        "$(windows_https --ssl-revoke-best-effort "${base}/")"
    else
      record "windows" "lab CA in Windows trust stores" "observe" "trusted (${windows_trust:-unknown})" info
      record "windows-curl" "HTTPS without lab CA (control)" "run" \
        "not meaningful: Windows trusts the lab CA" skip
    fi

    for port in 8080 5432 55432 5671 5672 15672; do
      expect "windows-curl" "127.0.0.1:${port}" "refused connects=0 exit=7" "$(windows_tcp_detail "127.0.0.1:${port}")"
    done

    local windows_addresses address
    windows_addresses="$(
      powershell.exe -NoProfile -Command \
        "Get-NetIPAddress -AddressFamily IPv4 | Where-Object { \$_.IPAddress -notlike '127.*' -and \$_.IPAddress -notlike '169.254.*' } | ForEach-Object { \$_.IPAddress }" \
        2>/dev/null | tr -d '\r'
    )"
    for address in $windows_addresses; do
      expect_unreachable "windows-curl" "Windows ${address}:${HTTPS_PORT}" "$(windows_tcp_detail "${address}:${HTTPS_PORT}")"
    done

    local listeners
    listeners="$(
      powershell.exe -NoProfile -Command \
        "Get-NetTCPConnection -State Listen -LocalPort ${HTTPS_PORT},8080,5432,55432,5671,5672,15672 -ErrorAction SilentlyContinue | ForEach-Object { \"\$(\$_.LocalAddress):\$(\$_.LocalPort)\" } | Sort-Object -Unique" \
        2>/dev/null | tr -d '\r' | tr '\n' ';'
    )"
    expect "windows" "listening sockets on lab ports" "127.0.0.1:${HTTPS_PORT};" "$listeners"
  else
    record "windows-curl" "Windows checks" "run" "curl.exe unavailable" skip
  fi

  # --- Containers -------------------------------------------------------------
  docker network inspect "$PROBE_NETWORK" >/dev/null 2>&1 ||
    docker network create "$PROBE_NETWORK" >/dev/null

  verify_probe_controls

  local edge="${PROJECT}_edge"
  local edge_https_status rc
  rc=0
  edge_https_status="$(
    docker run --rm --network "$edge" -v "${ca}:/lab-ca.crt:ro" --entrypoint curl "$PROBE_IMAGE" \
      -sS -o /dev/null --max-time 10 -w '%{http_code} %{ssl_verify_result}' \
      --cacert /lab-ca.crt \
      --connect-to "${LAB_HOSTNAME}:8443:ingress:8443" \
      "https://${LAB_HOSTNAME}:8443/api/items" 2>/dev/null
  )" || rc=$?
  [[ "$rc" -eq 0 ]] || edge_https_status="error:${rc}"
  expect "edge-network client" "HTTPS API via ingress without credentials" "401 0" "$edge_https_status"
  expect "edge-network client" "resolve api" "unresolved" "$(probe_dns "$edge" api)"
  expect "edge-network client" "resolve postgres" "unresolved" "$(probe_dns "$edge" postgres)"
  expect "edge-network client" "resolve keycloak" "unresolved" "$(probe_dns "$edge" keycloak)"
  expect "edge-network client" "resolve oauth2-proxy" "unresolved" "$(probe_dns "$edge" oauth2-proxy)"
  expect "edge-network client" "resolve valkey" "unresolved" "$(probe_dns "$edge" valkey)"
  expect_unreachable "edge-network client" "keycloak container IP :8443" "$(probe_tcp_detail "$edge" "${keycloak_ip}:8443")"
  expect_unreachable "edge-network client" "valkey container IP :6379" "$(probe_tcp_detail "$edge" "${valkey_ip}:6379")"

  # The API's network reaches the gateway but not the identity provider or
  # the session store directly.
  expect "app-network client" "resolve valkey" "unresolved" "$(probe_dns "${PROJECT}_app" valkey)"
  expect "app-network client" "resolve keycloak" "unresolved" "$(probe_dns "${PROJECT}_app" keycloak)"
  expect_unreachable "app-network client" "valkey container IP :6379" "$(probe_tcp_detail "${PROJECT}_app" "${valkey_ip}:6379")"
  expect_unreachable "app-network client" "keycloak container IP :8443" "$(probe_tcp_detail "${PROJECT}_app" "${keycloak_ip}:8443")"
  expect_unreachable "app-network client" "keycloak-postgres container IP :5432" \
    "$(probe_tcp_detail "${PROJECT}_app" "${keycloak_postgres_ip}:5432")"
  expect_unreachable "edge-network client" "api container IP :8080" "$(probe_tcp_detail "$edge" "${api_ip}:8080")"
  expect_unreachable "edge-network client" "postgres container IP :5432" "$(probe_tcp_detail "$edge" "${postgres_ip}:5432")"
  expect_unreachable "edge-network client" "rabbitmq container IP :5671" "$(probe_tcp_detail "$edge" "${rabbitmq_ip}:5671")"

  expect "unrelated container" "resolve api" "unresolved" "$(probe_dns "$PROBE_NETWORK" api)"
  expect_unreachable "unrelated container" "api container IP :8080" "$(probe_tcp_detail "$PROBE_NETWORK" "${api_ip}:8080")"
  expect_unreachable "unrelated container" "postgres container IP :5432" "$(probe_tcp_detail "$PROBE_NETWORK" "${postgres_ip}:5432")"
  expect_unreachable "unrelated container" "rabbitmq container IP :5671" "$(probe_tcp_detail "$PROBE_NETWORK" "${rabbitmq_ip}:5671")"
  expect_unreachable "unrelated container" "keycloak container IP :8443" "$(probe_tcp_detail "$PROBE_NETWORK" "${keycloak_ip}:8443")"
  expect_unreachable "unrelated container" "valkey container IP :6379" "$(probe_tcp_detail "$PROBE_NETWORK" "${valkey_ip}:6379")"
  expect_unreachable "unrelated container" "oauth2-proxy container IP :4180" "$(probe_tcp_detail "$PROBE_NETWORK" "${oauth2_proxy_ip}:4180")"
  expect_unreachable "default-bridge container" "api container IP :8080" "$(probe_tcp_detail bridge "${api_ip}:8080")"
  expect_unreachable "default-bridge container" "postgres container IP :5432" "$(probe_tcp_detail bridge "${postgres_ip}:5432")"

  # Observed, not asserted: Docker forwards a published port to the
  # container from any network on the same engine, even when the host
  # binding is loopback-only, and Docker Desktop also exposes the loopback
  # publication through host.docker.internal. The ingress is the intended
  # entry point, so this widens who can reach it, not what is reachable.
  record "unrelated container" "ingress edge IP :8443" "observe" \
    "$(probe_tcp_detail "$PROBE_NETWORK" "${ingress_edge_ip}:8443")" info
  record "unrelated container" "ingress edge IP :8081 (health)" "observe" \
    "$(probe_tcp_detail "$PROBE_NETWORK" "${ingress_edge_ip}:8081")" info
  record "unrelated container" "host.docker.internal:${HTTPS_PORT}" "observe" \
    "$(probe_tcp_detail "$PROBE_NETWORK" "host.docker.internal:${HTTPS_PORT}")" info

  # Positive controls: the same probe reaches each backend from its own
  # network, so the refusals above are not caused by stopped services.
  expect "app-network control" "resolve api" "resolved" "$(probe_dns "${PROJECT}_app" api)"
  expect "app-network control" "api:8080" "connected" "$(probe_tcp "${PROJECT}_app" "api:8080")"
  expect "data-network control" "postgres:5432" "connected" "$(probe_tcp "${PROJECT}_data" "postgres:5432")"
  expect "data-network control" "rabbitmq:5671" "connected" "$(probe_tcp "${PROJECT}_data" "rabbitmq:5671")"
  # ADR 0006: RabbitMQ has no plaintext listener, even on its own network.
  expect "data-network client" "rabbitmq:5672 (plaintext AMQP)" "refused connects=0 exit=7" \
    "$(probe_tcp_detail "${PROJECT}_data" "rabbitmq:5672")"
  expect "app-network control" "oauth2-proxy:4180" "connected" "$(probe_tcp "${PROJECT}_app" "oauth2-proxy:4180")"
  expect "idp-network control" "keycloak:8443" "connected" "$(probe_tcp "${PROJECT}_idp" "keycloak:8443")"
  # ADR 0007: Keycloak has no plaintext listener, even on its own network,
  # and its management interface is bound to its loopback.
  expect "idp-network client" "keycloak:8080 (plaintext HTTP)" "refused connects=0 exit=7" \
    "$(probe_tcp_detail "${PROJECT}_idp" "keycloak:8080")"
  expect "idp-network client" "keycloak:9000 (management)" "refused connects=0 exit=7" \
    "$(probe_tcp_detail "${PROJECT}_idp" "keycloak:9000")"
  expect "session-network control" "valkey:6379" "connected" "$(probe_tcp "${PROJECT}_session" "valkey:6379")"
  expect "idp-data-network control" "keycloak-postgres:5432" "connected" \
    "$(probe_tcp "${PROJECT}_idp-data" "keycloak-postgres:5432")"

  local ingress_to_api
  ingress_to_api="$(compose exec -T ingress wget -q -O - http://api:8080/health 2>/dev/null | tr -d '\n' || true)"
  expect "ingress container" "http://api:8080/health" '{"status":"healthy"}' "$ingress_to_api"

  docker network rm "$PROBE_NETWORK" >/dev/null 2>&1 || true

  if [[ -n "$evidence_file" ]]; then
    {
      printf '{\n  "project": "%s",\n  "host": "%s",\n  "https_port": %s,\n' "$PROJECT" "$LAB_HOSTNAME" "$HTTPS_PORT"
      printf '  "recorded_at": "%s",\n  "results": [\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
      local index
      for index in "${!RESULTS[@]}"; do
        printf '    %s' "${RESULTS[$index]}"
        [[ "$index" -lt $(( ${#RESULTS[@]} - 1 )) ]] && printf ','
        printf '\n'
      done
      printf '  ]\n}\n'
    } > "$evidence_file"
    echo "Evidence written: ${evidence_file}"
  fi

  echo
  if [[ "$FAILED" -ne 0 ]]; then
    echo "Security lab verification failed: ${FAILED} check(s)." >&2
    return 1
  fi
  echo "Security lab verification passed (${#RESULTS[@]} checks)."
}

# Each missing-secret case must fail before the service starts serving, with
# an error that names the missing input and contains no secret value.
verify_failures() {
  local failures=0 output rc evidence_file=""
  local -a failure_results=()

  if [[ "${1:-}" == "--evidence" ]]; then
    evidence_file="${2:?--evidence requires a file}"
  fi

  check_failure() {
    local name="$1" expected_message="$2"
    shift 2

    rc=0
    output="$("$@" 2>&1)" || rc=$?

    local leaked=""
    local secret_name
    for secret_name in "${SOURCE_SECRETS[@]}"; do
      if [[ -s "${SECRETS_DIR}/${secret_name}" ]] &&
         grep -qFf <(secret "$secret_name") <<< "$output"; then
        leaked="$secret_name"
      fi
    done

    local result=fail
    if [[ "$rc" -ne 0 ]] && grep -qF -- "$expected_message" <<< "$output" && [[ -z "$leaked" ]]; then
      result=pass
      printf 'PASS %-44s exit=%s message="%s"\n' "$name" "$rc" "$expected_message"
    else
      printf 'FAIL %-44s exit=%s leaked=%s\n%s\n' "$name" "$rc" "${leaked:-none}" "$output"
      failures=$((failures + 1))
    fi

    # The temporary preflight path varies per run; record a stable form.
    local stable_message="${expected_message/#required secret file missing: *\//required secret file missing: <state>/secrets/}"
    if [[ -n "${partial:-}" ]]; then
      stable_message="${stable_message//"$partial"/<state>}"
    fi
    failure_results+=("{\"case\":$(json_string "$name"),\"exit_code\":${rc},\"expected_message\":$(json_string "$stable_message"),\"secret_value_in_output\":$([[ -n "$leaked" ]] && echo true || echo false),\"result\":\"${result}\"}")
  }

  # Preflight against a copy of the state with one secret file removed.
  local partial
  partial="$(mktemp -d)"
  mkdir -m 700 "${partial}/secrets" "${partial}/pki"
  cp -p "${SECRETS_DIR}"/* "${partial}/secrets/"
  cp -p "${PKI_DIR}/ca.crt" "${PKI_DIR}/internal-ca.crt" "${PKI_DIR}/idp-ca.crt" "${partial}/pki/"
  cp -a "$INGRESS_TLS_DIR" "$INTERNAL_TLS_DIR" "$IDP_TLS_DIR" "${partial}/"
  rm -f "${partial}/secrets/api-database-url"

  check_failure "preflight: missing api-database-url" \
    "required secret file missing: ${partial}/secrets/api-database-url" \
    env ZTP_SECURITY_LAB_STATE_DIR="$partial" "${BASH_SOURCE[0]}" check-secrets

  # ADR 0006: a missing internal server certificate, and a connection URL
  # that does not require verified TLS, stop the lab before it starts.
  cp -p "${SECRETS_DIR}/api-database-url" "${partial}/secrets/"
  rm -f "${partial}/internal-tls/postgres/tls.pem"
  check_failure "preflight: missing PostgreSQL TLS file" \
    "required internal TLS file missing or empty: ${partial}/internal-tls/postgres/tls.pem" \
    env ZTP_SECURITY_LAB_STATE_DIR="$partial" "${BASH_SOURCE[0]}" check-secrets
  cp -p "${INTERNAL_TLS_DIR}/postgres/tls.pem" "${partial}/internal-tls/postgres/"

  sed -i 's/sslmode=verify-full&sslrootcert=[^&]*$/sslmode=disable/' "${partial}/secrets/worker-database-url"
  sed -i 's#^amqps://\(.*\)@rabbitmq:5671/\([^?]*\)?.*$#amqp://\1@rabbitmq:5672/\2#' "${partial}/secrets/api-rabbitmq-url"
  check_failure "preflight: plaintext database URL" \
    "worker-database-url does not require verified TLS" \
    env ZTP_SECURITY_LAB_STATE_DIR="$partial" "${BASH_SOURCE[0]}" check-secrets
  check_failure "preflight: plaintext AMQP URL" \
    "api-rabbitmq-url does not require verified TLS" \
    env ZTP_SECURITY_LAB_STATE_DIR="$partial" "${BASH_SOURCE[0]}" check-secrets

  # ADR 0007: a missing Keycloak certificate, and a Keycloak configuration
  # with the plaintext listener, stop the lab before it starts.
  rm -f "${partial}/idp-tls/tls.pem"
  check_failure "preflight: missing Keycloak TLS file" \
    "required identity-provider TLS file missing or empty: ${partial}/idp-tls/tls.pem" \
    env ZTP_SECURITY_LAB_STATE_DIR="$partial" "${BASH_SOURCE[0]}" check-secrets
  sed -i 's/^http-enabled=false$/http-enabled=true/' "${partial}/secrets/keycloak.conf"
  check_failure "preflight: plaintext Keycloak configuration" \
    "keycloak.conf does not restrict Keycloak to HTTPS" \
    env ZTP_SECURITY_LAB_STATE_DIR="$partial" "${BASH_SOURCE[0]}" check-secrets

  # The containers themselves refuse to start without their TLS inputs. The
  # Keycloak case mounts the lab's configuration (with its database
  # password) and an empty TLS directory, without a network.
  local empty_tls
  empty_tls="$(mktemp -d)"
  chmod 711 "$empty_tls"
  check_failure "keycloak: TLS file missing" "Unable to read file /run/keycloak-tls/tls.pem" \
    docker run --rm --network none \
      -v "${SECRETS_DIR}/keycloak.conf:/opt/keycloak/conf/keycloak.conf:ro" \
      -v "${empty_tls}:/run/keycloak-tls:ro" \
      quay.io/keycloak/keycloak:26.8.0@sha256:27b3230fbabb8c9ff3c66c864cf09dcd8a41aca82e5100679d109ef0eeb05741 start
  rm -rf "$empty_tls"
  check_failure "ingress: identity-provider CA missing" 'cannot load certificate "/run/idp-ca/ca.crt"' \
    docker run --rm --network none --add-host api:127.0.0.1 \
      --read-only --tmpfs /tmp --tmpfs /var/cache/nginx \
      -v "${INGRESS_TLS_DIR}:/run/ingress-tls:ro" \
      --user 101:101 zero-to-prod-security-lab-ingress:local

  rm -rf "$partial"

  check_failure "postgres: TLS file missing" "PostgreSQL TLS file missing or empty" \
    docker run --rm --network none \
      -v "${ROOT_DIR}/infra/security-lab/postgres/tls.sh:/opt/zero-to-prod/tls.sh:ro" \
      --entrypoint /opt/zero-to-prod/tls.sh "$POSTGRES_IMAGE" postgres

  check_failure "api: DATABASE_URL_FILE missing" "read DATABASE_URL_FILE" \
    compose run --rm --no-deps -e DATABASE_URL_FILE=/run/secrets/absent api
  check_failure "api: Compose directory artifact" "is a directory" \
    compose run --rm --no-deps -e DATABASE_URL_FILE=/run api
  check_failure "api: RABBITMQ_PUBLISHER_URL_FILE missing" "read RABBITMQ_PUBLISHER_URL_FILE" \
    compose run --rm --no-deps -e RABBITMQ_PUBLISHER_URL_FILE=/run/secrets/absent api
  check_failure "api: AUTHENTICATION unset" "AUTHENTICATION is required" \
    compose run --rm --no-deps -e AUTHENTICATION= api
  check_failure "api: OIDC_CA_FILE missing" "read OIDC_CA_FILE" \
    compose run --rm --no-deps -e OIDC_CA_FILE=/run/secrets/absent api
  check_failure "worker: DATABASE_URL_FILE missing" "read DATABASE_URL_FILE" \
    compose run --rm --no-deps -e DATABASE_URL_FILE=/run/secrets/absent worker
  check_failure "worker: RABBITMQ_WORKER_URL_FILE missing" "read RABBITMQ_WORKER_URL_FILE" \
    compose run --rm --no-deps -e RABBITMQ_WORKER_URL_FILE=/run/secrets/absent worker
  check_failure "ingress: TLS key and certificate missing" 'cannot load certificate "/run/ingress-tls/tls.pem"' \
    docker run --rm --network none --add-host api:127.0.0.1 \
      --read-only --tmpfs /tmp --tmpfs /var/cache/nginx \
      --user 101:101 zero-to-prod-security-lab-ingress:local
  check_failure "postgres: admin password file missing" "/run/secrets/absent" \
    docker run --rm --network none \
      -e POSTGRES_PASSWORD_FILE=/run/secrets/absent \
      postgres:18.6-alpine3.24@sha256:77f585114c32fbca283dc835b0596f4e52b51b4c6662d7810b2f4084f60a1873

  if [[ -n "$evidence_file" ]]; then
    {
      printf '{\n  "project": "%s",\n  "recorded_at": "%s",\n  "results": [\n' \
        "$PROJECT" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
      local index
      for index in "${!failure_results[@]}"; do
        printf '    %s' "${failure_results[$index]}"
        [[ "$index" -lt $(( ${#failure_results[@]} - 1 )) ]] && printf ','
        printf '\n'
      done
      printf '  ]\n}\n'
    } > "$evidence_file"
    echo "Evidence written: ${evidence_file}"
  fi

  if [[ "$failures" -ne 0 ]]; then
    echo "Missing-secret verification failed: ${failures} case(s)." >&2
    return 1
  fi
  echo "Missing-secret verification passed."
}

# ---------------------------------------------------------------------------
# Authentication verification
# ---------------------------------------------------------------------------

AUTH_WORK=""

lab_curl() {
  curl -sS --cacert "${PKI_DIR}/ca.crt" --max-time 20 "$@"
}

# HTTP status of a request, or error:<curl exit>.
http_status() {
  local rc=0 output
  output="$(lab_curl -o /dev/null -w '%{http_code}' "$@" 2>/dev/null)" || rc=$?
  if [[ "$rc" -ne 0 ]]; then echo "error:${rc}"; else echo "$output"; fi
}

# "<status> <body without newlines>" for a request.
http_status_body() {
  local rc=0 output
  output="$(lab_curl -w '\n%{http_code}' "$@" 2>/dev/null)" || rc=$?
  if [[ "$rc" -ne 0 ]]; then echo "error:${rc}"; return 0; fi
  echo "$(tail -n 1 <<< "$output") $(sed '$d' <<< "$output" | tr -d '\n')"
}

json_field() {
  python3 -I -c '
import json, sys
try:
    value = json.load(sys.stdin)
    for key in sys.argv[1].split("."):
        value = value[int(key)] if isinstance(value, list) else value.get(key, "")
    print(value)
except Exception:
    print("")
' "$1"
}

# Claims of a JWT, summarized without the token or personal identifiers.
token_claims() {
  python3 -I -c '
import base64, json, sys, time
token = sys.stdin.read().strip()
parts = token.split(".")
if len(parts) != 3:
    print("not-a-jwt"); sys.exit(0)
c = json.loads(base64.urlsafe_b64decode(parts[1] + "=" * (-len(parts[1]) % 4)))
h = json.loads(base64.urlsafe_b64decode(parts[0] + "=" * (-len(parts[0]) % 4)))
aud = c.get("aud")
aud = sorted(aud) if isinstance(aud, list) else ([aud] if aud else [])
out = {"alg": h.get("alg"), "iss": c.get("iss"), "aud": ",".join(aud), "azp": c.get("azp"),
       "typ": c.get("typ"), "lifetime": c.get("exp", 0) - c.get("iat", 0),
       "exp": c.get("exp", 0), "expires_in": int(c.get("exp", 0) - time.time())}
print(" ".join(f"{k}={out[k]}" for k in sys.argv[1].split(",")))
' "$1"
}

token_exp() {
  token_claims exp <<< "$1" | cut -d= -f2
}

# Variants of a token for negative tests: a changed payload under the
# original signature, and an unsigned ("alg":"none") token.
token_variant() {
  python3 -I -c '
import base64, json, sys
kind, token = sys.argv[1], sys.stdin.read().strip()
h64, p64, s64 = token.split(".")
def dec(s): return json.loads(base64.urlsafe_b64decode(s + "=" * (-len(s) % 4)))
def enc(o): return base64.urlsafe_b64encode(json.dumps(o, separators=(",", ":")).encode()).rstrip(b"=").decode()
payload = dec(p64)
if kind == "tampered":
    payload["sub"] = "someone-else"
    print(h64 + "." + enc(payload) + "." + s64)
elif kind == "none":
    header = dec(h64); header["alg"] = "none"
    print(enc(header) + "." + p64 + ".")
elif kind == "elevate":
    access = payload.setdefault("resource_access", {}).setdefault("work-items-api", {})
    access["roles"] = sorted(set(access.get("roles", [])) | {"items.create"})
    print(h64 + "." + enc(payload) + "." + s64)
' "$1"
}

# Credentials never appear in a process's arguments or environment: they
# reach curl as a config read from standard input (curl -K -), written by
# printf, a shell builtin. This prints one config line with its value quoted.
curl_config() {
  local value="${2//\\/\\\\}"
  value="${value//\"/\\\"}"
  printf '%s = "%s"\n' "$1" "$value"
}

# The machine client's token endpoint response (JSON), or nothing on failure.
client_credentials_response() {
  local scope="${1:-}"
  local args=(-d grant_type=client_credentials)
  [[ -n "$scope" ]] && args+=(-d "scope=${scope}")
  curl_config user "work-items-automation:$(secret automation-client-secret)" \
    | lab_curl -K - "${args[@]}" "${ISSUER}/protocol/openid-connect/token" 2>/dev/null || true
}

client_credentials() {
  local field="${1:-access_token}" scope="${2:-}"
  client_credentials_response "$scope" | json_field "$field"
}

# Permissions the work-items-automation client is configured to hold.
MACHINE_EXPECTED_PERMISSIONS=(items.read items.process)

# Reads a client-credentials token response on standard input and warns
# when the access token lacks the machine client's expected permissions.
# It reports only what the token shows: a missing permission can come from
# realm configuration, a changed role mapping, or a failed token request,
# so it recommends verify-realm rather than concluding a cause. Prints
# nothing when every expected permission is present.
check_machine_permissions() {
  local missing
  missing="$(python3 -I -c '
import base64, json, sys
expected = sys.argv[1:]
try:
    token = json.loads(sys.stdin.read() or "{}").get("access_token", "")
    payload = token.split(".")[1]
    claims = json.loads(base64.urlsafe_b64decode(payload + "=" * (-len(payload) % 4)))
except Exception:
    print("unreadable"); sys.exit(0)
# Same rules as the API (internal/authz): only
# resource_access["work-items-api"].roles counts, and any malformed shape,
# including a single non-string entry, grants no permissions at all.
roles, malformed = [], False
access = claims.get("resource_access")
if access is not None:
    if not isinstance(access, dict):
        malformed = True
    elif "work-items-api" in access:
        entry = access["work-items-api"]
        if not isinstance(entry, dict):
            malformed = True
        elif "roles" in entry:
            listed = entry["roles"]
            if not isinstance(listed, list) or any(not isinstance(r, str) for r in listed):
                malformed = True
            else:
                roles = listed
missing = " ".join(p for p in expected if p not in roles)
print(("malformed " + missing) if malformed else missing)
' "${MACHINE_EXPECTED_PERMISSIONS[@]}")"
  [[ -z "$missing" ]] && return 0
  echo >&2
  if [[ "$missing" == unreadable ]]; then
    echo "warning: no readable work-items-automation access token was obtained, so its" >&2
    echo "         permissions could not be checked." >&2
  else
    if [[ "$missing" == malformed* ]]; then
      missing="${missing#malformed }"
      echo "warning: the work-items-automation access token's work-items-api role data is" >&2
      echo "         malformed, so it grants no permissions." >&2
    fi
    echo "warning: the work-items-automation access token lacks: ${missing// /, }." >&2
    echo "         Its requests that need these permissions will be refused (403)." >&2
  fi
  echo "         To inspect the realm's authorization configuration, run: $0 verify-realm" >&2
}

# Config line carrying a bearer token, for: bearer_header "$token" | <curl wrapper> -K - ...
bearer_header() {
  curl_config header "Authorization: Bearer $1"
}

bearer_status() {
  local token="$1"; shift
  bearer_header "$token" | http_status -K - "$@"
}

# Scripted browser sign-in: follow the gateway to Keycloak's login form and
# submit it. Prints the final page.
browser_login() {
  # $2: lab-user (default), lab-viewer, or lab-outsider; the password is in
  # the matching <user>-password secret file.
  local jar="$1" user="${2:-lab-user}" page action
  page="$(lab_curl -L -c "$jar" -b "$jar" "${APP_URL}/oauth2/start?rd=%2F" 2>/dev/null || true)"
  action="$(grep -o 'id="kc-form-login"[^>]*action="[^"]*"' <<< "$page" | sed 's/.*action="//; s/"$//; s/&amp;/\&/g' || true)"
  if [[ -z "$action" ]]; then
    echo "no-login-form"
    return 0
  fi
  # The login action URL carries Keycloak's session code; it goes in the
  # config with the password.
  { curl_config url "$action"; curl_config data-urlencode "password=$(secret "${user}-password")"; } \
    | lab_curl -K - -L -c "$jar" -b "$jar" \
        --data-urlencode "username=${user}" --data "credentialId=" 2>/dev/null || true
}

# Whether starting a new sign-in with this browser's cookies shows Keycloak's
# login form (no identity-provider session) or completes silently (an active
# identity-provider session).
idp_session_state() {
  local jar="$1" probe page
  probe="${jar}.probe"
  cp "$jar" "$probe"
  page="$(lab_curl -L -c "$probe" -b "$probe" "${APP_URL}/oauth2/start?rd=%2F" 2>/dev/null || true)"
  rm -f "$probe"
  if grep -q 'id="kc-form-login"' <<< "$page"; then echo "login-form"; else echo "silent-sign-in"; fi
}

session_cookie() {
  awk '$6 == "__Host-wi-session" {print $7}' "$1" | tail -n 1
}

# Short digest of the session cookie, for comparison only.
cookie_digest() {
  local value
  value="$(session_cookie "$1")"
  [[ -n "$value" ]] || { echo ""; return 0; }
  printf '%s' "$value" | sha256sum | cut -c1-16
}

# The signed issue time in an oauth2-proxy cookie value (value|time|signature);
# not secret. Empty if the format differs.
cookie_issued_at() {
  session_cookie "$1" | awk -F'|' 'NF == 3 && $2 ~ /^[0-9]+$/ {print $2}'
}

# Attributes of a Set-Cookie header in a fixed order, without its value.
set_cookie_attributes() {
  local header="$1" attribute out=()
  for attribute in 'Path=/' HttpOnly Secure 'SameSite=Lax'; do
    grep -qiE "; *${attribute}( *;|$)" <<< "$header" && out+=("$attribute")
  done
  out+=("$(grep -oiE 'Max-Age=[0-9]+' <<< "$header" | head -n 1)")
  echo "${out[*]}"
}

# The access token a session forwards, read from oauth2-proxy by a probe on
# the internal app network. This is test instrumentation standing in for an
# access token captured downstream of the gateway; no public route exposes it.
session_access_token() {
  local cookie
  cookie="$(session_cookie "$1")"
  [[ -n "$cookie" ]] || { echo ""; return 0; }
  # The cookie reaches the probe's curl on standard input, not as an argument
  # of docker or curl.
  curl_config header "Cookie: __Host-wi-session=${cookie}" \
    | docker run --rm -i --network "${PROJECT}_app" --entrypoint curl "$PROBE_IMAGE" \
        -sS -o /dev/null -D - --max-time 10 -K - -H "X-Forwarded-Proto: https" \
        -H "X-Forwarded-Host: ${LAB_HOSTNAME}:${HTTPS_PORT}" \
        http://oauth2-proxy:4180/oauth2/auth 2>/dev/null \
    | tr -d '\r' | awk 'tolower($1) == "x-auth-request-access-token:" {print $2}' || true
}

# Requests a browser session would make. The UI sends the CSRF header and,
# being same-origin, an Origin header and Sec-Fetch-Site: same-origin.
ui_headers=()
set_ui_headers() {
  ui_headers=(-H "X-Requested-With: work-items-web" -H "Origin: ${APP_URL}" -H "Sec-Fetch-Site: same-origin")
}

session_status() {
  local jar="$1"; shift
  http_status -b "$jar" "$@"
}

wait_for_issuer() {
  local _
  for _ in $(seq 1 60); do
    [[ "$(http_status "${ISSUER}/.well-known/openid-configuration")" == 200 ]] && return 0
    sleep 2
  done
  return 1
}

sleep_until() {
  local remaining=$(( $1 - $(date +%s) ))
  if [[ "$remaining" -gt 0 ]]; then
    echo "  waiting ${remaining}s..."
    sleep "$remaining"
  fi
}

# Rejection categories the API logged since a timestamp.
api_categories_since() {
  compose logs --no-color --since "$1" api 2>/dev/null \
    | grep -o 'authentication rejected: category=[a-z_]*' | sed 's/.*=//' | sort | uniq -c \
    | awk '{printf "%s%s=%s", (n++ ? " " : ""), $2, $1}'
}

# Start a stopped service's existing container. Recreating it would discard
# the log output that the checks read back.
restore_service() {
  compose up -d --wait --no-recreate "$1" >/dev/null 2>&1 || die "could not restore ${1}"
}

auth_work_items() {
  local area="$1" mode="$2" credential="$3" created item_id job job_id state status

  if [[ "$mode" == bearer ]]; then
    created="$(bearer_header "${credential}" | http_status_body -K - -H "Content-Type: application/json" \
      -d "{\"title\":\"${area} item\"}" "${APP_URL}/api/items")"
  else
    created="$(http_status_body -b "$credential" "${ui_headers[@]}" -H "Content-Type: application/json" \
      -d "{\"title\":\"${area} item\"}" "${APP_URL}/api/items")"
  fi
  expect "$area" "POST /api/items creates a Work Item" "201" "${created%% *}"
  item_id="$(json_field id <<< "${created#* }")"

  if [[ "$mode" == bearer ]]; then
    job="$(bearer_header "${credential}" | http_status_body -K - -X POST "${APP_URL}/api/items/${item_id}/process")"
  else
    job="$(http_status_body -X POST -b "$credential" "${ui_headers[@]}" "${APP_URL}/api/items/${item_id}/process")"
  fi
  expect "$area" "POST /api/items/{id}/process accepts a job" "202" "${job%% *}"
  job_id="$(json_field id <<< "${job#* }")"

  local _
  state="accepted"
  for _ in $(seq 1 40); do
    if [[ "$mode" == bearer ]]; then
      status="$(bearer_header "${credential}" | http_status_body -K - "${APP_URL}/api/processing-jobs/${job_id}")"
    else
      status="$(http_status_body -b "$credential" "${APP_URL}/api/processing-jobs/${job_id}")"
    fi
    state="$(json_field state <<< "${status#* }")"
    [[ "$state" != accepted ]] && break
    sleep 0.5
  done
  expect "$area" "polled processing job reaches succeeded" "succeeded" "$state"

  if [[ "$mode" == bearer ]]; then
    status="$(bearer_header "${credential}" | http_status_body -K - -X POST "${APP_URL}/api/items/${item_id}/process")"
  else
    status="$(http_status_body -X POST -b "$credential" "${ui_headers[@]}" "${APP_URL}/api/items/${item_id}/process")"
  fi
  expect "$area" "processing a done Work Item again" "409 work_item_already_done" \
    "${status%% *} $(json_field error <<< "${status#* }")"
}

verify_authentication() {
  local evidence_file="" slow=true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --evidence) evidence_file="${2:?--evidence requires a file}"; shift 2 ;;
      --skip-slow) slow=false; shift ;;
      *) die "unknown option: $1" ;;
    esac
  done

  require_command curl
  require_command python3
  [[ -n "$(compose ps -q --status running oauth2-proxy 2>/dev/null)" ]] ||
    die "the lab is not running; run: $0 start"

  RESULTS=()
  FAILED=0
  # Cookie jars hold live sessions; remove them however the run ends.
  AUTH_WORK="$(mktemp -d)"
  trap 'rm -rf -- "$AUTH_WORK"' EXIT
  set_ui_headers
  local started
  started="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  wait_for_issuer || die "the issuer is not reachable: ${ISSUER}"

  local area status body token

  # --- Unauthenticated ------------------------------------------------------
  area="unauthenticated"
  expect "$area" "GET /api/items without credentials" "401" "$(http_status "${APP_URL}/api/items")"
  expect "$area" "static UI without a session" "200" "$(http_status "${APP_URL}/")"
  expect "$area" "Basic credentials are not accepted" "401" \
    "$(http_status -H 'Authorization: Basic bGFiLXVzZXI6eA==' "${APP_URL}/api/items")"

  # --- Machine client (bearer path) -----------------------------------------
  area="machine client"
  local machine_token
  machine_token="$(client_credentials access_token)"
  expect "$area" "client-credentials token issued" "yes" "$([[ -n "$machine_token" ]] && echo yes || echo no)"
  record "$area" "token summary" "observe" "$(token_claims alg,iss,aud,azp,typ,lifetime <<< "$machine_token")" info
  expect "$area" "GET /api/items with bearer token" "200" "$(bearer_status "$machine_token" "${APP_URL}/api/items")"
  # The automation client may read and process but not create (ADR 0005);
  # the editor creates its fixtures through a browser session.
  local editor_jar="${AUTH_WORK}/editor" fixture fixture_without_header
  browser_login "$editor_jar" lab-user >/dev/null
  fixture="$(editor_create "$editor_jar" "machine client fixture")"
  fixture_without_header="$(editor_create "$editor_jar" "machine client fixture, no CSRF header")"
  machine_work_items "$area" "$machine_token" "$fixture"
  expect "$area" "state change without CSRF header (no ambient credential)" "202" \
    "$(bearer_status "$machine_token" -X POST "${APP_URL}/api/items/${fixture_without_header}/process")"
  expect "$area" "create is not permitted (authorization, not CSRF)" "403 insufficient_permissions" \
    "$(call_summary bearer "$machine_token" POST /items '{"title":"machine create"}')"

  # --- Token validation through the ingress ---------------------------------
  area="token validation"
  local since
  since="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  status="$(bearer_header "$(token_variant tampered <<< "$machine_token")" | lab_curl -K - -o /dev/null -D - \
    "${APP_URL}/api/items" 2>/dev/null | tr -d '\r')"
  expect "$area" "payload changed under the original signature" "401" "$(awk 'NR==1{print $2}' <<< "$status")"
  expect "$area" "rejection challenge names invalid_token" "yes" \
    "$(grep -qi '^www-authenticate: Bearer realm="work-items", error="invalid_token"' <<< "$status" && echo yes || echo no)"
  expect "$area" "unsigned token (alg none)" "401" \
    "$(bearer_status "$(token_variant none <<< "$machine_token")" "${APP_URL}/api/items")"
  expect "$area" "malformed token" "401" "$(bearer_status "not-a-token" "${APP_URL}/api/items")"
  local id_token
  id_token="$(client_credentials id_token openid)"
  if [[ -n "$id_token" ]]; then
    record "$area" "ID token summary (issuer-signed, other audience)" "observe" \
      "$(token_claims alg,iss,aud,typ <<< "$id_token")" info
    expect "$area" "issuer-signed ID token (audience is the client)" "401" \
      "$(bearer_status "$id_token" "${APP_URL}/api/items")"
  else
    record "$area" "issuer-signed token for another audience" "run" "no ID token from client credentials" skip
  fi
  sleep 1
  record "$area" "API rejection categories logged" "observe" "$(api_categories_since "$since")" info

  # --- Browser session (session path) ---------------------------------------
  area="browser session"
  local jar="${AUTH_WORK}/browser"
  body="$(browser_login "$jar")"
  expect "$area" "sign-in through Keycloak's form returns to the UI" "yes" \
    "$([[ -n "$(session_cookie "$jar")" ]] && grep -q '<div id="root">' <<< "$body" && echo yes || echo no)"
  record "$area" "session cookie attributes" "observe" \
    "$(awk '$6 == "__Host-wi-session" {print "httponly=" ($1 ~ /^#HttpOnly_/ ? "yes" : "no") " path=" $3 " secure=" $4 " bytes=" length($7)}' "$jar" | tail -n 1)" info
  expect "$area" "GET /api/items with the session" "200" "$(session_status "$jar" "${APP_URL}/api/items")"
  auth_work_items "$area" session "$jar"
  token="$(session_access_token "$jar")"
  record "$area" "forwarded access token summary" "observe" "$(token_claims alg,iss,aud,azp,typ,lifetime <<< "$token")" info
  expect "$area" "session with a bearer token is ambiguous" "400" \
    "$(bearer_header "${machine_token}" | session_status "$jar" -K - "${APP_URL}/api/items")"
  expect "$area" "Keycloak session active (silent sign-in)" "silent-sign-in" "$(idp_session_state "$jar")"

  # --- CSRF ----------------------------------------------------------------
  area="csrf"
  local post=(-H "Content-Type: application/json" -d '{"title":"csrf probe"}' "${APP_URL}/api/items")
  expect "$area" "session POST without the UI header" "403" \
    "$(session_status "$jar" -H "Origin: ${APP_URL}" -H "Sec-Fetch-Site: same-origin" "${post[@]}")"
  expect "$area" "session POST from another origin" "403" \
    "$(session_status "$jar" -H "X-Requested-With: work-items-web" -H "Origin: https://attacker.example" -H "Sec-Fetch-Site: cross-site" "${post[@]}")"
  expect "$area" "session POST with Sec-Fetch-Site: cross-site" "403" \
    "$(session_status "$jar" -H "X-Requested-With: work-items-web" -H "Sec-Fetch-Site: cross-site" "${post[@]}")"
  expect "$area" "session POST with Sec-Fetch-Site: same-site" "403" \
    "$(session_status "$jar" -H "X-Requested-With: work-items-web" -H "Origin: ${APP_URL}" -H "Sec-Fetch-Site: same-site" "${post[@]}")"
  expect "$area" "session POST with header, Origin, and fetch metadata (control)" "201" \
    "$(session_status "$jar" "${ui_headers[@]}" "${post[@]}")"
  expect "$area" "session GET needs no header" "200" "$(session_status "$jar" "${APP_URL}/api/items")"
  expect "$area" "sign-out by GET" "405" "$(session_status "$jar" "${APP_URL}/oauth2/sign_out")"
  # The headers a browser sends for a same-origin form post from a page
  # served with Referrer-Policy: no-referrer, as observed in Brave and
  # Chromium: Origin is "null". It must stay refused.
  local form_post=(-X POST -H "Origin: null" -H "Sec-Fetch-Site: same-origin" -H "Sec-Fetch-Mode: navigate"
    -H "Sec-Fetch-Dest: document" -H "Content-Type: application/x-www-form-urlencoded" --data "")
  expect "$area" "sign-out as a no-referrer form post (Origin: null)" "403" \
    "$(session_status "$jar" "${form_post[@]}" "${APP_URL}/oauth2/sign_out")"
  expect "$area" "sign-out with Origin: null even with the UI header" "403" \
    "$(session_status "$jar" "${form_post[@]}" -H "X-Requested-With: work-items-web" "${APP_URL}/oauth2/sign_out")"
  # The UI's fetch headers, each with one condition broken.
  expect "$area" "sign-out without the UI header" "403" \
    "$(session_status "$jar" -X POST -H "Origin: ${APP_URL}" -H "Sec-Fetch-Site: same-origin" -H "Sec-Fetch-Mode: cors" "${APP_URL}/oauth2/sign_out")"
  expect "$area" "sign-out without Origin" "403" \
    "$(session_status "$jar" -X POST -H "X-Requested-With: work-items-web" -H "Sec-Fetch-Site: same-origin" "${APP_URL}/oauth2/sign_out")"
  expect "$area" "sign-out from another origin" "403" \
    "$(session_status "$jar" -X POST -H "X-Requested-With: work-items-web" -H "Origin: https://attacker.example" -H "Sec-Fetch-Site: cross-site" "${APP_URL}/oauth2/sign_out")"
  expect "$area" "sign-out with Sec-Fetch-Site: cross-site" "403" \
    "$(session_status "$jar" -X POST -H "X-Requested-With: work-items-web" -H "Origin: ${APP_URL}" -H "Sec-Fetch-Site: cross-site" "${APP_URL}/oauth2/sign_out")"
  expect "$area" "session still valid after refused sign-outs" "200" "$(session_status "$jar" "${APP_URL}/api/items")"

  # --- Logout, cookie replay, and captured-token replay ----------------------
  # Three distinct questions: does sign-out end the gateway session (and a
  # copied cookie), does it end the Keycloak session, and what happens to an
  # access token captured before it.
  area="logout"
  local captured captured_exp
  captured="$(session_access_token "$jar")"
  captured_exp="$(token_exp "$captured")"
  cp "$jar" "${jar}.copy"
  expect "$area" "captured session token at the API before sign-out" "200" \
    "$(bearer_status "$captured" "${APP_URL}/api/items")"
  # The headers the UI's sign-out fetch sends (observed in Chromium under
  # no-referrer: the real Origin, Sec-Fetch-Mode: cors).
  status="$(lab_curl -o /dev/null -D - -b "$jar" -c "$jar" -X POST -H "Origin: ${APP_URL}" \
    -H "Sec-Fetch-Site: same-origin" -H "Sec-Fetch-Mode: cors" -H "Sec-Fetch-Dest: empty" \
    -H "X-Requested-With: work-items-web" "${APP_URL}/oauth2/sign_out" 2>/dev/null | tr -d '\r')"
  expect "$area" "sign-out as the UI's fetch sends it" "302" "$(awk 'NR==1{print $2}' <<< "$status")"
  expect "$area" "sign-out response clears the session cookie" "yes" \
    "$(grep -iE '^set-cookie: __Host-wi-session=' <<< "$status" | grep -qiE 'max-age=(0|-1)|expires=thu, 01 jan 1970' && echo yes || echo no)"
  record "$area" "sign-out redirect target" "observe" "$(awk 'tolower($1)=="location:"{print $2}' <<< "$status")" info
  expect "$area" "same browser after sign-out" "401" "$(session_status "$jar" "${APP_URL}/api/items")"
  expect "$area" "replayed copy of the session cookie" "401" "$(session_status "${jar}.copy" "${APP_URL}/api/items")"
  expect "$area" "Keycloak session ended (login form on next sign-in)" "login-form" "$(idp_session_state "${jar}.copy")"
  status="$(bearer_header "${captured}" | http_status -K - "${ISSUER}/protocol/openid-connect/userinfo")"
  expect "$area" "captured token at Keycloak userinfo (session-bound)" "401" "$status"
  # Local validation does not consult Keycloak per request, so the expected
  # behavior is acceptance until expiry.
  expect "replay" "captured token at the API after sign-out, before expiry" "200" \
    "$(bearer_status "$captured" "${APP_URL}/api/items")"
  record "replay" "captured token remaining lifetime at sign-out" "observe" "$(token_claims expires_in <<< "$captured")" info

  # --- Session refresh through auth_request ---------------------------------
  # oauth2-proxy refreshes a session older than SESSION_REFRESH on its next
  # request and issues a new session cookie on its auth response. The check is
  # that a scripted client (curl with a cookie jar, standing in for a browser)
  # receives that cookie through the ingress, stores it, and
  # is then authenticated with it; not only that the gateway refreshed its
  # server-side state. Cookie values are compared by digest and never recorded.
  area="session refresh"
  local refresh_jar="${AUTH_WORK}/refresh" refresh_login login_digest login_issued headers set_cookie
  browser_login "$refresh_jar" >/dev/null
  refresh_login="$(date +%s)"
  login_digest="$(cookie_digest "$refresh_jar")"
  login_issued="$(cookie_issued_at "$refresh_jar")"
  headers="$(lab_curl -o /dev/null -D - -b "$refresh_jar" -c "$refresh_jar" "${APP_URL}/api/items" 2>/dev/null | tr -d '\r')"
  expect "$area" "request before a refresh is due" "200" "$(awk 'NR==1{print $2}' <<< "$headers")"
  expect "$area" "no session cookie issued before a refresh is due" "0" \
    "$(grep -ci '^set-cookie: __Host-wi-session=' <<< "$headers" || true)"

  sleep_until $(( refresh_login + 70 ))
  headers="$(lab_curl -o /dev/null -D - -b "$refresh_jar" -c "$refresh_jar" "${APP_URL}/api/items" 2>/dev/null | tr -d '\r')"
  set_cookie="$(grep -i '^set-cookie: __Host-wi-session=' <<< "$headers" || true)"
  expect "$area" "request after a refresh is due" "200" "$(awk 'NR==1{print $2}' <<< "$headers")"
  expect "$area" "refreshed session cookie reaches the client" "1" "$(grep -c . <<< "$set_cookie" || true)"
  expect "$area" "refreshed cookie attributes" "Path=/ HttpOnly Secure SameSite=Lax Max-Age=28800" \
    "$(set_cookie_attributes "$set_cookie")"
  expect "$area" "security headers on the refresh response" "4" \
    "$(grep -ciE '^(x-content-type-options: nosniff|x-frame-options: deny|referrer-policy: no-referrer|x-request-id: [0-9a-f]+)$' <<< "$headers" || true)"
  expect "$area" "client stored a new cookie value" "yes" \
    "$([[ -n "$login_digest" && "$(cookie_digest "$refresh_jar")" != "$login_digest" ]] && echo yes || echo no)"
  local refreshed_issued
  refreshed_issued="$(cookie_issued_at "$refresh_jar")"
  record "$area" "signed issue time advanced (s)" "observe" \
    "$([[ -n "$login_issued" && -n "$refreshed_issued" ]] && echo $(( refreshed_issued - login_issued )) || echo unknown)" info
  # The jar now holds only the refreshed value; the next request presents it.
  headers="$(lab_curl -o /dev/null -D - -b "$refresh_jar" -c "$refresh_jar" "${APP_URL}/api/items" 2>/dev/null | tr -d '\r')"
  expect "$area" "next request with the refreshed cookie" "200" "$(awk 'NR==1{print $2}' <<< "$headers")"
  expect "$area" "no further cookie right after the refresh" "0" \
    "$(grep -ci '^set-cookie: __Host-wi-session=' <<< "$headers" || true)"
  expect "$area" "refreshed cookie used for a state change" "201" \
    "$(session_status "$refresh_jar" "${ui_headers[@]}" -H 'Content-Type: application/json' -d '{"title":"after refresh"}' "${APP_URL}/api/items")"
  expect "$area" "machine client gets no session cookie" "0" \
    "$(bearer_header "${machine_token}" | lab_curl -K - -o /dev/null -D - "${APP_URL}/api/items" 2>/dev/null | grep -ci '^set-cookie:' || true)"

  # --- Outages -------------------------------------------------------------
  # Identity provider down.
  area="idp outage"
  local idp_jar="${AUTH_WORK}/idp" idp_login cold_token
  browser_login "$idp_jar" >/dev/null
  idp_login="$(date +%s)"
  local idp_token_exp
  idp_token_exp="$(token_exp "$(session_access_token "$idp_jar")")"
  cold_token="$(client_credentials access_token)"
  compose stop keycloak >/dev/null 2>&1
  expect "$area" "existing session, refresh not yet due" "200" "$(session_status "$idp_jar" "${APP_URL}/api/items")"
  expect "$area" "machine token with cached signing keys" "200" "$(bearer_status "$machine_token" "${APP_URL}/api/items")"
  expect "$area" "new sign-in reaches an explicit 503" "503" \
    "$(http_status -L -c "${AUTH_WORK}/new" -b "${AUTH_WORK}/new" "${APP_URL}/oauth2/start?rd=%2F")"
  expect "$area" "client-credentials token endpoint" "503" \
    "$(http_status -u x:y -d grant_type=client_credentials "${ISSUER}/protocol/openid-connect/token")"

  # API cold start without the identity provider: no cached keys, so a
  # well-formed token cannot be judged.
  compose restart api >/dev/null 2>&1
  compose up -d --wait api >/dev/null 2>&1
  expect "$area" "API cold start: unexpired token cannot be judged" "503 authentication_unavailable" \
    "$(body="$(bearer_header "${cold_token}" | http_status_body -K - "${APP_URL}/api/items")"; echo "${body%% *} $(json_field error <<< "${body#* }")")"
  expect "$area" "API cold start: no token is still 401" "401" "$(http_status "${APP_URL}/api/items")"

  sleep_until $(( idp_login + 75 ))
  record "$area" "existing session after a refresh is due (API keys not cached)" "observe" \
    "http=$(session_status "$idp_jar" "${APP_URL}/api/items")" info

  restore_service keycloak
  wait_for_issuer || die "Keycloak did not return"
  expect "$area" "API recovers signing keys after Keycloak returns" "200" \
    "$(bearer_status "$(client_credentials access_token)" "${APP_URL}/api/items")"

  if [[ "$slow" == true ]]; then
    # The restarted API now holds the keys. Stop Keycloak again, without
    # touching the session in between, so oauth2-proxy cannot refresh it:
    # the forwarded token is then bounded only by the API's exp check.
    compose stop keycloak >/dev/null 2>&1
    since="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

    sleep_until $(( captured_exp + 35 ))
    expect "replay" "captured token after expiry plus skew" "401" "$(bearer_status "$captured" "${APP_URL}/api/items")"

    sleep_until $(( idp_token_exp + 35 ))
    expect "$area" "IdP down: session whose token expired" "401" "$(session_status "$idp_jar" "${APP_URL}/api/items")"
    sleep 1
    record "$area" "API rejection categories logged during expiry checks" "observe" "$(api_categories_since "$since")" info

    restore_service keycloak
    wait_for_issuer || die "Keycloak did not return"
  else
    record "$area" "session whose token expired while the IdP is down" "run" "--skip-slow" skip
    record "replay" "captured token after expiry" "run" "--skip-slow" skip
  fi
  local new_jar="${AUTH_WORK}/after-idp"
  browser_login "$new_jar" >/dev/null
  expect "$area" "sign-in works after Keycloak returns" "200" "$(session_status "$new_jar" "${APP_URL}/api/items")"

  # Gateway down: session requests fail explicitly; machine clients do not
  # depend on the gateway.
  area="gateway outage"
  compose stop oauth2-proxy >/dev/null 2>&1
  expect "$area" "existing session" "503" "$(session_status "$new_jar" "${APP_URL}/api/items")"
  expect "$area" "machine client (bearer path)" "200" \
    "$(bearer_status "$(client_credentials access_token)" "${APP_URL}/api/items")"
  expect "$area" "no credentials" "503" "$(http_status "${APP_URL}/api/items")"
  restore_service oauth2-proxy
  expect "$area" "existing session after restore, without sign-in" "200" "$(session_status "$new_jar" "${APP_URL}/api/items")"

  # Session store down. The 401/503 split uses the readiness classification,
  # a separate observation with a race: /ready reports the store's state when
  # asked, not the cause of the original 401.
  area="store outage"
  local forged="${AUTH_WORK}/forged" empty="${AUTH_WORK}/empty"
  : > "$empty"
  printf '%s\tFALSE\t/\tTRUE\t0\t__Host-wi-session\t%s\n' "$LAB_HOSTNAME" \
    "__Host-wi-session-$(openssl rand -hex 16).$(openssl rand -hex 16)" > "$forged"
  expect "readiness classification" "store up: invalid session cookie" "401" "$(session_status "$forged" "${APP_URL}/api/items")"
  compose stop valkey >/dev/null 2>&1
  expect "readiness classification" "store down: existing session" "503" "$(session_status "$new_jar" "${APP_URL}/api/items")"
  expect "readiness classification" "store down: invalid session cookie (cannot be checked)" "503" \
    "$(session_status "$forged" "${APP_URL}/api/items")"
  expect "readiness classification" "store down: no session cookie" "401" "$(session_status "$empty" "${APP_URL}/api/items")"
  expect "$area" "machine client (bearer path)" "200" \
    "$(bearer_status "$(client_credentials access_token)" "${APP_URL}/api/items")"
  restore_service valkey
  sleep 3
  expect "$area" "existing session after restore (sessions not persisted)" "401" \
    "$(session_status "$new_jar" "${APP_URL}/api/items")"
  local final_jar="${AUTH_WORK}/final"
  browser_login "$final_jar" >/dev/null
  expect "$area" "sign-in works after the store returns" "200" "$(session_status "$final_jar" "${APP_URL}/api/items")"

  if [[ -n "$evidence_file" ]]; then
    {
      printf '{\n  "project": "%s",\n  "started_at": "%s",\n  "recorded_at": "%s",\n' \
        "$PROJECT" "$started" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
      printf '  "conditions": {"access_token_seconds": %s, "session_refresh": "%s", "api_clock_skew_seconds": 30, "slow_checks": %s},\n' \
        "$ACCESS_TOKEN_SECONDS" "$SESSION_REFRESH" "$slow"
      printf '  "results": [\n'
      local index
      for index in "${!RESULTS[@]}"; do
        printf '    %s' "${RESULTS[$index]}"
        [[ "$index" -lt $(( ${#RESULTS[@]} - 1 )) ]] && printf ','
        printf '\n'
      done
      printf '  ]\n}\n'
    } > "$evidence_file"
    echo "Evidence written: ${evidence_file}"
  fi

  echo
  if [[ "$FAILED" -ne 0 ]]; then
    echo "Authentication verification failed: ${FAILED} check(s)." >&2
    return 1
  fi
  echo "Authentication verification passed (${#RESULTS[@]} checks)."
}

# ---------------------------------------------------------------------------
# Log hygiene
# ---------------------------------------------------------------------------

# Sign in up to Keycloak's redirect back to the gateway, without following
# it. Prints the callback URL (which carries the authorization code).
authorize_until_callback() {
  local jar="$1" page action
  page="$(lab_curl -L -c "$jar" -b "$jar" "${APP_URL}/oauth2/start?rd=%2F" 2>/dev/null || true)"
  action="$(grep -o 'id="kc-form-login"[^>]*action="[^"]*"' <<< "$page" | sed 's/.*action="//; s/"$//; s/&amp;/\&/g' || true)"
  [[ -n "$action" ]] || { echo ""; return 0; }
  { curl_config url "$action"; curl_config data-urlencode "password=$(secret lab-user-password)"; } \
    | lab_curl -K - -o /dev/null -D - -c "$jar" -b "$jar" \
        --data-urlencode "username=lab-user" --data "credentialId=" 2>/dev/null \
    | tr -d '\r' | awk 'tolower($1) == "location:" {print $2}' || true
}

# The gateway's redirect to Keycloak's authorization endpoint (carries state).
authorization_request() {
  local jar="$1"
  lab_curl -o /dev/null -D - -c "$jar" -b "$jar" "${APP_URL}/oauth2/start?rd=%2F" 2>/dev/null \
    | tr -d '\r' | awk 'tolower($1) == "location:" {print $2}' || true
}

# The URL (which carries a code or state) is read from standard input.
query_param() {
  python3 -I -c '
import sys, urllib.parse
q = urllib.parse.parse_qs(urllib.parse.urlsplit(sys.stdin.read().strip()).query)
print(q.get(sys.argv[1], [""])[0])
' "$2" <<< "$1"
}

# "<status> <request id>" for a request, without following redirects.
status_and_request_id() {
  local headers
  headers="$(lab_curl -o /dev/null -D - "$@" 2>/dev/null | tr -d '\r' || true)"
  echo "$(awk 'NR==1{print $2}' <<< "$headers") $(awk 'tolower($1)=="x-request-id:"{print $2}' <<< "$headers")"
}

# Appends "<kind><TAB><value>" to the values file; an empty value is kept as
# a gap so the per-kind counts expose it. Logs record URLs percent-encoded,
# so each percent-encoded form that differs is added as "<kind>+encoded".
add_value() {
  local file="$1" kind="$2" value="$3" variant
  printf '%s\t%s\n' "$kind" "$value" >> "$file"
  [[ -n "$value" ]] || return 0
  while IFS= read -r variant; do
    printf '%s+encoded\t%s\n' "$kind" "$variant" >> "$file"
  done < <(python3 -I -c '
import sys, urllib.parse
v = sys.stdin.read().rstrip("\n")
for form in sorted({urllib.parse.quote(v, safe=""), urllib.parse.quote(v), urllib.parse.quote_plus(v)} - {v}):
    print(form)
' <<< "$value")
}

# Kinds of values found in a file with their occurrences ("code=2 state=1"),
# or "none". Never prints the values.
kinds_found() {
  local file="$1" values_file="$2" kind value n
  declare -A found=()
  while IFS=$'\t' read -r kind value; do
    [[ -n "$value" ]] || continue
    n="$(grep -cFf <(printf '%s\n' "$value") "$file" || true)"
    [[ "$n" -gt 0 ]] && found[$kind]=$(( ${found[$kind]:-0} + n ))
  done < "$values_file"
  if [[ ${#found[@]} -eq 0 ]]; then echo none; return 0; fi
  for kind in "${!found[@]}"; do echo "${kind}=${found[$kind]}"; done | sort | tr '\n' ' ' | sed 's/ $//'
}

# Occurrences of each listed value in a file; prints "<total> <values found>".
count_values() {
  local file="$1" values_file="$2" total=0 found=0 value n
  while IFS=$'\t' read -r _ value; do
    [[ -n "$value" ]] || continue
    n="$(grep -cFf <(printf '%s\n' "$value") "$file" || true)"
    total=$(( total + n ))
    [[ "$n" -gt 0 ]] && found=$(( found + 1 ))
  done < "$values_file"
  echo "$total $found"
}

# Checks that, for the flows it drives (a sign-in and failed callbacks),
# authentication material does not reach the gateway's or the ingress's logs.
# It says nothing about flows it does not drive. It uses real values: it records the
# authorization codes, state values, session cookie, and access tokens of the
# flows it drives, plus the long-lived secrets, and searches the logs written
# during the run for each of them. Values are never printed or recorded.
verify_log_hygiene() {
  local evidence_file=""
  if [[ "${1:-}" == "--evidence" ]]; then
    evidence_file="${2:?--evidence requires a file}"
  fi

  require_command curl
  require_command python3
  [[ -n "$(compose ps -q --status running oauth2-proxy 2>/dev/null)" ]] ||
    die "the lab is not running; run: $0 start"

  RESULTS=()
  FAILED=0
  AUTH_WORK="$(mktemp -d)"
  trap 'rm -rf -- "$AUTH_WORK"' EXIT
  wait_for_issuer || die "the issuer is not reachable: ${ISSUER}"

  local values="${AUTH_WORK}/values" since started area="log hygiene"
  : > "$values"
  started="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  since="$(date -u -d '-2 seconds' +%Y-%m-%dT%H:%M:%SZ)"

  # Capture control for the ingress: a unique, non-secret path segment.
  local marker
  marker="log-hygiene-$(openssl rand -hex 12)"
  expect "$area" "ingress: control request with a unique path" "404" "$(http_status "${APP_URL}/api/${marker}")"

  # Successful sign-in. The callback is requested separately so its request
  # ID can be matched in both logs.
  local jar="${AUTH_WORK}/ok" callback code state result callback_rid
  callback="$(authorize_until_callback "$jar")"
  code="$(query_param "$callback" code)"
  state="$(query_param "$callback" state)"
  expect "$area" "successful flow: authorization code obtained" "yes" "$([[ -n "$code" ]] && echo yes || echo no)"
  add_value "$values" code "$code"
  add_value "$values" state "$state"
  result="$(curl_config url "$callback" | status_and_request_id -K - -c "$jar" -b "$jar")"
  callback_rid="${result#* }"
  expect "$area" "successful flow: callback redirects to the UI" "302" "${result%% *}"
  expect "$area" "successful flow: session works" "200" "$(session_status "$jar" "${APP_URL}/api/items")"
  local signed_in
  signed_in="$(date +%s)"
  add_value "$values" session-cookie "$(session_cookie "$jar")"
  add_value "$values" session-access-token "$(session_access_token "$jar")"
  local machine_token
  machine_token="$(client_credentials access_token)"
  add_value "$values" machine-access-token "$machine_token"
  expect "$area" "successful flow: machine token at the API" "200" "$(bearer_status "$machine_token" "${APP_URL}/api/items")"

  # Failed callback 1: the same code again (already redeemed).
  result="$(curl_config url "$callback" | status_and_request_id -K - -c "$jar" -b "$jar")"
  record "$area" "failed callback: reused authorization code" "observe" "http=${result%% *}" info

  # Failed callback 2: Keycloak down while the gateway redeems a fresh code;
  # and an authorization request reaching the stopped identity provider.
  local jar2="${AUTH_WORK}/idp-down" callback2 code2 jar3="${AUTH_WORK}/authorize" authorize state3
  callback2="$(authorize_until_callback "$jar2")"
  code2="$(query_param "$callback2" code)"
  add_value "$values" code "$code2"
  add_value "$values" state "$(query_param "$callback2" state)"
  authorize="$(authorization_request "$jar3")"
  state3="$(query_param "$authorize" state)"
  add_value "$values" state "$state3"
  compose stop keycloak >/dev/null 2>&1
  result="$(curl_config url "$callback2" | status_and_request_id -K - -c "$jar2" -b "$jar2")"
  record "$area" "failed callback: Keycloak down during code redemption" "observe" "http=${result%% *}" info
  expect "$area" "authorization request to the stopped identity provider" "503" "$(curl_config url "$authorize" | http_status -K -)"
  restore_service keycloak
  wait_for_issuer || die "Keycloak did not return"

  # Failed callback 3: the gateway is down when the browser returns.
  local jar4="${AUTH_WORK}/gateway-down" callback4
  callback4="$(authorize_until_callback "$jar4")"
  add_value "$values" code "$(query_param "$callback4" code)"
  add_value "$values" state "$(query_param "$callback4" state)"
  compose stop oauth2-proxy >/dev/null 2>&1
  expect "$area" "failed callback: gateway down" "503" "$(curl_config url "$callback4" | http_status -K - -c "$jar4" -b "$jar4")"
  restore_service oauth2-proxy

  # Session refresh: the refreshed cookie passes through the ingress in a
  # response header and must not be logged either.
  sleep_until $(( signed_in + 70 ))
  local before_refresh
  before_refresh="$(session_cookie "$jar")"
  expect "$area" "session refresh: request after a refresh is due" "200" \
    "$(http_status -b "$jar" -c "$jar" "${APP_URL}/api/items")"
  expect "$area" "session refresh: client received a new cookie" "yes" \
    "$([[ -n "$(session_cookie "$jar")" && "$(session_cookie "$jar")" != "$before_refresh" ]] && echo yes || echo no)"
  add_value "$values" session-cookie "$(session_cookie "$jar")"

  # Long-lived secrets the gateway and identity provider hold.
  local name
  for name in gateway-client-secret automation-client-secret oauth2-proxy-cookie-secret valkey-password \
              lab-user-password lab-viewer-password lab-outsider-password lab-admin-client-secret; do
    add_value "$values" secret "$(secret "$name")"
  done

  # Every value must be present and distinct, or the search proves nothing.
  local kinds value_count
  kinds="$(awk -F'\t' '$2 != "" && $1 !~ /\+encoded$/ {n[$1]++} END {for (k in n) printf "%s=%d ", k, n[k]}' "$values" | tr ' ' '\n' | sort | tr '\n' ' ' | sed 's/ $//')"
  expect "$area" "values collected per kind" \
    "code=3 machine-access-token=1 secret=8 session-access-token=1 session-cookie=2 state=4" "$kinds"
  record "$area" "percent-encoded forms also searched" "observe" \
    "$(awk -F'\t' '$1 ~ /\+encoded$/' "$values" | wc -l)" info
  value_count="$(awk -F'\t' '$2 != ""' "$values" | wc -l)"
  expect "$area" "searched strings are distinct" "${value_count}" "$(awk -F'\t' '$2 != "" {print $2}' "$values" | sort -u | wc -l)"

  sleep 1
  local service log counts
  for service in ingress oauth2-proxy keycloak api valkey worker; do
    log="${AUTH_WORK}/${service}.log"
    compose logs --no-color --since "$since" "$service" > "$log" 2>&1 || true
    counts="$(count_values "$log" "$values")"
    case "$service" in
      ingress | oauth2-proxy)
        expect "$area" "${service}: occurrences of the ${value_count} searched strings" "0" "${counts%% *}" ;;
      *)
        record "$area" "${service}: occurrences of the ${value_count} searched strings" "observe" "${counts%% *}" info ;;
    esac
    record "$area" "${service}: kinds found" "observe" "$(kinds_found "$log" "$values")" info
    record "$area" "${service}: log lines in the window" "observe" "$(wc -l < "$log")" info
  done

  # Positive controls. The scanner finds every value when it is present, and
  # each asserted log was captured for this window.
  local synthetic="${AUTH_WORK}/synthetic.log"
  awk -F'\t' '$2 != "" {print "request: \"GET /oauth2/callback?code=" $2 " HTTP/1.1\""}' "$values" > "$synthetic"
  counts="$(count_values "$synthetic" "$values")"
  expect "positive control" "scanner finds each searched string in a synthetic log" "${value_count}" "${counts#* }"
  expect "positive control" "ingress log captured (unique control path)" "yes" \
    "$(grep -qF -- "$marker" "${AUTH_WORK}/ingress.log" && echo yes || echo no)"
  expect "positive control" "callback request ID in the ingress log" "yes" \
    "$([[ -n "$callback_rid" ]] && grep -qF -- "rid=${callback_rid}" "${AUTH_WORK}/ingress.log" && echo yes || echo no)"
  expect "positive control" "callback request ID in the oauth2-proxy log" "yes" \
    "$([[ -n "$callback_rid" ]] && grep -qF -- "$callback_rid" "${AUTH_WORK}/oauth2-proxy.log" && echo yes || echo no)"
  record "positive control" "oauth2-proxy error lines in the window (diagnostics kept)" "observe" \
    "$(grep -ciE 'error' "${AUTH_WORK}/oauth2-proxy.log" || true)" info
  record "positive control" "ingress 503 lines with upstream status in the window" "observe" \
    "$(grep -c '" 503 .*upstream=50[24]' "${AUTH_WORK}/ingress.log" || true)" info

  if [[ -n "$evidence_file" ]]; then
    {
      printf '{\n  "project": "%s",\n  "started_at": "%s",\n  "recorded_at": "%s",\n' \
        "$PROJECT" "$started" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
      printf '  "values": "authorization codes from three flows and state values from four, the session cookie before and after a refresh, one session access token, one machine access token, and five long-lived secrets; searched as fixed strings, never recorded",\n'
      printf '  "results": [\n'
      local index
      for index in "${!RESULTS[@]}"; do
        printf '    %s' "${RESULTS[$index]}"
        [[ "$index" -lt $(( ${#RESULTS[@]} - 1 )) ]] && printf ','
        printf '\n'
      done
      printf '  ]\n}\n'
    } > "$evidence_file"
    echo "Evidence written: ${evidence_file}"
  fi

  echo
  if [[ "$FAILED" -ne 0 ]]; then
    echo "Log hygiene verification failed: ${FAILED} check(s)." >&2
    return 1
  fi
  echo "Log hygiene verification passed (${#RESULTS[@]} checks)."
}

