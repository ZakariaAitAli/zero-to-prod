LAB_ADMIN_ROLES=(view-clients manage-users)
# Candidate set verify-admin-permissions reduces from.
LAB_ADMIN_CANDIDATE_ROLES=(view-clients query-clients view-users query-users manage-users)

# Pre-authorization commit (main after #134), used as the old-baseline API in
