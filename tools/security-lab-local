#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(
  cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
  pwd
)"

ROOT_DIR="$(
  cd -- "${SCRIPT_DIR}/.."
  pwd
)"

COMPOSE_FILE="${ROOT_DIR}/infra/security-lab/compose.yaml"
PROJECT="${ZTP_SECURITY_LAB_PROJECT:-zero-to-prod-security-lab}"
STATE_DIR="${ZTP_SECURITY_LAB_STATE_DIR:-${XDG_STATE_HOME:-${HOME}/.local/state}/zero-to-prod/${PROJECT}}"
SECRETS_DIR="${STATE_DIR}/secrets"
PKI_DIR="${STATE_DIR}/pki"
# Mounted as a directory, not as single files: a file bind mount keeps the
# replaced inode, so a renewed certificate would never reach the container.
INGRESS_TLS_DIR="${STATE_DIR}/ingress-tls"
INGRESS_TLS_FILE="${INGRESS_TLS_DIR}/tls.pem"
# Server key and certificate of each internal TLS service, one directory per
# service, mounted like the ingress's (ADR 0006).
INTERNAL_TLS_DIR="${STATE_DIR}/internal-tls"
# Services on the data network that accept only TLS. Their Docker service
# names are the certificate names and the internal CA's permitted names.
INTERNAL_TLS_SERVICES=(postgres rabbitmq)
# Keycloak's key and certificate (ADR 0007), signed by the identity-provider
# CA, which may issue only for IDP_TLS_NAME and is trusted only by the ingress.
IDP_TLS_DIR="${STATE_DIR}/idp-tls"
IDP_TLS_FILE="${IDP_TLS_DIR}/tls.pem"
# The name the ingress dials and verifies (its Docker service name).
IDP_TLS_NAME=keycloak
IDP_TLS_PORT=8443
# Keycloak rereads its certificate files on this period (more than 30 s).
KEYCLOAK_TLS_RELOAD_SECONDS=35
# Fixed: the issuer URL, client registrations, and the ingress's internal
# listener all carry it.
HTTPS_PORT=9443
LAB_HOSTNAME="work-items.localhost"
AUTH_HOSTNAME="auth.work-items.localhost"
APP_URL="https://${LAB_HOSTNAME}:${HTTPS_PORT}"
ISSUER="https://${AUTH_HOSTNAME}:${HTTPS_PORT}/realms/work-items"
API_AUDIENCE="work-items-api"
ACCESS_TOKEN_SECONDS=300
SESSION_REFRESH="1m"
CA_DAYS="${ZTP_SECURITY_LAB_CA_DAYS:-90}"
CERT_DAYS="${ZTP_SECURITY_LAB_CERT_DAYS:-14}"
PROBE_IMAGE="curlimages/curl:8.22.0@sha256:58adaa4e8dca9c988bae2aba4ab3434a0bb2da16bbe3f92dec39ec7785166777"
PROBE_NETWORK="${PROJECT}-unrelated-probe"
# Same digests as compose.yaml. The RabbitMQ image ships an openssl binary
# (s_client, including -starttls postgres); the PostgreSQL image ships psql
# (libpq). Both serve as TLS probe clients on the data network.
POSTGRES_IMAGE="postgres:18.6-alpine3.24@sha256:77f585114c32fbca283dc835b0596f4e52b51b4c6662d7810b2f4084f60a1873"
RABBITMQ_IMAGE="rabbitmq:4.3.6-management@sha256:cdf40d8cb363d145e377ed88d59696a42386ffe54b30125f10eb128b862eea95"

LAB_SERVICES=(postgres rabbitmq api worker ingress keycloak-postgres keycloak valkey oauth2-proxy)

POSTGRES_DB="zero_to_prod"
# Where the API, worker, and migrator see the internal CA certificate.
INTERNAL_CA_MOUNT=/internal-ca/ca.crt
RABBITMQ_VHOST="zero_to_prod"
RABBITMQ_QUEUE="work_item_processing"

