#!/usr/bin/env python3
"""Summarize recorded issue-123 stages; no Docker mutation or price lookup.
Usage: python3 tools/capacity-lab-report RUN_DIRECTORY
"""
import json
import argparse
import math
from pathlib import Path
import re
import statistics

parser=argparse.ArgumentParser(description=__doc__)
parser.add_argument('run_directory',type=Path)
parser.add_argument('--cpu-hour-price',type=float)
parser.add_argument('--gib-hour-price',type=float)
parser.add_argument('--currency',default='currency units')
args=parser.parse_args()
prices=(args.cpu_hour_price,args.gib_hour_price)
if any(v is not None for v in prices) and not all(v is not None and math.isfinite(v) and v>=0 for v in prices):
 parser.error('supply both finite, nonnegative hourly prices, or neither')

def gib(value):
 match=re.fullmatch(r'([\d.]+)(B|kB|MB|GB|KiB|MiB|GiB)',value.strip())
 if not match:raise ValueError(value)
 return float(match[1])*{'B':1,'kB':1e3,'MB':1e6,'GB':1e9,'KiB':1024,'MiB':1024**2,'GiB':1024**3}[match[2]]/1024**3

stages=[]
for path in sorted(args.run_directory.glob('*.json')):
 # Allow redirecting output to RUN_DIRECTORY/analysis.json: the shell opens
 # that file before this process scans its inputs. It is never a raw stage.
 if path.name=='analysis.json':continue
 result=json.loads(path.read_text())
 if not isinstance(result,dict):continue
 if result.get('workload_kind')=='workflow':
  for stage in result['stages']:
   jobs=dict(stage['jobs'],latency_p99=stage['jobs']['latency_p99_s'])
   stages.append(dict(stage,profile='security-lab',workload=result['workload'],verification_passed=result['passed'],jobs=jobs,
    requests=stage['attempted_requests'],requests_per_second_including_tail=stage['attempted_requests']/stage['including_tail_s'],
    availability_fraction=stage['server_error_availability'],within_250ms_fraction=stage['successful_within_250ms_fraction'],
    drain_seconds=stage['drain_s'],invariants={key:jobs[key] for key in ('pending','failed','missing_outbox','succeeded_without_result','result_without_success')}))
 elif 'stage' in result:stages.append(result)

rows=[]
for result in stages:
 samples=result['resources'];successes=result['jobs']['succeeded']
 def avg_cpu(filter_name):
  values=[sum(float(c['CPUPerc'].rstrip('%'))/100 for c in sample['containers'] if filter_name(c['Name'])) for sample in samples]
  return statistics.mean(values) if values else None
 cpu=avg_cpu(lambda _:True)
 mem=statistics.mean([sum(gib(c['MemUsage'].split(' / ')[0]) for c in sample['containers']) for sample in samples]) if samples else None
 sec=result['including_tail_s']+result['drain_seconds']
 row={'stage':result['stage'],'profile':result.get('profile','capacity-lab'),
 'workload':result.get('workload','unauthenticated create/process/read'),
 'verification_passed':result.get('verification_passed'),
 'requests_s':result['requests_per_second_including_tail'],
 'p99_ms':result['request_p99_s']*1000 if result['request_p99_s'] is not None else None,'availability':result['availability_fraction'],
 'within_250ms':result['within_250ms_fraction'],'client_drops':result['client_dropped_iterations'],
 'successful_request_fraction':sum(n for code,n in result['status_counts'].items() if 200<=int(code)<300)/result['requests'] if result['requests'] else None,
 'accepted_iteration_fraction':result['jobs']['accepted']/result['scheduled_iterations'] if result['scheduled_iterations'] else None,
 'status_counts':result['status_counts'],'accepted':result['jobs']['accepted'],'succeeded':successes,
 'completion_fraction':successes/result['jobs']['accepted'] if result['jobs']['accepted'] else None,
 'freshness_of_accepted_fraction':result['jobs']['within_30_seconds']/result['jobs']['accepted'] if result['jobs']['accepted'] else None,
 'within_30s':result['jobs']['within_30_seconds']/successes if successes else None,
 'job_p99_s':result['jobs']['latency_p99'],'drain_s':result['drain_seconds'],
 'sampled_stack_cpu_cores_mean':cpu,'sampled_stack_memory_gib_mean':mem,
 'approx_stack_cpu_seconds_per_1000_successes':cpu*sec/successes*1000 if successes and cpu is not None else None,
 'approx_stack_gib_hours_per_1000_successes':mem*sec/3600/successes*1000 if successes and mem is not None else None,
 'sampled_api_cpu_cores_mean':avg_cpu(lambda n:'-api-' in n),
 'sampled_worker_cpu_cores_mean':avg_cpu(lambda n:'-worker-' in n),
 'sampled_postgres_cpu_cores_mean':avg_cpu(lambda n:'-postgres-' in n and '-exporter-' not in n),
 'resource_samples':len(samples),'invariants':result['invariants'],'duplicate_probe':result.get('duplicate_probe')}
 if args.cpu_hour_price is not None:
  cost=(cpu*sec/3600*args.cpu_hour_price+mem*sec/3600*args.gib_hour_price) if cpu is not None and mem is not None else None
  row['cost_model']={'currency':args.currency,'cpu_hour_price':args.cpu_hour_price,'gib_hour_price':args.gib_hour_price,
   'sampled_resource_cost_for_stage':cost,'sampled_resource_cost_per_1000_successes':cost/successes*1000 if cost is not None and successes else None,
   'scope':'illustrative usage-based CPU and resident memory only; excludes reserved capacity, storage, I/O, egress, redundancy and operations'}
 rows.append(row)
print(json.dumps(rows,indent=2))
