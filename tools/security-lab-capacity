#!/usr/bin/env python3
"""Bounded authenticated reads through the real security ingress; never changes lab state."""
import argparse
import base64
import concurrent.futures
import hashlib
import datetime
import os
import http.client
import json
import math
from pathlib import Path
import socket
import ssl
import subprocess
import threading
import time
import urllib.parse
from collections import Counter

ROOT = Path(__file__).resolve().parent.parent


class LoopbackHTTPS(http.client.HTTPSConnection):
    """Connect only to loopback while verifying the intended TLS name and sending SNI."""
    def connect(self):
        raw = socket.create_connection(('127.0.0.1', self.port), self.timeout)
        try:
            self.sock = self._context.wrap_socket(raw, server_hostname=self.host)
        except Exception:
            raw.close()
            raise


def request(context, host, path, headers=None, body=None):
    connection = LoopbackHTTPS(host, 9443, context=context, timeout=10)
    started = time.monotonic()
    try:
        connection.request('POST' if body is not None else 'GET', path, body, headers or {})
        response = connection.getresponse()
        data = response.read()
        return response.status, time.monotonic() - started, response.getheader('Retry-After'), data
    finally:
        connection.close()


def summarize(records, scheduled, dropped):
    counts = Counter(str(r[0]) for r in records)
    total = len(records)
    good = sum(200 <= r[0] < 300 for r in records)
    errors = sum(r[0] == 0 or r[0] >= 500 for r in records)
    ordered = sorted(r[1] for r in records)
    return {
        'scheduled_requests': scheduled, 'attempted_requests': total,
        'client_dropped_requests': dropped, 'status_counts': dict(counts),
        # Keep the server-error SLI separate from rejected valid work.
        'server_error_availability': (total - errors) / total if total else None,
        'successful_valid_work_fraction': good / scheduled if scheduled else None,
        'successful_within_250ms_fraction': sum(200 <= r[0] < 300 and r[1] <= .25 for r in records) / scheduled if scheduled else None,
        'rejected_requests': counts['429'],
        'rejections_with_retry_after': sum(r[0] == 429 and r[2] == '1' for r in records),
        'request_p99_s': ordered[math.ceil(.99 * total) - 1] if total else None,
    }


def run_stage(context, token, rate, duration, workers=64):
    records = []
    slots = threading.BoundedSemaphore(workers)
    lock = threading.Lock()
    started = time.monotonic()
    scheduled = dropped = 0

    def attempt():
        try:
            before = time.monotonic()
            try:
                code, latency, retry, _ = request(context, 'work-items.localhost', '/api/items', {'Authorization': 'Bearer ' + token})
            except (OSError, http.client.HTTPException):
                code, latency, retry = 0, time.monotonic() - before, None
            with lock:
                records.append((code, latency, retry))
        finally:
            slots.release()

    with concurrent.futures.ThreadPoolExecutor(max_workers=workers) as executor:
        while scheduled < rate * duration:
            delay = started + scheduled / rate - time.monotonic()
            if delay > 0:
                time.sleep(delay)
            if time.monotonic() - started >= duration:
                break
            scheduled += 1
            if slots.acquire(blocking=False):
                executor.submit(attempt)
            else:
                dropped += 1
    missed = rate * duration - scheduled
    result = summarize(records, rate * duration, dropped + missed)
    result['scheduler_missed_requests'] = missed
    result.update(rate_requests_s=rate, duration_s=duration, including_tail_s=time.monotonic() - started)
    return result


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('output', type=Path, help='new private report directory')
    parser.add_argument('--duration', type=int, default=30, choices=range(5, 61), metavar='5..60')
    args = parser.parse_args()
    driver = ROOT / 'tools/security-lab-local'
    state = Path(subprocess.check_output(['bash', str(driver), 'state-dir'], text=True).strip())
    context = ssl.create_default_context(cafile=str(state / 'pki/ca.crt'))
    # Read credentials only from validated private state; never log request bodies/headers.
    secret = (state / 'secrets/automation-client-secret').read_text().strip()
    auth = base64.b64encode(('work-items-automation:' + secret).encode()).decode()
    args.output.mkdir(parents=True, exist_ok=False, mode=0o700)
    report = {
        'commit': subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=ROOT, text=True).strip(),
        'harness_sha256': hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
        'configuration_sha256': {name: hashlib.sha256((ROOT / name).read_bytes()).hexdigest() for name in (
            'infra/security-lab/compose.yaml', 'infra/security-lab/ingress/nginx.conf')},
        'started_utc': datetime.datetime.now(datetime.timezone.utc).isoformat(),
        'host_cpus': os.cpu_count(),
        'max_client_workers': 64,
        'workload': 'authenticated GET /api/items, one peer, fresh verified TLS connection per request',
        'passed': False,
        'stages': [],
    }
    try:
        for name, rate in [('baseline', 5), ('overload', 100), ('recovery', 5)]:
            # Let API/auth budgets recover and get a fresh token outside the timed stage.
            time.sleep(3)
            code, _, _, body = request(context, 'auth.work-items.localhost', '/realms/work-items/protocol/openid-connect/token',
                {'Authorization': 'Basic ' + auth, 'Content-Type': 'application/x-www-form-urlencoded'},
                urllib.parse.urlencode({'grant_type': 'client_credentials'}))
            if code != 200:
                raise RuntimeError('Token endpoint refused authentication (status %s)' % code)
            grant = json.loads(body)
            if grant.get('expires_in', 0) < args.duration + 15:
                raise RuntimeError('Token lifetime is too short for a complete stage')
            result = run_stage(context, grant['access_token'], rate, args.duration)
            result['stage'] = name
            report['stages'].append(result)
            print(json.dumps(result), flush=True)
        baseline, overload, recovery = report['stages']
        report['checks'] = {
            'baseline_all_successful': baseline['successful_valid_work_fraction'] == 1,
            'overload_rejected': overload['rejected_requests'] > 0,
            'retry_after_present': overload['rejected_requests'] == overload['rejections_with_retry_after'],
            'recovery_all_successful': recovery['successful_valid_work_fraction'] == 1,
            'no_auth_or_transport_or_server_errors': all(not any(int(k) == 0 or int(k) >= 500 or int(k) in (401, 403) for k in s['status_counts']) for s in report['stages']),
            'only_expected_statuses': all(set(s['status_counts']) <= {'200', '429'} for s in report['stages']),
            'no_client_drops': all(s['client_dropped_requests'] == 0 for s in report['stages']),
            'all_arrivals_accounted': all(s['scheduled_requests'] == s['attempted_requests'] + s['client_dropped_requests'] for s in report['stages']),
        }
        report['passed'] = all(report['checks'].values())
        if not report['passed']:
            raise RuntimeError('Capacity verification failed; inspect report checks')
    finally:
        (args.output / 'summary.json').write_text(json.dumps(report, indent=2) + '\n')


if __name__ == '__main__':
    main()
